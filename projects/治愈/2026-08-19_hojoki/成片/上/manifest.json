{
 "part": "上",
 "epTitle": "三米见方",
 "acts": [
  "幕一-三米见方",
  "幕二-他从哪儿来"
 ],
 "duration": 1135.160833,
 "chars": 4306,
 "beats": {
  "常规": 1.25,
  "停顿点": 1.6,
  "幕末": 2.2
 },
 "loudness": {
  "i": -21,
  "tp": -7.1,
  "voiceOnly": -21
 },
 "cues": [
  {
   "no": 1,
   "act": "幕一-三米见方",
   "text": "河水一直在流。",
   "start": 0.5,
   "end": 1.9396041666666666
  },
  {
   "no": 2,
   "act": "幕一-三米见方",
   "text": "但你看到的那捧水，从来不是刚才那一捧。",
   "start": 3.189604166666667,
   "end": 6.44175
  },
  {
   "no": 3,
   "act": "幕一-三米见方",
   "text": "水面上会浮起一些泡沫。有的散开，有的又聚起来。没有一个能停得久。",
   "start": 7.69175,
   "end": 14.413541666666667
  },
  {
   "no": 4,
   "act": "幕一-三米见方",
   "text": "人，和人住的房子，也是这样。",
   "start": 15.663541666666667,
   "end": 18.3935
  },
  {
   "no": 5,
   "act": "幕一-三米见方",
   "text": "这是八百年前一个日本人写下的开头。他姓鸭，名叫长明。",
   "start": 19.6435,
   "end": 25.199645833333335
  },
  {
   "no": 6,
   "act": "幕一-三米见方",
   "text": "写这段话的时候，他住在京都往南的一座山里。",
   "start": 26.449645833333335,
   "end": 30.237791666666666
  },
  {
   "no": 7,
   "act": "幕一-三米见方",
   "text": "房子只有一丈见方。一丈是三米出头。",
   "start": 31.837791666666668,
   "end": 35.369395833333336
  },
  {
   "no": 8,
   "act": "幕一-三米见方",
   "text": "高不到七尺。",
   "start": 36.619395833333336,
   "end": 37.7300625
  },
  {
   "no": 9,
   "act": "幕一-三米见方",
   "text": "屋子是拆得开的。他说，要是住得不称心，随时能拆下来装上车。两辆车就够。",
   "start": 38.9800625,
   "end": 46.60820833333333
  },
  {
   "no": 10,
   "act": "幕一-三米见方",
   "text": "搬一次家的力气，也就够雇两个人。",
   "start": 47.85820833333333,
   "end": 50.65272916666667
  },
  {
   "no": 11,
   "act": "幕一-三米见方",
   "text": "他没有买地。地是别人的，他借来搭的。",
   "start": 51.90272916666667,
   "end": 55.710875
  },
  {
   "no": 12,
   "act": "幕一-三米见方",
   "text": "所以每一处接缝都上了挂钩。要走的时候把钩子解开，木头就散成一堆材料。",
   "start": 56.960875,
   "end": 64.4015625
  },
  {
   "no": 13,
   "act": "幕一-三米见方",
   "text": "他说，这样反倒踏实。房子不是钉在地上的东西，是能带着走的东西。",
   "start": 65.6515625,
   "end": 71.85735416666667
  },
  {
   "no": 14,
   "act": "幕一-三米见方",
   "text": "屋子朝南。地上铺竹子，当作檐廊。",
   "start": 73.45735416666666,
   "end": 77.211875
  },
  {
   "no": 15,
   "act": "幕一-三米见方",
   "text": "西边挂了一幅画像，前面摆着经书。",
   "start": 78.461875,
   "end": 81.69402083333334
  },
  {
   "no": 16,
   "act": "幕一-三米见方",
   "text": "东边铺开蕨草。那是他的床。",
   "start": 82.94402083333334,
   "end": 85.88579166666666
  },
  {
   "no": 17,
   "act": "幕一-三米见方",
   "text": "南边支一张竹架子。上面放着一张琴，一把琵琶。",
   "start": 87.13579166666666,
   "end": 91.76104166666667
  },
  {
   "no": 18,
   "act": "幕一-三米见方",
   "text": "就这些。",
   "start": 93.01104166666667,
   "end": 93.80170833333334
  },
  {
   "no": 19,
   "act": "幕一-三米见方",
   "text": "琴是能折的，琵琶是能拆的。两样都收得进箱子。",
   "start": 95.05170833333334,
   "end": 99.79077083333334
  },
  {
   "no": 20,
   "act": "幕一-三米见方",
   "text": "箱子有三只，黑皮的，摞在架子底下。里面是他自己抄下来的一些东西。几首诗，几段曲谱，几页经。",
   "start": 101.04077083333334,
   "end": 110.78091666666667
  },
  {
   "no": 21,
   "act": "幕一-三米见方",
   "text": "他说，这些也算不上家当。真要走，一只手能拎两只。",
   "start": 112.03091666666667,
   "end": 117.1830625
  },
  {
   "no": 22,
   "act": "幕一-三米见方",
   "text": "屋子东边接出一小片檐。檐下堆着柴。",
   "start": 118.7830625,
   "end": 122.73866666666666
  },
  {
   "no": 23,
   "act": "幕一-三米见方",
   "text": "林子就在旁边。柴不用愁，走两步捡一抱回来。",
   "start": 123.98866666666666,
   "end": 128.34370833333332
  },
  {
   "no": 24,
   "act": "幕一-三米见方",
   "text": "谷里的草木很密，往西却是空的。傍晚太阳落下去，那一片是亮的。",
   "start": 129.59370833333332,
   "end": 135.65220833333333
  },
  {
   "no": 25,
   "act": "幕一-三米见方",
   "text": "他把屋子朝南开门，是为了白天有光。留着西边不挡，是为了傍晚有光。",
   "start": 136.90220833333333,
   "end": 143.29997916666667
  },
  {
   "no": 26,
   "act": "幕一-三米见方",
   "text": "一间三米见方的屋子，能安排的也就这些。",
   "start": 144.54997916666667,
   "end": 147.99866666666668
  },
  {
   "no": 27,
   "act": "幕一-三米见方",
   "text": "他每天起得很早。",
   "start": 149.59866666666667,
   "end": 151.00916666666666
  },
  {
   "no": 28,
   "act": "幕一-三米见方",
   "text": "山里的早晨来得慢。天先在树梢那儿白一层，过很久，光才落到地上。",
   "start": 152.25916666666666,
   "end": 158.59239583333334
  },
  {
   "no": 29,
   "act": "幕一-三米见方",
   "text": "他起来先看一眼天色，然后去取水。",
   "start": 159.84239583333334,
   "end": 162.759625
  },
  {
   "no": 30,
   "act": "幕一-三米见方",
   "text": "泉眼离屋子不远，走几十步。水从石头缝里出来，冬天也不结冰。",
   "start": 164.009625,
   "end": 170.09722916666666
  },
  {
   "no": 31,
   "act": "幕一-三米见方",
   "text": "取回来的水够一天用。",
   "start": 171.34722916666666,
   "end": 173.1571875
  },
  {
   "no": 32,
   "act": "幕一-三米见方",
   "text": "烧水，煮一点米。米不多，够吃就行。",
   "start": 174.4071875,
   "end": 178.38279166666666
  },
  {
   "no": 33,
   "act": "幕一-三米见方",
   "text": "吃完把碗洗了，放回原处。",
   "start": 179.63279166666666,
   "end": 181.9049375
  },
  {
   "no": 34,
   "act": "幕一-三米见方",
   "text": "一个人住久了，东西都有自己的位置。少一样都知道。",
   "start": 183.1549375,
   "end": 187.94308333333333
  },
  {
   "no": 35,
   "act": "幕一-三米见方",
   "text": "米不够的时候，他就上坡去捡。",
   "start": 189.54308333333333,
   "end": 192.0563125
  },
  {
   "no": 36,
   "act": "幕一-三米见方",
   "text": "坡上有果子，也有能吃的草。他认得几种，别的不碰。",
   "start": 193.3063125,
   "end": 198.1235625
  },
  {
   "no": 37,
   "act": "幕一-三米见方",
   "text": "捡回来的东西不多，煮一煮就是一顿。",
   "start": 199.3735625,
   "end": 202.2616875
  },
  {
   "no": 38,
   "act": "幕一-三米见方",
   "text": "他说，东西少，煮法就简单。煮法简单，反倒吃得下。",
   "start": 203.5116875,
   "end": 208.77764583333334
  },
  {
   "no": 39,
   "act": "幕一-三米见方",
   "text": "以前在城里，一桌菜摆开，他常常挑着吃。现在没得挑，就都吃了。",
   "start": 210.02764583333334,
   "end": 216.47014583333333
  },
  {
   "no": 40,
   "act": "幕一-三米见方",
   "text": "衣服也是有什么穿什么。",
   "start": 218.07014583333333,
   "end": 220.01210416666666
  },
  {
   "no": 41,
   "act": "幕一-三米见方",
   "text": "一件粗布的袍子，一床麻的被子。破了就补，补到看不出原来的样子。",
   "start": 221.26210416666666,
   "end": 227.34516666666667
  },
  {
   "no": 42,
   "act": "幕一-三米见方",
   "text": "他不常照镜子。山里也没有镜子。",
   "start": 228.59516666666667,
   "end": 231.72895833333334
  },
  {
   "no": 43,
   "act": "幕一-三米见方",
   "text": "他说，一个人住着，衣服穿成什么样都无所谓。没有人看，也就没什么好难为情的。",
   "start": 232.97895833333334,
   "end": 240.12020833333332
  },
  {
   "no": 44,
   "act": "幕一-三米见方",
   "text": "要是有人从山下上来，他会把袍子理一理。",
   "start": 241.37020833333332,
   "end": 244.65145833333332
  },
  {
   "no": 45,
   "act": "幕一-三米见方",
   "text": "不过很少有人上来。",
   "start": 245.90145833333332,
   "end": 247.3565
  },
  {
   "no": 46,
   "act": "幕一-三米见方",
   "text": "上午他多半在读书。",
   "start": 248.9565,
   "end": 250.62810416666667
  },
  {
   "no": 47,
   "act": "幕一-三米见方",
   "text": "书不多，翻来覆去就那几本。他说读旧书的好处是不用赶，读到哪儿算哪儿，睡着了也没关系，醒来接着读。",
   "start": 251.87810416666667,
   "end": 261.4998958333333
  },
  {
   "no": 48,
   "act": "幕一-三米见方",
   "text": "读累了就弹琴。",
   "start": 262.7498958333333,
   "end": 264.0375
  },
  {
   "no": 49,
   "act": "幕一-三米见方",
   "text": "弹得不好。他自己承认弹得不好。",
   "start": 265.2875,
   "end": 268.618
  },
  {
   "no": 50,
   "act": "幕一-三米见方",
   "text": "但山里没有别人听，弹坏了也没人笑。",
   "start": 269.868,
   "end": 272.8190416666667
  },
  {
   "no": 51,
   "act": "幕一-三米见方",
   "text": "他说，这是一个人住的好处之一。",
   "start": 274.0690416666667,
   "end": 276.7897291666667
  },
  {
   "no": 52,
   "act": "幕一-三米见方",
   "text": "有时候他也念经。念着念着觉得倦了，就停下来。",
   "start": 278.38972916666665,
   "end": 283.0887916666667
  },
  {
   "no": 53,
   "act": "幕一-三米见方",
   "text": "没有人拦他，也没有人看着他。",
   "start": 284.3387916666667,
   "end": 286.6555
  },
  {
   "no": 54,
   "act": "幕一-三米见方",
   "text": "他说，一个人住，不用跟谁交代今天做了多少。",
   "start": 287.9055,
   "end": 292.07310416666667
  },
  {
   "no": 55,
   "act": "幕一-三米见方",
   "text": "要是住在庙里，倦了也得念完。那是给别人念的。",
   "start": 293.32310416666667,
   "end": 297.71179166666667
  },
  {
   "no": 56,
   "act": "幕一-三米见方",
   "text": "在这儿，倦了就是倦了。",
   "start": 298.96179166666667,
   "end": 300.72704166666665
  },
  {
   "no": 57,
   "act": "幕一-三米见方",
   "text": "他很少说话。",
   "start": 302.3270416666667,
   "end": 303.43779166666667
  },
  {
   "no": 58,
   "act": "幕一-三米见方",
   "text": "不是发过愿不说话。是一个人住着，话自己就少了。",
   "start": 304.68779166666667,
   "end": 309.27304166666664
  },
  {
   "no": 59,
   "act": "幕一-三米见方",
   "text": "有时候一整天没开口。到了晚上他才想起来，今天好像一句也没说。",
   "start": 310.52304166666664,
   "end": 316.39408333333336
  },
  {
   "no": 60,
   "act": "幕一-三米见方",
   "text": "他说，也没觉得少了什么。",
   "start": 317.64408333333336,
   "end": 319.72422916666665
  },
  {
   "no": 61,
   "act": "幕一-三米见方",
   "text": "以前在城里，一天要说很多话。多半是不说不行的那种。",
   "start": 320.97422916666665,
   "end": 326.05272916666667
  },
  {
   "no": 62,
   "act": "幕一-三米见方",
   "text": "现在不说，也没有人等着他说。",
   "start": 327.30272916666667,
   "end": 329.746875
  },
  {
   "no": 63,
   "act": "幕一-三米见方",
   "text": "到了下午，光斜进来，照到东边那片蕨草上。",
   "start": 331.346875,
   "end": 335.27791666666667
  },
  {
   "no": 64,
   "act": "幕一-三米见方",
   "text": "他有时候什么也不做，就坐着看那片光慢慢挪。",
   "start": 336.52791666666667,
   "end": 340.5817083333333
  },
  {
   "no": 65,
   "act": "幕一-三米见方",
   "text": "从床沿挪到地上，再挪到门口，然后就没了。",
   "start": 341.8317083333333,
   "end": 345.66439583333334
  },
  {
   "no": 66,
   "act": "幕一-三米见方",
   "text": "一个下午就这么过去。",
   "start": 346.91439583333334,
   "end": 348.4630833333333
  },
  {
   "no": 67,
   "act": "幕一-三米见方",
   "text": "他不觉得可惜。",
   "start": 349.7130833333333,
   "end": 350.86927083333336
  },
  {
   "no": 68,
   "act": "幕一-三米见方",
   "text": "他说，人这一生要做的事，其实没有想象中那么多。",
   "start": 352.11927083333336,
   "end": 356.40525
  },
  {
   "no": 69,
   "act": "幕一-三米见方",
   "text": "天黑得也慢。",
   "start": 358.00525,
   "end": 359.09591666666665
  },
  {
   "no": 70,
   "act": "幕一-三米见方",
   "text": "先是屋里看不清字了，他把书合上。然后是窗纸上的树影没了。再过一会儿，外面和屋里就一样暗。",
   "start": 360.34591666666665,
   "end": 369.36260416666664
  },
  {
   "no": 71,
   "act": "幕一-三米见方",
   "text": "他不点灯。",
   "start": 370.61260416666664,
   "end": 371.4435208333333
  },
  {
   "no": 72,
   "act": "幕一-三米见方",
   "text": "灯油要从山下背上来，他嫌麻烦。而且天黑了本来就该睡。",
   "start": 372.6935208333333,
   "end": 378.6182083333333
  },
  {
   "no": 73,
   "act": "幕一-三米见方",
   "text": "躺下之前他会去门口站一会儿。",
   "start": 379.8682083333333,
   "end": 382.406
  },
  {
   "no": 74,
   "act": "幕一-三米见方",
   "text": "山里的夜很静。静到能听见风从远处过来，先响一阵树，再响另一阵树。",
   "start": 383.656,
   "end": 390.3241458333333
  },
  {
   "no": 75,
   "act": "幕一-三米见方",
   "text": "有时候有鹿叫。声音很远，听不出在哪个方向。",
   "start": 391.5741458333333,
   "end": 395.9091875
  },
  {
   "no": 76,
   "act": "幕一-三米见方",
   "text": "他说，年轻的时候他怕这种静。",
   "start": 397.1591875,
   "end": 400.051875
  },
  {
   "no": 77,
   "act": "幕一-三米见方",
   "text": "现在不怕了。",
   "start": 401.301875,
   "end": 402.3725416666667
  },
  {
   "no": 78,
   "act": "幕一-三米见方",
   "text": "夜里也不是全无声音。",
   "start": 403.97254166666664,
   "end": 405.7132291666667
  },
  {
   "no": 79,
   "act": "幕一-三米见方",
   "text": "猫头鹰会叫。头一年他听着不舒服，后来习惯了。",
   "start": 406.9632291666667,
   "end": 411.51483333333334
  },
  {
   "no": 80,
   "act": "幕一-三米见方",
   "text": "他说，这座山不是什么凶险的地方。声音就是声音，没有别的意思。",
   "start": 412.76483333333334,
   "end": 418.8678958333333
  },
  {
   "no": 81,
   "act": "幕一-三米见方",
   "text": "月亮好的时候，光会落到窗纸上。屋里跟着亮一层。",
   "start": 420.1178958333333,
   "end": 424.7676875
  },
  {
   "no": 82,
   "act": "幕一-三米见方",
   "text": "他有时候会想起一些人。想一会儿，也就过去了。",
   "start": 426.0176875,
   "end": 430.1561875
  },
  {
   "no": 83,
   "act": "幕一-三米见方",
   "text": "他不写下来。",
   "start": 431.4061875,
   "end": 432.4162083333333
  },
  {
   "no": 84,
   "act": "幕一-三米见方",
   "text": "他睡得很早，也醒得很早。",
   "start": 434.01620833333334,
   "end": 436.19016666666664
  },
  {
   "no": 85,
   "act": "幕一-三米见方",
   "text": "夜里偶尔会醒一次，睁眼看见屋顶。屋顶很低，伸手就能碰到。",
   "start": 437.44016666666664,
   "end": 443.2912083333333
  },
  {
   "no": 86,
   "act": "幕一-三米见方",
   "text": "他说，住惯了小屋子有一个好处：醒过来的时候，你马上知道自己在哪儿。",
   "start": 444.5412083333333,
   "end": 450.6088125
  },
  {
   "no": 87,
   "act": "幕一-三米见方",
   "text": "住大房子不是这样。大房子里醒过来，要愣一会儿。",
   "start": 451.8588125,
   "end": 456.1693333333333
  },
  {
   "no": 88,
   "act": "幕一-三米见方",
   "text": "灶里的炭火还埋在灰底下。他伸手拨一拨，红一下，又暗回去。",
   "start": 457.4193333333333,
   "end": 463.30583333333334
  },
  {
   "no": 89,
   "act": "幕一-三米见方",
   "text": "他说，一个人到了这个岁数，夜里醒了，有这么一点亮着的东西就够了。",
   "start": 464.55583333333334,
   "end": 470.1610625
  },
  {
   "no": 90,
   "act": "幕一-三米见方",
   "text": "然后他就接着睡了。",
   "start": 471.4110625,
   "end": 472.9442916666667
  },
  {
   "no": 91,
   "act": "幕一-三米见方",
   "text": "住着住着，这间临时的屋子也有了旧样子。",
   "start": 474.54429166666665,
   "end": 478.10679166666665
  },
  {
   "no": 92,
   "act": "幕一-三米见方",
   "text": "屋檐上积了一层落叶，没人扫。地基那一圈长了苔。",
   "start": 479.35679166666665,
   "end": 484.0065833333333
  },
  {
   "no": 93,
   "act": "幕一-三米见方",
   "text": "他刚搭起来的时候，是打算随时能走的。",
   "start": 485.2565833333333,
   "end": 488.39054166666665
  },
  {
   "no": 94,
   "act": "幕一-三米见方",
   "text": "几年过去，他还在这儿。",
   "start": 489.64054166666665,
   "end": 491.55322916666665
  },
  {
   "no": 95,
   "act": "幕一-三米见方",
   "text": "他说，人过到这个份上，想要的东西自然就少了。",
   "start": 493.1532291666667,
   "end": 497.5328125
  },
  {
   "no": 96,
   "act": "幕一-三米见方",
   "text": "不是他把想要的东西戒掉了。是他知道自己是什么人，也知道外面是怎么回事。",
   "start": 498.7828125,
   "end": 505.58933333333334
  },
  {
   "no": 97,
   "act": "幕一-三米见方",
   "text": "知道了，就不太想争，也不太想去哪儿。",
   "start": 506.83933333333334,
   "end": 509.953125
  },
  {
   "no": 98,
   "act": "幕一-三米见方",
   "text": "他每天想的事情，无非是水够不够，柴够不够，今天要不要出门。",
   "start": 511.203125,
   "end": 516.7347291666666
  },
  {
   "no": 99,
   "act": "幕一-三米见方",
   "text": "想完就没了。",
   "start": 517.9847291666666,
   "end": 519.0553958333334
  },
  {
   "no": 100,
   "act": "幕一-三米见方",
   "text": "他说，他只求一样，安静。",
   "start": 520.3053958333334,
   "end": 522.7895416666667
  },
  {
   "no": 101,
   "act": "幕一-三米见方",
   "text": "再有一样，是没有什么烦心的事要惦记。",
   "start": 524.0395416666667,
   "end": 527.3653333333333
  },
  {
   "no": 102,
   "act": "幕一-三米见方",
   "text": "这两样他现在都有。",
   "start": 528.6153333333333,
   "end": 530.4589166666667
  },
  {
   "no": 103,
   "act": "幕一-三米见方",
   "text": "这样的日子，他过了几年。",
   "start": 532.0589166666666,
   "end": 534.2081458333333
  },
  {
   "no": 104,
   "act": "幕一-三米见方",
   "text": "有人问他，不闷吗。",
   "start": 535.4581458333333,
   "end": 537.1542916666667
  },
  {
   "no": 105,
   "act": "幕一-三米见方",
   "text": "他说，闷。",
   "start": 538.4042916666667,
   "end": 539.4349583333334
  },
  {
   "no": 106,
   "act": "幕一-三米见方",
   "text": "但他没有搬走。",
   "start": 540.6849583333334,
   "end": 541.8789166666667
  },
  {
   "no": 107,
   "act": "幕二-他从哪儿来",
   "text": "他不是一开始就住在山里的。",
   "start": 544.0789166666667,
   "end": 546.2774375
  },
  {
   "no": 108,
   "act": "幕二-他从哪儿来",
   "text": "六十岁那年他才搬进那间三米见方的屋子。",
   "start": 547.5274375,
   "end": 551.2373958333334
  },
  {
   "no": 109,
   "act": "幕二-他从哪儿来",
   "text": "在那之前，他一直住在城里。",
   "start": 552.4873958333334,
   "end": 554.9715416666667
  },
  {
   "no": 110,
   "act": "幕二-他从哪儿来",
   "text": "他家里世代管一座神社。",
   "start": 556.5715416666667,
   "end": 558.6516875
  },
  {
   "no": 111,
   "act": "幕二-他从哪儿来",
   "text": "这在当时算是一份体面的差事。不富，但稳当，而且是传下来的。",
   "start": 559.9016875,
   "end": 566.1812916666667
  },
  {
   "no": 112,
   "act": "幕二-他从哪儿来",
   "text": "差事的内容其实很琐碎。早上开门，扫院子，摆供，把该记的事记下来。",
   "start": 567.4312916666667,
   "end": 574.2578125
  },
  {
   "no": 113,
   "act": "幕二-他从哪儿来",
   "text": "一年里有几天要办大祭，忙上十天半月。剩下的日子都差不多。",
   "start": 575.5078125,
   "end": 581.2114166666667
  },
  {
   "no": 114,
   "act": "幕二-他从哪儿来",
   "text": "他小时候跟着大人在院子里跑。哪棵树底下最凉快，哪块石头夏天不烫脚，他都知道。",
   "start": 582.4614166666667,
   "end": 590.2524791666667
  },
  {
   "no": 115,
   "act": "幕二-他从哪儿来",
   "text": "他那时候就明白，将来这个院子是他的。",
   "start": 591.5024791666667,
   "end": 594.6162708333334
  },
  {
   "no": 116,
   "act": "幕二-他从哪儿来",
   "text": "后来没轮到他。",
   "start": 596.2162708333333,
   "end": 597.4393333333334
  },
  {
   "no": 117,
   "act": "幕二-他从哪儿来",
   "text": "具体是怎么错过的，他没有细写。",
   "start": 598.6893333333334,
   "end": 601.3409375
  },
  {
   "no": 118,
   "act": "幕二-他从哪儿来",
   "text": "大意是：他父亲走得早，位置空出来的时候他还小，别人先补上了。",
   "start": 602.5909375,
   "end": 608.4374375
  },
  {
   "no": 119,
   "act": "幕二-他从哪儿来",
   "text": "等他长大，位置已经有主了。",
   "start": 609.6874375,
   "end": 612.0086875
  },
  {
   "no": 120,
   "act": "幕二-他从哪儿来",
   "text": "他等过很多年。中间也活动过，托过人。",
   "start": 613.2586875,
   "end": 617.1359166666666
  },
  {
   "no": 121,
   "act": "幕二-他从哪儿来",
   "text": "都没成。",
   "start": 618.3859166666666,
   "end": 619.1965833333334
  },
  {
   "no": 122,
   "act": "幕二-他从哪儿来",
   "text": "他说这件事的时候只用了很短的一句话。他一辈子写了不少字，这一件写得最少。",
   "start": 620.4465833333334,
   "end": 627.429625
  },
  {
   "no": 123,
   "act": "幕二-他从哪儿来",
   "text": "中间有一次差点就成了。",
   "start": 629.029625,
   "end": 631.1097708333333
  },
  {
   "no": 124,
   "act": "幕二-他从哪儿来",
   "text": "那是另一座小一点的神社，管事的位置空了出来。",
   "start": 632.3597708333333,
   "end": 636.217
  },
  {
   "no": 125,
   "act": "幕二-他从哪儿来",
   "text": "上头有人赏识他，愿意推荐他去。事情已经说到很具体的地步了。",
   "start": 637.467,
   "end": 643.0476875
  },
  {
   "no": 126,
   "act": "幕二-他从哪儿来",
   "text": "后来同族里有人不同意。",
   "start": 644.2976875,
   "end": 646.2641875
  },
  {
   "no": 127,
   "act": "幕二-他从哪儿来",
   "text": "理由是什么，他没写。",
   "start": 647.5141875,
   "end": 649.446875
  },
  {
   "no": 128,
   "act": "幕二-他从哪儿来",
   "text": "那件事最后没成。那一年他五十岁上下。",
   "start": 650.696875,
   "end": 654.5295625
  },
  {
   "no": 129,
   "act": "幕二-他从哪儿来",
   "text": "他还写歌。",
   "start": 656.1295625,
   "end": 657.0610416666667
  },
  {
   "no": 130,
   "act": "幕二-他从哪儿来",
   "text": "这件事他做得比管神社认真得多。",
   "start": 658.3110416666667,
   "end": 661.1837291666667
  },
  {
   "no": 131,
   "act": "幕二-他从哪儿来",
   "text": "年轻的时候他就写，写了几十年。后来有人赏识，给过他一个跟歌有关的差事。",
   "start": 662.4337291666667,
   "end": 669.28025
  },
  {
   "no": 132,
   "act": "幕二-他从哪儿来",
   "text": "那个差事他做过一阵子，做得还行。",
   "start": 670.53025,
   "end": 673.7333125
  },
  {
   "no": 133,
   "act": "幕二-他从哪儿来",
   "text": "他说，写歌这件事没有辜负他。",
   "start": 674.9833125,
   "end": 677.8514375
  },
  {
   "no": 134,
   "act": "幕二-他从哪儿来",
   "text": "但他也说，写歌养不活一个人。",
   "start": 679.1014375,
   "end": 681.6839375
  },
  {
   "no": 135,
   "act": "幕二-他从哪儿来",
   "text": "祖上传下来一所房子，他住了很久。",
   "start": 683.2839375,
   "end": 686.1611666666666
  },
  {
   "no": 136,
   "act": "幕二-他从哪儿来",
   "text": "那房子他很熟。哪块地板会响，哪扇门推起来涩，他闭着眼都知道。",
   "start": 687.4111666666666,
   "end": 693.7443958333333
  },
  {
   "no": 137,
   "act": "幕二-他从哪儿来",
   "text": "院子里有一口井。井边有块石头，他小时候坐在上面等过人。",
   "start": 694.9943958333333,
   "end": 700.579625
  },
  {
   "no": 138,
   "act": "幕二-他从哪儿来",
   "text": "后来家里的人一个一个散了。有的走了，有的没了。",
   "start": 701.829625,
   "end": 706.2473958333334
  },
  {
   "no": 139,
   "act": "幕二-他从哪儿来",
   "text": "房子还在，走动的人越来越少。",
   "start": 707.4973958333334,
   "end": 710.0244583333333
  },
  {
   "no": 140,
   "act": "幕二-他从哪儿来",
   "text": "到最后，屋子多半是空的。他一个人住着，晚上要走过好几间黑屋子才到自己那间。",
   "start": 711.2744583333333,
   "end": 718.8489583333334
  },
  {
   "no": 141,
   "act": "幕二-他从哪儿来",
   "text": "再后来他自己也搬了出来。",
   "start": 720.0989583333334,
   "end": 722.2281875
  },
  {
   "no": 142,
   "act": "幕二-他从哪儿来",
   "text": "他说，他舍不得的东西其实不少。但一样一样数下来，没有一样是走不了的。",
   "start": 723.4781875,
   "end": 730.2399791666667
  },
  {
   "no": 143,
   "act": "幕二-他从哪儿来",
   "text": "三十多岁那年，他自己搭了一间房。",
   "start": 731.8399791666667,
   "end": 734.6590416666667
  },
  {
   "no": 144,
   "act": "幕二-他从哪儿来",
   "text": "那间房比原来的小很多。他自己算过，只有原来的十分之一。",
   "start": 735.9090416666667,
   "end": 741.3468125
  },
  {
   "no": 145,
   "act": "幕二-他从哪儿来",
   "text": "也不是完全按自己的心意搭的。是有多少料，搭多大。",
   "start": 742.5968125,
   "end": 747.3649583333333
  },
  {
   "no": 146,
   "act": "幕二-他从哪儿来",
   "text": "围墙倒是垒了一圈，矮矮的。门没钱做，一直空着。",
   "start": 748.6149583333333,
   "end": 753.5751041666666
  },
  {
   "no": 147,
   "act": "幕二-他从哪儿来",
   "text": "停车的地方用几根竹子撑了个棚。下雨的时候顶上滴水。",
   "start": 754.8251041666666,
   "end": 760.1201666666667
  },
  {
   "no": 148,
   "act": "幕二-他从哪儿来",
   "text": "来过的人说，这不像个正经宅子。",
   "start": 761.3701666666667,
   "end": 764.140125
  },
  {
   "no": 149,
   "act": "幕二-他从哪儿来",
   "text": "他自己也承认不像。",
   "start": 765.390125,
   "end": 766.8497291666666
  },
  {
   "no": 150,
   "act": "幕二-他从哪儿来",
   "text": "但他在那间房里住了很久。",
   "start": 768.0997291666666,
   "end": 770.2827916666666
  },
  {
   "no": 151,
   "act": "幕二-他从哪儿来",
   "text": "那地方离河很近。",
   "start": 771.8827916666667,
   "end": 773.3332916666667
  },
  {
   "no": 152,
   "act": "幕二-他从哪儿来",
   "text": "一到雨季他就睡不踏实。水涨起来的声音，隔着墙也听得见。",
   "start": 774.5832916666667,
   "end": 780.1930833333333
  },
  {
   "no": 153,
   "act": "幕二-他从哪儿来",
   "text": "他半夜起来看过好几回。提着灯走到岸边，看一眼水位，再走回来。",
   "start": 781.4430833333333,
   "end": 787.7181458333333
  },
  {
   "no": 154,
   "act": "幕二-他从哪儿来",
   "text": "水没上来，但他还是睡不着。",
   "start": 788.9681458333333,
   "end": 791.441375
  },
  {
   "no": 155,
   "act": "幕二-他从哪儿来",
   "text": "河边那一带也不太平。夜里有人走动，说不清是干什么的。",
   "start": 792.691375,
   "end": 798.0446041666667
  },
  {
   "no": 156,
   "act": "幕二-他从哪儿来",
   "text": "他后来说，住在那儿的那些年，他一直在提着心。",
   "start": 799.2946041666667,
   "end": 803.2656458333333
  },
  {
   "no": 157,
   "act": "幕二-他从哪儿来",
   "text": "不是怕哪一件具体的事。是那种日子本身就让人放不下心。",
   "start": 804.5156458333333,
   "end": 809.6877916666666
  },
  {
   "no": 158,
   "act": "幕二-他从哪儿来",
   "text": "三十多年就这么过去了。",
   "start": 810.9377916666666,
   "end": 812.8750208333333
  },
  {
   "no": 159,
   "act": "幕二-他从哪儿来",
   "text": "城里的房子是很多的。",
   "start": 814.4750208333334,
   "end": 816.146625
  },
  {
   "no": 160,
   "act": "幕二-他从哪儿来",
   "text": "屋脊挨着屋脊，一排排看过去，谁家的瓦高，谁家的瓦矮，一眼就分得出。",
   "start": 817.396625,
   "end": 823.819125
  },
  {
   "no": 161,
   "act": "幕二-他从哪儿来",
   "text": "盖房子的人都想盖得比旁边高一点。他年轻的时候也觉得这是正经事。",
   "start": 825.069125,
   "end": 831.6590833333333
  },
  {
   "no": 162,
   "act": "幕二-他从哪儿来",
   "text": "看上去这些房子会一直在那儿。一代传一代，永远不会完。",
   "start": 832.9090833333333,
   "end": 838.0275833333334
  },
  {
   "no": 163,
   "act": "幕二-他从哪儿来",
   "text": "他说，真去查就不是这么回事。",
   "start": 839.2775833333334,
   "end": 841.8800833333333
  },
  {
   "no": 164,
   "act": "幕二-他从哪儿来",
   "text": "从前的房子，现在还在的很少。",
   "start": 843.4800833333334,
   "end": 846.2146041666666
  },
  {
   "no": 165,
   "act": "幕二-他从哪儿来",
   "text": "有的去年烧了，今年重新盖起来。",
   "start": 847.4646041666666,
   "end": 850.2145625
  },
  {
   "no": 166,
   "act": "幕二-他从哪儿来",
   "text": "有的原来是大宅，后来分了，卖了，成了几间小屋。",
   "start": 851.4645625,
   "end": 855.8241458333333
  },
  {
   "no": 167,
   "act": "幕二-他从哪儿来",
   "text": "有的还在，可里面住的已经不是原来那家人了。",
   "start": 857.0741458333333,
   "end": 860.8868333333334
  },
  {
   "no": 168,
   "act": "幕二-他从哪儿来",
   "text": "住在里面的人也一样。",
   "start": 862.1368333333334,
   "end": 863.714625
  },
  {
   "no": 169,
   "act": "幕二-他从哪儿来",
   "text": "地方没变，人也一样多。可是从前认识的那些人，二三十个里头，现在还能见到的，只剩一两个。",
   "start": 864.964625,
   "end": 873.5973125
  },
  {
   "no": 170,
   "act": "幕二-他从哪儿来",
   "text": "早上有人没了，晚上有人生下来。",
   "start": 874.8473125,
   "end": 877.5972708333334
  },
  {
   "no": 171,
   "act": "幕二-他从哪儿来",
   "text": "他说，这跟水面上的泡沫是一回事。",
   "start": 878.8472708333334,
   "end": 881.9810625
  },
  {
   "no": 172,
   "act": "幕二-他从哪儿来",
   "text": "有一个比方他打得很轻。",
   "start": 883.5810625,
   "end": 885.3710208333333
  },
  {
   "no": 173,
   "act": "幕二-他从哪儿来",
   "text": "早上开的那种花，太阳一出来就蔫。花瓣上有露水。",
   "start": 886.6210208333333,
   "end": 891.3891666666667
  },
  {
   "no": 174,
   "act": "幕二-他从哪儿来",
   "text": "有时候露水先掉了，花还开着。",
   "start": 892.6391666666667,
   "end": 895.2262291666667
  },
  {
   "no": 175,
   "act": "幕二-他从哪儿来",
   "text": "花是还开着，可太阳一晒就干了。",
   "start": 896.4762291666667,
   "end": 899.1861875
  },
  {
   "no": 176,
   "act": "幕二-他从哪儿来",
   "text": "有时候花先谢了，露水还挂在那儿。",
   "start": 900.4361875,
   "end": 903.21525
  },
  {
   "no": 177,
   "act": "幕二-他从哪儿来",
   "text": "露水是还挂着，可撑不到天黑。",
   "start": 904.46525,
   "end": 907.1859375
  },
  {
   "no": 178,
   "act": "幕二-他从哪儿来",
   "text": "谁先谁后，其实差不了多久。",
   "start": 908.4359375,
   "end": 911.003
  },
  {
   "no": 179,
   "act": "幕二-他从哪儿来",
   "text": "他说，人和房子，就是这么互相比着谁先没。",
   "start": 912.253,
   "end": 916.4160625
  },
  {
   "no": 180,
   "act": "幕二-他从哪儿来",
   "text": "他在城里住的那些年，城里出过几回大事。",
   "start": 918.0160625,
   "end": 921.86875
  },
  {
   "no": 181,
   "act": "幕二-他从哪儿来",
   "text": "烧过，塌过，闹过饥荒。",
   "start": 923.11875,
   "end": 925.4647083333333
  },
  {
   "no": 182,
   "act": "幕二-他从哪儿来",
   "text": "那些事他都写下来了，写得很细，很长。这里不讲。",
   "start": 926.7147083333333,
   "end": 931.7239375
  },
  {
   "no": 183,
   "act": "幕二-他从哪儿来",
   "text": "只说一件：他年轻时候见过的那些房子，一间也没剩下。",
   "start": 932.9739375,
   "end": 937.9140833333333
  },
  {
   "no": 184,
   "act": "幕二-他从哪儿来",
   "text": "不是被谁拆的。就是一年一年，各有各的去处。",
   "start": 939.1640833333333,
   "end": 943.519125
  },
  {
   "no": 185,
   "act": "幕二-他从哪儿来",
   "text": "他说，他那时候还想不明白，人为什么要在这种地方费这么大力气盖房子。",
   "start": 944.769125,
   "end": 950.8321875
  },
  {
   "no": 186,
   "act": "幕二-他从哪儿来",
   "text": "五十岁那年春天，他离开了。",
   "start": 952.4321875,
   "end": 954.9254166666667
  },
  {
   "no": 187,
   "act": "幕二-他从哪儿来",
   "text": "没有跟谁交代，也没有什么手续要办。",
   "start": 956.1754166666667,
   "end": 958.9944791666667
  },
  {
   "no": 188,
   "act": "幕二-他从哪儿来",
   "text": "他没有妻子，没有孩子。",
   "start": 960.2444791666667,
   "end": 962.3200833333333
  },
  {
   "no": 189,
   "act": "幕二-他从哪儿来",
   "text": "没有官职，也没有俸禄。",
   "start": 963.5700833333333,
   "end": 965.5720416666667
  },
  {
   "no": 190,
   "act": "幕二-他从哪儿来",
   "text": "他说，走的时候他想了想，发现没有一样东西是拽着他不让走的。",
   "start": 966.8220416666667,
   "end": 972.2352708333333
  },
  {
   "no": 191,
   "act": "幕二-他从哪儿来",
   "text": "带走的东西装了两个包。剩下的都留在原处。",
   "start": 973.4852708333333,
   "end": 977.9430416666667
  },
  {
   "no": 192,
   "act": "幕二-他从哪儿来",
   "text": "包里装的是几本书，一些抄本，几件换洗的衣服。琴和琵琶另外拿。",
   "start": 979.1930416666667,
   "end": 985.4926458333333
  },
  {
   "no": 193,
   "act": "幕二-他从哪儿来",
   "text": "他说，收拾只用了半天。",
   "start": 986.7426458333333,
   "end": 988.8473333333334
  },
  {
   "no": 194,
   "act": "幕二-他从哪儿来",
   "text": "他在那所房子里住了三十几年，收拾只用了半天。",
   "start": 990.0973333333334,
   "end": 994.191125
  },
  {
   "no": 195,
   "act": "幕二-他从哪儿来",
   "text": "他说，他没有回头看。倒不是舍得，是那天太早，天还没亮，回头也看不见什么。",
   "start": 995.441125,
   "end": 1002.9418125
  },
  {
   "no": 196,
   "act": "幕二-他从哪儿来",
   "text": "那年他把头发剃了。",
   "start": 1004.5418125,
   "end": 1006.3116041666667
  },
  {
   "no": 197,
   "act": "幕二-他从哪儿来",
   "text": "是自己动的手，还是找了人，他没写。",
   "start": 1007.5616041666667,
   "end": 1010.8966458333333
  },
  {
   "no": 198,
   "act": "幕二-他从哪儿来",
   "text": "剃完他照旧走路，照旧吃饭。",
   "start": 1012.1466458333333,
   "end": 1014.5862291666666
  },
  {
   "no": 199,
   "act": "幕二-他从哪儿来",
   "text": "他说，剃头这件事，外面看是一桩大事。自己做起来，就是一个下午。",
   "start": 1015.8362291666666,
   "end": 1022.3769166666667
  },
  {
   "no": 200,
   "act": "幕二-他从哪儿来",
   "text": "从那天起，别人叫他的称呼变了。",
   "start": 1023.6269166666667,
   "end": 1026.376875
  },
  {
   "no": 201,
   "act": "幕二-他从哪儿来",
   "text": "他说，称呼变了，人还是那个人。早上醒来该想的事，一件也没少。",
   "start": 1027.626875,
   "end": 1034.029375
  },
  {
   "no": 202,
   "act": "幕二-他从哪儿来",
   "text": "先是在另一座山里住了五年。",
   "start": 1035.629375,
   "end": 1037.8769791666666
  },
  {
   "no": 203,
   "act": "幕二-他从哪儿来",
   "text": "那五年他没怎么写东西。",
   "start": 1039.1269791666666,
   "end": 1041.1534791666666
  },
  {
   "no": 204,
   "act": "幕二-他从哪儿来",
   "text": "住的地方比现在那间还简单。他后来提起来，说那几年像是在缓一口气。",
   "start": 1042.4034791666666,
   "end": 1048.8459791666667
  },
  {
   "no": 205,
   "act": "幕二-他从哪儿来",
   "text": "缓过来了，他才想清楚下一步怎么住。",
   "start": 1050.0959791666667,
   "end": 1053.3172291666667
  },
  {
   "no": 206,
   "act": "幕二-他从哪儿来",
   "text": "六十岁那年，他搬到了现在这个地方，搭了那间三米见方的屋子。",
   "start": 1054.5672291666667,
   "end": 1059.8130208333334
  },
  {
   "no": 207,
   "act": "幕二-他从哪儿来",
   "text": "他说，房子是给身体住的。",
   "start": 1061.4130208333333,
   "end": 1063.6560833333333
  },
  {
   "no": 208,
   "act": "幕二-他从哪儿来",
   "text": "身体就那么大。躺下要一个人的长度，坐起来要一个人的高度。",
   "start": 1064.9060833333333,
   "end": 1070.2256666666667
  },
  {
   "no": 209,
   "act": "幕二-他从哪儿来",
   "text": "多出来的部分，不是给身体的，是给别的东西的。",
   "start": 1071.4756666666667,
   "end": 1075.3283541666667
  },
  {
   "no": 210,
   "act": "幕二-他从哪儿来",
   "text": "给客人，给面子，给将来。",
   "start": 1076.5783541666667,
   "end": 1079.0425
  },
  {
   "no": 211,
   "act": "幕二-他从哪儿来",
   "text": "他说，他现在不需要那些了。",
   "start": 1080.2925,
   "end": 1082.5401041666667
  },
  {
   "no": 212,
   "act": "幕二-他从哪儿来",
   "text": "客人很少来。面子在山里不值钱。至于将来，他这个岁数，将来也不长了。",
   "start": 1083.7901041666667,
   "end": 1091.03425
  },
  {
   "no": 213,
   "act": "幕二-他从哪儿来",
   "text": "所以他把房子做成了现在这样。",
   "start": 1092.63425,
   "end": 1095.1922083333334
  },
  {
   "no": 214,
   "act": "幕二-他从哪儿来",
   "text": "一丈见方，高不到七尺。拆得开，搬得走。",
   "start": 1096.4422083333334,
   "end": 1100.7727291666667
  },
  {
   "no": 215,
   "act": "幕二-他从哪儿来",
   "text": "他说，这不是想通了什么大道理。",
   "start": 1102.0227291666667,
   "end": 1105.0092291666667
  },
  {
   "no": 216,
   "act": "幕二-他从哪儿来",
   "text": "是一样一样减下来，减到最后就剩这么多。",
   "start": 1106.2592291666667,
   "end": 1109.7971875
  },
  {
   "no": 217,
   "act": "幕二-他从哪儿来",
   "text": "有一件事他讲得很清楚。",
   "start": 1111.3971875,
   "end": 1113.5309791666666
  },
  {
   "no": 218,
   "act": "幕二-他从哪儿来",
   "text": "他说，他不是因为看破了什么才搬到山里的。",
   "start": 1114.7809791666666,
   "end": 1118.4907708333333
  },
  {
   "no": 219,
   "act": "幕二-他从哪儿来",
   "text": "他是先没了差事，再没了房子，最后才发现自己什么也不缺。",
   "start": 1119.7407708333333,
   "end": 1125.0312916666667
  },
  {
   "no": 220,
   "act": "幕二-他从哪儿来",
   "text": "顺序是反的。",
   "start": 1126.2812916666667,
   "end": 1127.47525
  },
  {
   "no": 221,
   "act": "幕二-他从哪儿来",
   "text": "他说，要是当年那个位置轮到了他，他大概会在那所大房子里住一辈子。",
   "start": 1128.72525,
   "end": 1134.6608333333334
  }
 ]
}