{
 "part": "下",
 "epTitle": "秋与冬",
 "acts": [
  "幕三-秋是黄昏",
  "幕四-冬是清早"
 ],
 "duration": 1006.405542,
 "chars": 3804,
 "beats": {
  "常规": 1.25,
  "停顿点": 1.6,
  "幕末": 2.2
 },
 "loudness": {
  "i": -20.9,
  "tp": -7.5,
  "voiceOnly": -21
 },
 "cues": [
  {
   "no": 1,
   "act": "幕三-秋是黄昏",
   "text": "秋天最好的是黄昏。",
   "start": 0.5,
   "end": 2.1177916666666667
  },
  {
   "no": 2,
   "act": "幕三-秋是黄昏",
   "text": "太阳靠到山边上，光斜过来。",
   "start": 3.3677916666666667,
   "end": 5.950291666666667
  },
  {
   "no": 3,
   "act": "幕三-秋是黄昏",
   "text": "乌鸦往窝里飞，三只四只，两只三只，一路飞过去。",
   "start": 7.200291666666667,
   "end": 11.939354166666666
  },
  {
   "no": 4,
   "act": "幕三-秋是黄昏",
   "text": "再往后是雁，排成很小的一行，越飞越远。",
   "start": 13.189354166666666,
   "end": 16.814604166666665
  },
  {
   "no": 5,
   "act": "幕三-秋是黄昏",
   "text": "太阳落下去以后，风的声音、虫的声音，说不上来的好。",
   "start": 18.064604166666665,
   "end": 22.788208333333333
  },
  {
   "no": 6,
   "act": "幕三-秋是黄昏",
   "text": "这一段是她写得最长的一处景。",
   "start": 24.038208333333333,
   "end": 26.47325
  },
  {
   "no": 7,
   "act": "幕三-秋是黄昏",
   "text": "她写春天只写了拂晓那一会儿，写夏天只写了夜。",
   "start": 27.72325,
   "end": 31.678854166666667
  },
  {
   "no": 8,
   "act": "幕三-秋是黄昏",
   "text": "写到秋天的黄昏，她一口气写了好几样。",
   "start": 32.92885416666667,
   "end": 36.303895833333335
  },
  {
   "no": 9,
   "act": "幕三-秋是黄昏",
   "text": "她说，虫的声音里她最记得的是铃虫。",
   "start": 37.90389583333333,
   "end": 41.249854166666665
  },
  {
   "no": 10,
   "act": "幕三-秋是黄昏",
   "text": "那声音一停一停的，不连着。",
   "start": 42.499854166666665,
   "end": 44.865625
  },
  {
   "no": 11,
   "act": "幕三-秋是黄昏",
   "text": "夜里听着，会觉得它是从很远的地方过来的。",
   "start": 46.115625,
   "end": 49.899229166666665
  },
  {
   "no": 12,
   "act": "幕三-秋是黄昏",
   "text": "九月里的早晨她写了一段露水。",
   "start": 51.149229166666665,
   "end": 53.780833333333334
  },
  {
   "no": 13,
   "act": "幕三-秋是黄昏",
   "text": "下了一夜雨，天亮的时候忽然放晴。",
   "start": 55.030833333333334,
   "end": 58.07097916666667
  },
  {
   "no": 14,
   "act": "幕三-秋是黄昏",
   "text": "院子里的草上，蜘蛛网上，全是水珠。",
   "start": 59.32097916666667,
   "end": 62.696020833333336
  },
  {
   "no": 15,
   "act": "幕三-秋是黄昏",
   "text": "太阳一照，那些水珠一齐亮起来。",
   "start": 63.946020833333336,
   "end": 66.71597916666667
  },
  {
   "no": 16,
   "act": "幕三-秋是黄昏",
   "text": "她说，日头再高一点，草上的水就自己往下落。",
   "start": 68.31597916666666,
   "end": 72.528125
  },
  {
   "no": 17,
   "act": "幕三-秋是黄昏",
   "text": "枝条动一下，水一串一串掉下去，枝条就弹起来。",
   "start": 73.778125,
   "end": 77.87208333333334
  },
  {
   "no": 18,
   "act": "幕三-秋是黄昏",
   "text": "她写到这儿加了一句：这件事她说给别人听，别人不觉得有什么意思。",
   "start": 79.12208333333334,
   "end": 84.60458333333334
  },
  {
   "no": 19,
   "act": "幕三-秋是黄昏",
   "text": "她把这句也写了下来。",
   "start": 85.85458333333334,
   "end": 87.50164583333333
  },
  {
   "no": 20,
   "act": "幕三-秋是黄昏",
   "text": "写完还是没有解释。",
   "start": 88.75164583333333,
   "end": 90.35414583333333
  },
  {
   "no": 21,
   "act": "幕三-秋是黄昏",
   "text": "秋天她写野地里的花。",
   "start": 91.95414583333333,
   "end": 93.71939583333334
  },
  {
   "no": 22,
   "act": "幕三-秋是黄昏",
   "text": "紫的、白的、开得散散的那几种。",
   "start": 94.96939583333334,
   "end": 97.91589583333334
  },
  {
   "no": 23,
   "act": "幕三-秋是黄昏",
   "text": "她说，秋天的花不像春天的花那样一大片，是一处一处的。",
   "start": 99.16589583333334,
   "end": 103.8156875
  },
  {
   "no": 24,
   "act": "幕三-秋是黄昏",
   "text": "要走到跟前才看得见。",
   "start": 105.0656875,
   "end": 106.8109375
  },
  {
   "no": 25,
   "act": "幕三-秋是黄昏",
   "text": "她还写了一份单子，叫「让人心里动一下的事」。",
   "start": 108.0609375,
   "end": 111.40689583333334
  },
  {
   "no": 26,
   "act": "幕三-秋是黄昏",
   "text": "半夜里听见远处有人在敲什么，一下，又一下。",
   "start": 112.65689583333334,
   "end": 116.9919375
  },
  {
   "no": 27,
   "act": "幕三-秋是黄昏",
   "text": "很久不联系的人，忽然捎来一句话。",
   "start": 118.2419375,
   "end": 120.99189583333333
  },
  {
   "no": 28,
   "act": "幕三-秋是黄昏",
   "text": "一件旧衣裳，穿上去还合身。",
   "start": 122.24189583333333,
   "end": 124.70147916666667
  },
  {
   "no": 29,
   "act": "幕三-秋是黄昏",
   "text": "这几条春天那一幕里出现过。",
   "start": 126.30147916666667,
   "end": 128.62272916666666
  },
  {
   "no": 30,
   "act": "幕三-秋是黄昏",
   "text": "她在不同的地方写过同样的事，自己大概也没数过。",
   "start": 129.87272916666666,
   "end": 134.3105
  },
  {
   "no": 31,
   "act": "幕三-秋是黄昏",
   "text": "秋天的月亮她写得多。",
   "start": 135.5605,
   "end": 137.23664583333334
  },
  {
   "no": 32,
   "act": "幕三-秋是黄昏",
   "text": "十五那天的月亮，她说是不用讲的。",
   "start": 138.48664583333334,
   "end": 141.31025
  },
  {
   "no": 33,
   "act": "幕三-秋是黄昏",
   "text": "她更在意的是月亮出来之前的那一会儿：",
   "start": 142.56025,
   "end": 145.79239583333333
  },
  {
   "no": 34,
   "act": "幕三-秋是黄昏",
   "text": "天还不黑，东边已经有一点白，什么都还看不清。",
   "start": 147.04239583333333,
   "end": 151.08708333333334
  },
  {
   "no": 35,
   "act": "幕三-秋是黄昏",
   "text": "这跟她写春天是一回事。",
   "start": 152.68708333333333,
   "end": 154.71358333333333
  },
  {
   "no": 36,
   "act": "幕三-秋是黄昏",
   "text": "春天她挑的是天刚白那一会儿，秋天她挑的是月亮还没出来那一会儿。",
   "start": 155.96358333333333,
   "end": 161.04208333333332
  },
  {
   "no": 37,
   "act": "幕三-秋是黄昏",
   "text": "两次都是「什么都还没开始」的时候。",
   "start": 162.29208333333332,
   "end": 164.87914583333333
  },
  {
   "no": 38,
   "act": "幕三-秋是黄昏",
   "text": "秋天的风她写了两次。",
   "start": 166.12914583333333,
   "end": 167.9681875
  },
  {
   "no": 39,
   "act": "幕三-秋是黄昏",
   "text": "一次是台风过后。院子里的树倒了几棵，篱笆歪了。",
   "start": 169.2181875,
   "end": 173.88814583333334
  },
  {
   "no": 40,
   "act": "幕三-秋是黄昏",
   "text": "她说，第二天早上有人来收拾，一整天都在响。",
   "start": 175.13814583333334,
   "end": 179.187375
  },
  {
   "no": 41,
   "act": "幕三-秋是黄昏",
   "text": "另一次是很平常的风。",
   "start": 180.787375,
   "end": 182.61733333333333
  },
  {
   "no": 42,
   "act": "幕三-秋是黄昏",
   "text": "她说，秋天的风夜里吹得最好，因为屋里已经开始冷了，但还不用关窗。",
   "start": 183.86733333333333,
   "end": 189.95039583333335
  },
  {
   "no": 43,
   "act": "幕三-秋是黄昏",
   "text": "关了窗就听不见。不关又有点凉。",
   "start": 191.20039583333335,
   "end": 194.3341875
  },
  {
   "no": 44,
   "act": "幕三-秋是黄昏",
   "text": "她说，就是那点凉刚刚好。",
   "start": 195.5841875,
   "end": 197.85633333333334
  },
  {
   "no": 45,
   "act": "幕三-秋是黄昏",
   "text": "「让人不痛快的事」里她也添了秋天的。",
   "start": 199.10633333333334,
   "end": 201.93445833333334
  },
  {
   "no": 46,
   "act": "幕三-秋是黄昏",
   "text": "好不容易睡着，被外面的响声吵醒。",
   "start": 203.18445833333334,
   "end": 206.1555
  },
  {
   "no": 47,
   "act": "幕三-秋是黄昏",
   "text": "说好来看你的人，天黑了还没来。",
   "start": 207.4055,
   "end": 210.01710416666666
  },
  {
   "no": 48,
   "act": "幕三-秋是黄昏",
   "text": "想起一件事要做，站起来走了两步，又忘了是什么事。",
   "start": 211.26710416666666,
   "end": 215.48835416666665
  },
  {
   "no": 49,
   "act": "幕三-秋是黄昏",
   "text": "最后这一条她写得很短。",
   "start": 217.08835416666668,
   "end": 219.3605
  },
  {
   "no": 50,
   "act": "幕三-秋是黄昏",
   "text": "她没有说自己后来想起来没有。",
   "start": 220.6105,
   "end": 223.12829166666666
  },
  {
   "no": 51,
   "act": "幕三-秋是黄昏",
   "text": "她写过一份单子，叫「让人心里跳一下的事」。",
   "start": 224.37829166666666,
   "end": 227.6304375
  },
  {
   "no": 52,
   "act": "幕三-秋是黄昏",
   "text": "养着的雀儿，忽然听见外面有老雀的声音。",
   "start": 228.8804375,
   "end": 232.41839583333334
  },
  {
   "no": 53,
   "act": "幕三-秋是黄昏",
   "text": "好香的熏香，昨天点过，今天进屋还闻得到。",
   "start": 233.66839583333334,
   "end": 237.45654166666668
  },
  {
   "no": 54,
   "act": "幕三-秋是黄昏",
   "text": "这一条她写得最长：",
   "start": 238.70654166666668,
   "end": 240.47179166666666
  },
  {
   "no": 55,
   "act": "幕三-秋是黄昏",
   "text": "洗了头，梳好，换上熏过香的衣裳，坐下来。",
   "start": 241.72179166666666,
   "end": 245.65283333333332
  },
  {
   "no": 56,
   "act": "幕三-秋是黄昏",
   "text": "那天没有人来，也不打算出门，谁也看不见。",
   "start": 246.90283333333332,
   "end": 250.54352083333333
  },
  {
   "no": 57,
   "act": "幕三-秋是黄昏",
   "text": "她说，就算这样，心里还是不一样。",
   "start": 251.79352083333333,
   "end": 254.8045625
  },
  {
   "no": 58,
   "act": "幕三-秋是黄昏",
   "text": "一千年前的人也会这样。",
   "start": 256.4045625,
   "end": 258.4601666666667
  },
  {
   "no": 59,
   "act": "幕三-秋是黄昏",
   "text": "没人看见，也要把自己收拾干净。",
   "start": 259.7101666666667,
   "end": 262.500125
  },
  {
   "no": 60,
   "act": "幕三-秋是黄昏",
   "text": "她还写过一份，叫「想起从前的事」。",
   "start": 263.750125,
   "end": 266.5737291666667
  },
  {
   "no": 61,
   "act": "幕三-秋是黄昏",
   "text": "去年的扇子，今年翻出来。",
   "start": 267.8237291666667,
   "end": 270.0713333333333
  },
  {
   "no": 62,
   "act": "幕三-秋是黄昏",
   "text": "小时候玩的那套小家具，收在箱子底下。",
   "start": 271.3213333333333,
   "end": 274.74547916666666
  },
  {
   "no": 63,
   "act": "幕三-秋是黄昏",
   "text": "一片干掉的叶子，夹在旧本子里，忘了是什么时候夹的。",
   "start": 275.99547916666666,
   "end": 280.763625
  },
  {
   "no": 64,
   "act": "幕三-秋是黄昏",
   "text": "这几条她也没有往下说。",
   "start": 282.363625,
   "end": 284.41922916666664
  },
  {
   "no": 65,
   "act": "幕三-秋是黄昏",
   "text": "她只写「看见了」，不写「然后想起了谁」。",
   "start": 285.66922916666664,
   "end": 288.591
  },
  {
   "no": 66,
   "act": "幕三-秋是黄昏",
   "text": "秋天她写虫写得最多。",
   "start": 289.841,
   "end": 291.72914583333335
  },
  {
   "no": 67,
   "act": "幕三-秋是黄昏",
   "text": "一种叫得急，一种叫得慢，还有一种像是在织布，一声一声很规矩。",
   "start": 292.97914583333335,
   "end": 298.6736666666667
  },
  {
   "no": 68,
   "act": "幕三-秋是黄昏",
   "text": "她说，这三种夜里会一起响，但你要是仔细听，还是分得开。",
   "start": 299.9236666666667,
   "end": 305.16945833333335
  },
  {
   "no": 69,
   "act": "幕三-秋是黄昏",
   "text": "她说，分开听是一件很花工夫的事，可秋天的夜很长。",
   "start": 306.7694583333333,
   "end": 311.5330625
  },
  {
   "no": 70,
   "act": "幕三-秋是黄昏",
   "text": "八月里有相扑。宫里的人都去看。",
   "start": 312.7830625,
   "end": 315.89229166666667
  },
  {
   "no": 71,
   "act": "幕三-秋是黄昏",
   "text": "她写了看的人，没怎么写比的人。",
   "start": 317.14229166666667,
   "end": 319.6264375
  },
  {
   "no": 72,
   "act": "幕三-秋是黄昏",
   "text": "她说，看的人里有几个特别起劲，喊得比场上还响。",
   "start": 320.8764375,
   "end": 325.093125
  },
  {
   "no": 73,
   "act": "幕三-秋是黄昏",
   "text": "散场以后那几个人嗓子都哑了，还在说刚才那一下。",
   "start": 326.343125,
   "end": 330.461625
  },
  {
   "no": 74,
   "act": "幕三-秋是黄昏",
   "text": "她把这一段写完就停了。",
   "start": 332.061625,
   "end": 333.87614583333334
  },
  {
   "no": 75,
   "act": "幕三-秋是黄昏",
   "text": "她没有写谁赢了。",
   "start": 335.12614583333334,
   "end": 336.38920833333333
  },
  {
   "no": 76,
   "act": "幕三-秋是黄昏",
   "text": "秋天的琴她提过一次。",
   "start": 337.63920833333333,
   "end": 339.3798958333333
  },
  {
   "no": 77,
   "act": "幕三-秋是黄昏",
   "text": "她说，天冷下来以后，弦的声音跟夏天不一样。",
   "start": 340.6298958333333,
   "end": 344.51166666666666
  },
  {
   "no": 78,
   "act": "幕三-秋是黄昏",
   "text": "夏天松，秋天紧。",
   "start": 345.76166666666666,
   "end": 347.5314583333333
  },
  {
   "no": 79,
   "act": "幕三-秋是黄昏",
   "text": "同一张琴，同一个人弹，听着不是一回事。",
   "start": 348.7814583333333,
   "end": 352.3930625
  },
  {
   "no": 80,
   "act": "幕三-秋是黄昏",
   "text": "九月初九那天有个讲究。",
   "start": 353.6430625,
   "end": 355.7522916666667
  },
  {
   "no": 81,
   "act": "幕三-秋是黄昏",
   "text": "前一天夜里，人们把丝绵盖在菊花上。",
   "start": 357.0022916666667,
   "end": 360.4064375
  },
  {
   "no": 82,
   "act": "幕三-秋是黄昏",
   "text": "第二天早上丝绵吸饱了露水，拿来擦脸。",
   "start": 361.6564375,
   "end": 365.1789375
  },
  {
   "no": 83,
   "act": "幕三-秋是黄昏",
   "text": "据说这样能不老。",
   "start": 366.4289375,
   "end": 367.745625
  },
  {
   "no": 84,
   "act": "幕三-秋是黄昏",
   "text": "她说，那天早上院子里的人都在擦脸。",
   "start": 369.345625,
   "end": 372.504125
  },
  {
   "no": 85,
   "act": "幕三-秋是黄昏",
   "text": "擦完了照样该老还是老。",
   "start": 373.754125,
   "end": 375.8633541666667
  },
  {
   "no": 86,
   "act": "幕三-秋是黄昏",
   "text": "她把这句写下来，也没有笑话谁。",
   "start": 377.1133541666667,
   "end": 379.74041666666665
  },
  {
   "no": 87,
   "act": "幕三-秋是黄昏",
   "text": "一千年前的人也想不老。",
   "start": 380.99041666666665,
   "end": 383.0214583333333
  },
  {
   "no": 88,
   "act": "幕三-秋是黄昏",
   "text": "红叶她写得比花少。",
   "start": 384.62145833333335,
   "end": 386.1639583333333
  },
  {
   "no": 89,
   "act": "幕三-秋是黄昏",
   "text": "她说，一整座山红了，反而不如一枝红得早的好看。",
   "start": 387.4139583333333,
   "end": 391.63064583333335
  },
  {
   "no": 90,
   "act": "幕三-秋是黄昏",
   "text": "跟她写樱花是一个道理：她要的是一处，不是一片。",
   "start": 392.88064583333335,
   "end": 397.0191458333333
  },
  {
   "no": 91,
   "act": "幕三-秋是黄昏",
   "text": "她还写过一份，叫「配不上的东西」。",
   "start": 398.61914583333333,
   "end": 401.2262083333333
  },
  {
   "no": 92,
   "act": "幕三-秋是黄昏",
   "text": "难看的字写在好纸上。",
   "start": 402.4762083333333,
   "end": 404.55635416666667
  },
  {
   "no": 93,
   "act": "幕三-秋是黄昏",
   "text": "老人家穿得太花。",
   "start": 405.80635416666667,
   "end": 407.3305
  },
  {
   "no": 94,
   "act": "幕三-秋是黄昏",
   "text": "雨天里打扮得特别齐整的人，一脚踩进水里。",
   "start": 408.5805,
   "end": 412.3595625
  },
  {
   "no": 95,
   "act": "幕三-秋是黄昏",
   "text": "这几条她写得刻薄。",
   "start": 413.9595625,
   "end": 415.53279166666664
  },
  {
   "no": 96,
   "act": "幕三-秋是黄昏",
   "text": "她自己也知道刻薄，所以后面接了一句：这些都是不该说的话。",
   "start": 416.78279166666664,
   "end": 422.15147916666666
  },
  {
   "no": 97,
   "act": "幕三-秋是黄昏",
   "text": "说完还是写下来了。",
   "start": 423.40147916666666,
   "end": 424.9794375
  },
  {
   "no": 98,
   "act": "幕三-秋是黄昏",
   "text": "秋天的夜她写过一次睡不着。",
   "start": 426.5794375,
   "end": 429.01902083333334
  },
  {
   "no": 99,
   "act": "幕三-秋是黄昏",
   "text": "那天夜里虫叫得特别响，她起来把窗子推开一条缝。",
   "start": 430.26902083333334,
   "end": 434.9142708333333
  },
  {
   "no": 100,
   "act": "幕三-秋是黄昏",
   "text": "外面月亮很好，什么人也没有。",
   "start": 436.1642708333333,
   "end": 438.55477083333335
  },
  {
   "no": 101,
   "act": "幕三-秋是黄昏",
   "text": "她说，那种时候会觉得，这么好的夜里居然只有自己醒着。",
   "start": 439.80477083333335,
   "end": 444.97710416666666
  },
  {
   "no": 102,
   "act": "幕三-秋是黄昏",
   "text": "她写完这句就停了。",
   "start": 446.5771041666667,
   "end": 448.1057916666667
  },
  {
   "no": 103,
   "act": "幕三-秋是黄昏",
   "text": "她没有说这是高兴的事还是不高兴的事。",
   "start": 449.3557916666667,
   "end": 452.775375
  },
  {
   "no": 104,
   "act": "幕三-秋是黄昏",
   "text": "秋天深下去，天黑得越来越早。",
   "start": 454.375375,
   "end": 457.00697916666667
  },
  {
   "no": 105,
   "act": "幕三-秋是黄昏",
   "text": "她说，这个时候在宫里当差，下了值出来天已经全黑了。",
   "start": 458.25697916666667,
   "end": 463.1925625
  },
  {
   "no": 106,
   "act": "幕三-秋是黄昏",
   "text": "路上要有人打灯。",
   "start": 464.4425625,
   "end": 465.8237916666667
  },
  {
   "no": 107,
   "act": "幕三-秋是黄昏",
   "text": "灯一晃，路两边的草影子跟着晃。",
   "start": 467.0737916666667,
   "end": 469.8283125
  },
  {
   "no": 108,
   "act": "幕三-秋是黄昏",
   "text": "她写这些的时候，宫里的日子还算安稳。",
   "start": 471.4283125,
   "end": 474.68502083333334
  },
  {
   "no": 109,
   "act": "幕三-秋是黄昏",
   "text": "再往后几年就不是了。",
   "start": 475.93502083333334,
   "end": 477.55297916666666
  },
  {
   "no": 110,
   "act": "幕三-秋是黄昏",
   "text": "那些她后来一句也没写。",
   "start": 478.80297916666666,
   "end": 480.62202083333335
  },
  {
   "no": 111,
   "act": "幕三-秋是黄昏",
   "text": "她只写到这儿：秋天最好的还是黄昏。",
   "start": 481.87202083333335,
   "end": 485.119625
  },
  {
   "no": 112,
   "act": "幕三-秋是黄昏",
   "text": "太阳落下去，风起来，虫子叫起来。",
   "start": 486.369625,
   "end": 489.3806666666667
  },
  {
   "no": 113,
   "act": "幕三-秋是黄昏",
   "text": "那时候还没到要点灯的时候。",
   "start": 490.6306666666667,
   "end": 492.996625
  },
  {
   "no": 114,
   "act": "幕四-冬是清早",
   "text": "冬天最好的是清早。",
   "start": 495.196625,
   "end": 496.819125
  },
  {
   "no": 115,
   "act": "幕四-冬是清早",
   "text": "下了雪，不用说。",
   "start": 498.069125,
   "end": 499.62691666666666
  },
  {
   "no": 116,
   "act": "幕四-冬是清早",
   "text": "结了霜，白花花的一层，也好。",
   "start": 500.87691666666666,
   "end": 503.60670833333336
  },
  {
   "no": 117,
   "act": "幕四-冬是清早",
   "text": "就算什么都没有，只是特别冷的早上，赶紧把炭生起来，端着火盆穿过廊下——那样子也是冬天该有的。",
   "start": 504.85670833333336,
   "end": 513.6077708333333
  },
  {
   "no": 118,
   "act": "幕四-冬是清早",
   "text": "她写完这一句就添了一笔：",
   "start": 514.8577708333333,
   "end": 516.987
  },
  {
   "no": 119,
   "act": "幕四-冬是清早",
   "text": "到了中午，天暖起来，火盆里的炭就剩下一堆白灰，看着不像话了。",
   "start": 518.237,
   "end": 524.1080416666666
  },
  {
   "no": 120,
   "act": "幕四-冬是清早",
   "text": "她写冬天写得比别的季节实在。",
   "start": 525.7080416666666,
   "end": 528.3687291666666
  },
  {
   "no": 121,
   "act": "幕四-冬是清早",
   "text": "春天她写光，夏天她写声音，秋天她写黄昏。",
   "start": 529.6187291666666,
   "end": 533.5452291666667
  },
  {
   "no": 122,
   "act": "幕四-冬是清早",
   "text": "写到冬天，她写的是炭、是火盆、是手冷。",
   "start": 534.7952291666667,
   "end": 538.8691875
  },
  {
   "no": 123,
   "act": "幕四-冬是清早",
   "text": "雪下大的那天，宫里的人都不出门。",
   "start": 540.1191875,
   "end": 543.0811458333334
  },
  {
   "no": 124,
   "act": "幕四-冬是清早",
   "text": "她说，那天大家把帘子放下来，围着火盆坐着，说些没要紧的话。",
   "start": 544.3311458333334,
   "end": 549.916375
  },
  {
   "no": 125,
   "act": "幕四-冬是清早",
   "text": "有人烤橘子。有人写字，写两笔就把手拢到火上。",
   "start": 551.166375,
   "end": 556.1310625
  },
  {
   "no": 126,
   "act": "幕四-冬是清早",
   "text": "有一天雪下得特别厚。",
   "start": 557.7310625,
   "end": 559.6482916666666
  },
  {
   "no": 127,
   "act": "幕四-冬是清早",
   "text": "主子问了一句：外面的雪，该怎么看。",
   "start": 560.8982916666666,
   "end": 563.8847916666666
  },
  {
   "no": 128,
   "act": "幕四-冬是清早",
   "text": "她没有答话，走过去把帘子卷了起来。",
   "start": 565.1347916666666,
   "end": 568.2485833333334
  },
  {
   "no": 129,
   "act": "幕四-冬是清早",
   "text": "主子笑了。",
   "start": 569.4985833333334,
   "end": 570.36925
  },
  {
   "no": 130,
   "act": "幕四-冬是清早",
   "text": "这件事她记了下来，写得很得意。",
   "start": 571.61925,
   "end": 574.3490416666667
  },
  {
   "no": 131,
   "act": "幕四-冬是清早",
   "text": "那是她全书里少有的、写自己被称赞的地方。",
   "start": 575.5990416666667,
   "end": 579.309
  },
  {
   "no": 132,
   "act": "幕四-冬是清早",
   "text": "写完她也没多说，下一条就换了别的事。",
   "start": 580.559,
   "end": 583.84025
  },
  {
   "no": 133,
   "act": "幕四-冬是清早",
   "text": "冬天她写了一份「让人扫兴的事」。",
   "start": 585.44025,
   "end": 587.8262083333333
  },
  {
   "no": 134,
   "act": "幕四-冬是清早",
   "text": "冬天的时候看到夏天用的扇子。",
   "start": 589.0762083333333,
   "end": 591.6741666666667
  },
  {
   "no": 135,
   "act": "幕四-冬是清早",
   "text": "一个人特意去看的地方，去了才发现关着门。",
   "start": 592.9241666666667,
   "end": 596.654125
  },
  {
   "no": 136,
   "act": "幕四-冬是清早",
   "text": "炭火生了半天，屋子还是冷的。",
   "start": 597.904125,
   "end": 600.506625
  },
  {
   "no": 137,
   "act": "幕四-冬是清早",
   "text": "这三条她排在一起，也是写完就停。",
   "start": 601.756625,
   "end": 604.763125
  },
  {
   "no": 138,
   "act": "幕四-冬是清早",
   "text": "一千年过去，这几件事还是扫兴。",
   "start": 606.013125,
   "end": 608.9950833333334
  },
  {
   "no": 139,
   "act": "幕四-冬是清早",
   "text": "「让人高兴的事」里她也写了冬天的。",
   "start": 610.5950833333334,
   "end": 613.2266875
  },
  {
   "no": 140,
   "act": "幕四-冬是清早",
   "text": "冷了很久的屋子，忽然暖起来。",
   "start": 614.4766875,
   "end": 616.965375
  },
  {
   "no": 141,
   "act": "幕四-冬是清早",
   "text": "要出门的早上，一推门，外面下了雪。",
   "start": 618.215375,
   "end": 621.4275208333333
  },
  {
   "no": 142,
   "act": "幕四-冬是清早",
   "text": "冻了一夜的手，摸到热水。",
   "start": 622.6775208333333,
   "end": 624.905125
  },
  {
   "no": 143,
   "act": "幕四-冬是清早",
   "text": "她把冷和暖排在一起写。",
   "start": 626.155125,
   "end": 628.2152708333333
  },
  {
   "no": 144,
   "act": "幕四-冬是清早",
   "text": "先写冷，再写暖，中间不加一个字。",
   "start": 629.4652708333333,
   "end": 632.7265208333333
  },
  {
   "no": 145,
   "act": "幕四-冬是清早",
   "text": "冬天夜长。她说夜长有夜长的好处。",
   "start": 633.9765208333333,
   "end": 637.7846666666667
  },
  {
   "no": 146,
   "act": "幕四-冬是清早",
   "text": "睡不着的时候可以听外面。",
   "start": 639.0346666666667,
   "end": 641.2868125
  },
  {
   "no": 147,
   "act": "幕四-冬是清早",
   "text": "风大的夜里，屋顶上有响声，听着像有人在上面走。",
   "start": 642.5368125,
   "end": 646.7873333333333
  },
  {
   "no": 148,
   "act": "幕四-冬是清早",
   "text": "她说她知道没有人在上面走。",
   "start": 648.0373333333333,
   "end": 650.5952916666666
  },
  {
   "no": 149,
   "act": "幕四-冬是清早",
   "text": "雪停以后的月亮她写过一次。",
   "start": 652.1952916666667,
   "end": 654.6394375
  },
  {
   "no": 150,
   "act": "幕四-冬是清早",
   "text": "那天夜里雪停了，月亮出来，院子里白得不像话。",
   "start": 655.8894375,
   "end": 659.8895833333333
  },
  {
   "no": 151,
   "act": "幕四-冬是清早",
   "text": "她说，那种时候不该睡，可是又冷得待不住。",
   "start": 661.1395833333333,
   "end": 664.9231875
  },
  {
   "no": 152,
   "act": "幕四-冬是清早",
   "text": "她就在门口站了一会儿，然后进屋了。",
   "start": 666.1731875,
   "end": 668.9231458333334
  },
  {
   "no": 153,
   "act": "幕四-冬是清早",
   "text": "这几乎是她全书里唯一一次写自己「舍不得走」。",
   "start": 670.1731458333334,
   "end": 674.2469375
  },
  {
   "no": 154,
   "act": "幕四-冬是清早",
   "text": "写完照样不解释。",
   "start": 675.4969375,
   "end": 677.0101666666667
  },
  {
   "no": 155,
   "act": "幕四-冬是清早",
   "text": "年底那几天，宫里忙起来。",
   "start": 678.6101666666667,
   "end": 680.824125
  },
  {
   "no": 156,
   "act": "幕四-冬是清早",
   "text": "要扫除，要备年货，要把该收的东西收起来。",
   "start": 682.074125,
   "end": 685.7640833333334
  },
  {
   "no": 157,
   "act": "幕四-冬是清早",
   "text": "她说，这些天最没意思，可是不做又不行。",
   "start": 687.0140833333334,
   "end": 690.7193333333333
  },
  {
   "no": 158,
   "act": "幕四-冬是清早",
   "text": "她还写了一条：年前把该还的东西还掉，是「让人松一口气的事」。",
   "start": 691.9693333333333,
   "end": 697.0923958333333
  },
  {
   "no": 159,
   "act": "幕四-冬是清早",
   "text": "一千年前的人也拖着不还东西。",
   "start": 698.3423958333333,
   "end": 700.9985416666667
  },
  {
   "no": 160,
   "act": "幕四-冬是清早",
   "text": "有一年冬天雪下得很大，宫里的人在院子里堆了一座雪山。",
   "start": 702.5985416666666,
   "end": 707.6816041666667
  },
  {
   "no": 161,
   "act": "幕四-冬是清早",
   "text": "堆得很高，围着看的人都说好。",
   "start": 708.9316041666667,
   "end": 711.4202916666667
  },
  {
   "no": 162,
   "act": "幕四-冬是清早",
   "text": "有人问，这座山能撑到几时。",
   "start": 712.6702916666667,
   "end": 715.5184166666667
  },
  {
   "no": 163,
   "act": "幕四-冬是清早",
   "text": "有的说撑不到年底，有的说撑到年底就化了。",
   "start": 716.7684166666667,
   "end": 720.3845625
  },
  {
   "no": 164,
   "act": "幕四-冬是清早",
   "text": "她说，她赌它能撑到正月十五。",
   "start": 721.6345625,
   "end": 724.2861666666666
  },
  {
   "no": 165,
   "act": "幕四-冬是清早",
   "text": "别人都说不可能。",
   "start": 725.5361666666666,
   "end": 726.8928541666667
  },
  {
   "no": 166,
   "act": "幕四-冬是清早",
   "text": "那些天她每天去看。",
   "start": 728.4928541666667,
   "end": 730.0460833333333
  },
  {
   "no": 167,
   "act": "幕四-冬是清早",
   "text": "雪山一天矮一点，边上化出黑色的土。",
   "start": 731.2960833333333,
   "end": 734.6020416666667
  },
  {
   "no": 168,
   "act": "幕四-冬是清早",
   "text": "她让人扫掉落在上面的脏东西，又让人往上面补雪。",
   "start": 735.8520416666667,
   "end": 740.1380208333334
  },
  {
   "no": 169,
   "act": "幕四-冬是清早",
   "text": "到了正月十四，那座山还在。",
   "start": 741.3880208333334,
   "end": 743.8521666666667
  },
  {
   "no": 170,
   "act": "幕四-冬是清早",
   "text": "她说，那天她心里挺得意，就等着第二天。",
   "start": 745.1021666666667,
   "end": 748.6846666666667
  },
  {
   "no": 171,
   "act": "幕四-冬是清早",
   "text": "十五那天早上她出去看，山没了。",
   "start": 749.9346666666667,
   "end": 753.0038958333333
  },
  {
   "no": 172,
   "act": "幕四-冬是清早",
   "text": "后来她才知道，是主子叫人夜里搬走的。",
   "start": 754.6038958333334,
   "end": 757.9634791666666
  },
  {
   "no": 173,
   "act": "幕四-冬是清早",
   "text": "主子说，是想看看她第二天的样子。",
   "start": 759.2134791666666,
   "end": 761.9834375
  },
  {
   "no": 174,
   "act": "幕四-冬是清早",
   "text": "她把这件事从头到尾写了下来，写得比别的段落都长。",
   "start": 763.2334375,
   "end": 767.7895833333333
  },
  {
   "no": 175,
   "act": "幕四-冬是清早",
   "text": "她写自己每天去看，写自己让人补雪，写自己白等了一场。",
   "start": 769.0395833333333,
   "end": 773.910625
  },
  {
   "no": 176,
   "act": "幕四-冬是清早",
   "text": "写完她没有说自己气不气。",
   "start": 775.160625,
   "end": 777.4373333333333
  },
  {
   "no": 177,
   "act": "幕四-冬是清早",
   "text": "她还写过一份单子，叫「很少见的事」。",
   "start": 779.0373333333333,
   "end": 781.9591041666666
  },
  {
   "no": 178,
   "act": "幕四-冬是清早",
   "text": "被岳父夸的女婿。",
   "start": 783.2091041666666,
   "end": 784.6441458333334
  },
  {
   "no": 179,
   "act": "幕四-冬是清早",
   "text": "不说别人坏话的人。",
   "start": 785.8941458333334,
   "end": 787.4228333333333
  },
  {
   "no": 180,
   "act": "幕四-冬是清早",
   "text": "一把好用的镊子。",
   "start": 788.6728333333333,
   "end": 790.0340625
  },
  {
   "no": 181,
   "act": "幕四-冬是清早",
   "text": "这三条排在一起，她也没有解释为什么把它们放在一块儿。",
   "start": 791.2840625,
   "end": 795.6682083333334
  },
  {
   "no": 182,
   "act": "幕四-冬是清早",
   "text": "一千年过去，好用的镊子还是不多。",
   "start": 796.9182083333334,
   "end": 799.7908958333334
  },
  {
   "no": 183,
   "act": "幕四-冬是清早",
   "text": "腊月里有一夜要念佛，从天黑念到天亮。",
   "start": 801.0408958333334,
   "end": 804.5588541666667
  },
  {
   "no": 184,
   "act": "幕四-冬是清早",
   "text": "她说，那一夜特别冷。",
   "start": 805.8088541666667,
   "end": 807.697
  },
  {
   "no": 185,
   "act": "幕四-冬是清早",
   "text": "念着念着有人打盹，被旁边的人推醒，接着念。",
   "start": 808.947,
   "end": 813.3065833333334
  },
  {
   "no": 186,
   "act": "幕四-冬是清早",
   "text": "天快亮的时候声音就散了，有人已经站不住。",
   "start": 814.5565833333334,
   "end": 818.3111041666667
  },
  {
   "no": 187,
   "act": "幕四-冬是清早",
   "text": "她说，那一夜她也困，但没有睡。",
   "start": 819.9111041666666,
   "end": 822.8530625
  },
  {
   "no": 188,
   "act": "幕四-冬是清早",
   "text": "至于为什么没睡，她没写。",
   "start": 824.1030625,
   "end": 826.306125
  },
  {
   "no": 189,
   "act": "幕四-冬是清早",
   "text": "年三十夜里要赶鬼。",
   "start": 827.906125,
   "end": 829.5531875
  },
  {
   "no": 190,
   "act": "幕四-冬是清早",
   "text": "大人小孩一起在院子里跑，敲东西，喊。",
   "start": 830.8031875,
   "end": 834.4147916666667
  },
  {
   "no": 191,
   "act": "幕四-冬是清早",
   "text": "她说，那天晚上最吵，可是过完了就安静了。",
   "start": 835.6647916666667,
   "end": 839.3993125
  },
  {
   "no": 192,
   "act": "幕四-冬是清早",
   "text": "安静下来的时候，一年就算完了。",
   "start": 840.6493125,
   "end": 843.2072708333334
  },
  {
   "no": 193,
   "act": "幕四-冬是清早",
   "text": "她还写过一份，叫「在这个人面前不好意思的事」。",
   "start": 844.4572708333334,
   "end": 848.2363333333333
  },
  {
   "no": 194,
   "act": "幕四-冬是清早",
   "text": "字写得好的人看你写字。",
   "start": 849.4863333333333,
   "end": 851.640125
  },
  {
   "no": 195,
   "act": "幕四-冬是清早",
   "text": "会做菜的人吃你做的东西。",
   "start": 852.890125,
   "end": 855.1958958333333
  },
  {
   "no": 196,
   "act": "幕四-冬是清早",
   "text": "她说，这种时候手会不听使唤，越想写好越写不好。",
   "start": 856.7958958333334,
   "end": 861.4456875
  },
  {
   "no": 197,
   "act": "幕四-冬是清早",
   "text": "她写这两条的时候没有替自己找台阶。",
   "start": 862.6956875,
   "end": 865.6821875
  },
  {
   "no": 198,
   "act": "幕四-冬是清早",
   "text": "正月要用的东西，腊月里就得备。",
   "start": 867.2821875,
   "end": 870.0074375
  },
  {
   "no": 199,
   "act": "幕四-冬是清早",
   "text": "新的衣裳，新的碗，新的席子。",
   "start": 871.2574375,
   "end": 874.0319583333334
  },
  {
   "no": 200,
   "act": "幕四-冬是清早",
   "text": "她说，把旧的收起来、新的摆出来那一天，屋子看着都不一样了。",
   "start": 875.2819583333334,
   "end": 880.5524791666667
  },
  {
   "no": 201,
   "act": "幕四-冬是清早",
   "text": "她说，其实什么也没多，只是换了个位置。",
   "start": 881.8024791666667,
   "end": 885.246625
  },
  {
   "no": 202,
   "act": "幕四-冬是清早",
   "text": "冬天的火盆她写过好几次。",
   "start": 886.846625,
   "end": 889.1387708333333
  },
  {
   "no": 203,
   "act": "幕四-冬是清早",
   "text": "炭要好，烧起来没有烟。",
   "start": 890.3887708333333,
   "end": 892.464375
  },
  {
   "no": 204,
   "act": "幕四-冬是清早",
   "text": "火盆要大小合手，端得动。",
   "start": 893.714375,
   "end": 895.975625
  },
  {
   "no": 205,
   "act": "幕四-冬是清早",
   "text": "她说，冷天里最好的事，是把手伸到火上，什么也不想。",
   "start": 897.225625,
   "end": 901.9983333333333
  },
  {
   "no": 206,
   "act": "幕四-冬是清早",
   "text": "她写这一句用的字很少。",
   "start": 903.2483333333333,
   "end": 905.2302916666666
  },
  {
   "no": 207,
   "act": "幕四-冬是清早",
   "text": "她写别的都有个来龙去脉，写烤火只有这一句。",
   "start": 906.4802916666666,
   "end": 910.4067916666667
  },
  {
   "no": 208,
   "act": "幕四-冬是清早",
   "text": "全书里她说过一句很正的话。",
   "start": 912.0067916666667,
   "end": 914.466375
  },
  {
   "no": 209,
   "act": "幕四-冬是清早",
   "text": "她说，人身上最要紧的，是心里有别人。",
   "start": 915.716375,
   "end": 919.1850625
  },
  {
   "no": 210,
   "act": "幕四-冬是清早",
   "text": "一句随口的问候，过后未必记得，可是听见的人会记很久。",
   "start": 920.4350625,
   "end": 925.39975
  },
  {
   "no": 211,
   "act": "幕四-冬是清早",
   "text": "这是她少有的一次直接下判断。",
   "start": 926.99975,
   "end": 929.6558958333334
  },
  {
   "no": 212,
   "act": "幕四-冬是清早",
   "text": "写完她就换了下一条，写的是一件很小的事。",
   "start": 930.9058958333334,
   "end": 934.6649583333333
  },
  {
   "no": 213,
   "act": "幕四-冬是清早",
   "text": "她在宫里当差当了十来年。",
   "start": 936.2649583333333,
   "end": 938.5616666666666
  },
  {
   "no": 214,
   "act": "幕四-冬是清早",
   "text": "后来主子没了，宫里的日子散了，她就不写了。",
   "start": 939.8116666666666,
   "end": 943.5998125
  },
  {
   "no": 215,
   "act": "幕四-冬是清早",
   "text": "留下来的是三百来段，长的几百字，短的只有一两行。",
   "start": 944.8498125,
   "end": 949.2830416666667
  },
  {
   "no": 216,
   "act": "幕四-冬是清早",
   "text": "她自己说过一句：这些东西本来是写着自己看的。",
   "start": 950.5330416666667,
   "end": 955.1091875
  },
  {
   "no": 217,
   "act": "幕四-冬是清早",
   "text": "写完了堆在那儿，也没想过给谁。",
   "start": 956.3591875,
   "end": 958.9416875
  },
  {
   "no": 218,
   "act": "幕四-冬是清早",
   "text": "后来不知道怎么就传了出去。",
   "start": 960.1916875,
   "end": 962.4192916666667
  },
  {
   "no": 219,
   "act": "幕四-冬是清早",
   "text": "她写的都是很小的事。",
   "start": 963.6692916666667,
   "end": 965.3654375
  },
  {
   "no": 220,
   "act": "幕四-冬是清早",
   "text": "天亮了看云，节令到了看花，别人来了看别人的衣裳。",
   "start": 966.6154375,
   "end": 970.9259583333334
  },
  {
   "no": 221,
   "act": "幕四-冬是清早",
   "text": "睡不着，蚊子叫，找不着要穿的那件。",
   "start": 972.1759583333334,
   "end": 975.4572083333334
  },
  {
   "no": 222,
   "act": "幕四-冬是清早",
   "text": "这些事她只写事，不写心情。",
   "start": 977.0572083333333,
   "end": 979.9744375
  },
  {
   "no": 223,
   "act": "幕四-冬是清早",
   "text": "心情在事的后面，一千年了，自己还会出来。",
   "start": 981.2244375,
   "end": 985.0325833333334
  },
  {
   "no": 224,
   "act": "幕四-冬是清早",
   "text": "四个季节她各挑了一个时候。",
   "start": 986.2825833333334,
   "end": 988.5638333333334
  },
  {
   "no": 225,
   "act": "幕四-冬是清早",
   "text": "夏天挑夜里，秋天挑黄昏，冬天挑清早。",
   "start": 989.8138333333334,
   "end": 993.5328958333333
  },
  {
   "no": 226,
   "act": "幕四-冬是清早",
   "text": "春天最好的是拂晓。",
   "start": 994.7828958333333,
   "end": 996.4590416666666
  },
  {
   "no": 227,
   "act": "幕四-冬是清早",
   "text": "天一点点白起来，山的边缘先亮，紫色的云细细地横着。",
   "start": 997.7090416666666,
   "end": 1002.50175
  },
  {
   "no": 228,
   "act": "幕四-冬是清早",
   "text": "那一会儿，什么都还没开始。",
   "start": 1003.75175,
   "end": 1005.9055416666666
  }
 ]
}