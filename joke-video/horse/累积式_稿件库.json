  { "no": 27, "set": 3, "title": "家族群", "scene": "rental-living", "weight": "重", "note": "别做成嘲笑长辈。**得罪谁都行，别得罪听众的妈**" },
  { "no": 28, "set": 3, "title": "催", "scene": "home-living", "weight": "重", "beat": "「松了一下，然后又空了一下」之后必须留一拍", "note": "第三辑的重心。整条的分量全在那一拍里，早一秒进下一句就全丢了。**不要排在开头几期**" },
  { "no": 29, "set": 3, "title": "回家吃饭", "scene": "home-living", "weight": "重", "note": "末尾那个动作是全篇的话——画面拍到手和袋子就够，不给脸" },
