    },
    {
      "who": "旁白",
      "beat": "punch",
      "stage": [
        "猫"
      ],
      "text": "身后的灯，一格一格灭了。",
      "delivery": "叙缓",
      "dur": 3.2,
      "audio": "out/voice/page-02-cat/34-旁白.wav"
    },
    {
      "who": "旁白",
      "beat": "punch",
      "stage": [
        "猫"
      ],
      "text": "他走得不快，也没有回头。",
      "delivery": "叙缓",
      "dur": 3.1,
      "audio": "out/voice/page-02-cat/35-旁白.wav"
    },
    {
      "who": "旁白",
      "beat": "punch",
      "stage": [
        "猫"
      ],
      "text": "回到街上，天还亮着。",
      "delivery": "叙缓",
      "dur": 2.71,
      "audio": "out/voice/page-02-cat/36-旁白.wav"
    },
    {
      "who": "旁白",
      "beat": "punch",
      "stage": [
        "猫"
      ],
      "say": [
        {
          "text": "那些人还没下班。",
          "delivery": "叙平"
        },
        {
          "text": "街上很空。",
          "delivery": "叙缓"
        }
      ],
      "dur": 3.522,
      "audio": "out/voice/page-02-cat/37-旁白.wav"
    },
