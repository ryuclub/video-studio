{
 "id": "liaozhai-E03-laoshan",
 "title": "第 3 期《崂山道士》",
 "lines": [
  {
   "no": 1,
   "act": "冷开场",
   "text": "有一个人上山求仙，求了两个多月。",
   "who": "说书人",
   "beat": "扣子"
  },
  {
   "no": 2,
   "act": "冷开场",
   "text": "这两个多月他没学过一句咒，没画过一道符。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 3,
   "act": "冷开场",
   "text": "他只做了一件事：上山砍柴，把柴扛回来。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 4,
   "act": "冷开场",
   "text": "扛了两个多月，手上磨出了茧。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 5,
   "act": "冷开场",
   "text": "临下山那天，师父问他学到了什么。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 6,
   "act": "冷开场",
   "text": "他说，别的我都不要，就要一样。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 7,
   "act": "冷开场",
   "text": "我要能穿墙。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 8,
   "act": "冷开场",
   "text": "后来他确实穿了一次墙。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 9,
   "act": "冷开场",
   "text": "穿过去那一下，一点没费劲。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 10,
   "act": "冷开场",
   "text": "可是那面墙只让他过了一回。第二回，墙就不让了。",
   "who": "说书人",
   "beat": "扣子"
  },
  {
   "no": 11,
   "act": "冷开场",
   "text": "中间隔了没几天。这几天里他什么也没做错，就是回了一趟家。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 12,
   "act": "冷开场",
   "text": "到家第一件事，他就把这个本事拿出来给人看了。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 13,
   "act": "冷开场",
   "text": "今天讲《崂山道士》。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 14,
   "act": "引入",
   "text": "这个人姓王，家里行七，书上就叫他王七。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 15,
   "act": "引入",
   "text": "他家不缺钱。祖上有几分家业，到他这一辈还没败光。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 16,
   "act": "引入",
   "text": "他从小听人讲神仙的事，听一回信一回。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 17,
   "act": "引入",
   "text": "谁家老人说见过狐仙，他要去问；谁家说山上有人不吃饭，他也要去看。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 18,
   "act": "引入",
   "text": "家里人由着他。反正饿不着。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 19,
   "act": "引入",
   "text": "他读过几年书，读不进去。八股文他嫌闷，志怪的册子他能看一整夜。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 20,
   "act": "引入",
   "text": "家里给他说过一门亲，他嫌人家不通仙术，回了。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 21,
   "act": "引入",
   "text": "那年他二十出头，什么也没干成，倒把方圆几十里的神仙传说听了个遍。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 22,
   "act": "引入",
   "text": "后来听说崂山上有仙人，就收拾了东西上山。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 23,
   "act": "引入",
   "text": "临走那天他跟人说，这一趟去，兴许就不回来了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 24,
   "act": "引入",
   "text": "他家里人问他去多久。他说不知道。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 25,
   "act": "引入",
   "text": "崂山在海边上。山不算高，可是石头多，路窄，越往上越难走。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 26,
   "act": "引入",
   "text": "他走一阵歇一阵。带的干粮吃完了，水囊也空了。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 27,
   "act": "引入",
   "text": "天快黑的时候，他在半山腰上看见一片瓦。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 28,
   "act": "引入",
   "text": "王七走了大半天，走到一处道观。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 29,
   "act": "引入",
   "text": "观里很安静。院子扫得干干净净，一根草也没有。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 30,
   "act": "引入",
   "text": "有一个道士坐在蒲团上，头发全白了，看不出多大年纪。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 31,
   "act": "引入",
   "text": "王七上去磕头，说要拜师。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 32,
   "act": "引入",
   "text": "老道士抬眼看了他一下。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 33,
   "act": "引入",
   "text": "恐娇惰不能作苦。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 34,
   "act": "引入",
   "text": "我能。",
   "who": "书生",
   "beat": "提速"
  },
  {
   "no": 35,
   "act": "引入",
   "text": "老道士没有再问。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 36,
   "act": "引入",
   "text": "那一天，王七留下了。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 37,
   "act": "幕一 · 上山",
   "text": "第二天天没亮，观里的人就都起来了。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 38,
   "act": "幕一 · 上山",
   "text": "王七也跟着起。他原本在家里睡到日上三竿，这时候站在院子里，冷得直缩脖子。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 39,
   "act": "幕一 · 上山",
   "text": "道观里没有什么讲经，也没有什么打坐。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 40,
   "act": "幕一 · 上山",
   "text": "老道士递给他一把斧子。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 41,
   "act": "幕一 · 上山",
   "text": "随众采樵。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 42,
   "act": "幕一 · 上山",
   "text": "王七愣了一下。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 43,
   "act": "幕一 · 上山",
   "text": "我是来学道的。",
   "who": "书生",
   "beat": "提速"
  },
  {
   "no": 44,
   "act": "幕一 · 上山",
   "text": "采樵。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 45,
   "act": "幕一 · 上山",
   "text": "王七拿着斧子出去了。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 46,
   "act": "幕一 · 上山",
   "text": "那一天他跟着一群人上后山砍柴。柴要砍够一担，捆好，扛回来。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 47,
   "act": "幕一 · 上山",
   "text": "斧子他不会用。头几下砍在树上，弹回来震得手发麻。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 48,
   "act": "幕一 · 上山",
   "text": "旁边有人看不下去，过来教了他一句：顺着纹路下。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 49,
   "act": "幕一 · 上山",
   "text": "他学着顺纹路下，果然省力。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 50,
   "act": "幕一 · 上山",
   "text": "可是省力也架不住时候长。砍到后来手腕发酸，斧子举起来就往下坠。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 51,
   "act": "幕一 · 上山",
   "text": "他歇一阵砍一阵，别人不歇。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 52,
   "act": "幕一 · 上山",
   "text": "他抬头看别人，那些人不快，可是不停。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 53,
   "act": "幕一 · 上山",
   "text": "到中午他砍够了一半。别人已经在捆了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 54,
   "act": "幕一 · 上山",
   "text": "他蹲下歇了一会儿，手心里全是汗，握不住斧柄。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 55,
   "act": "幕一 · 上山",
   "text": "他抬头看了看天，日头正在头顶上。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 56,
   "act": "幕一 · 上山",
   "text": "山里没有风，汗顺着下巴往下滴，滴在土上，一会儿就干了。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 57,
   "act": "幕一 · 上山",
   "text": "在裤子上擦了擦，接着砍。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 58,
   "act": "幕一 · 上山",
   "text": "上山的时候他还行，下山那一段路，肩上压着柴，脚下是碎石。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 59,
   "act": "幕一 · 上山",
   "text": "他一路上换了七八回肩。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 60,
   "act": "幕一 · 上山",
   "text": "换到后来，两边肩膀都是麻的，分不出哪边更疼。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 61,
   "act": "幕一 · 上山",
   "text": "路上有一段是石头台阶，一级一级往下。他不敢快，脚下打滑一次，柴散了一地。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 62,
   "act": "幕一 · 上山",
   "text": "重新捆的时候，绳子怎么也系不紧。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 63,
   "act": "幕一 · 上山",
   "text": "他蹲在地上弄了半天，天一点一点黑下来。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 64,
   "act": "幕一 · 上山",
   "text": "后面的人一个个从他身边过去，没有人停。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 65,
   "act": "幕一 · 上山",
   "text": "到观里天已经黑了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 66,
   "act": "幕一 · 上山",
   "text": "那天晚上他躺下就着了，什么梦也没做。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 67,
   "act": "幕二 · 砍柴",
   "text": "第二天还是砍柴。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 68,
   "act": "幕二 · 砍柴",
   "text": "第三天还是。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 69,
   "act": "幕二 · 砍柴",
   "text": "一个多月过去，王七的手上磨出了茧。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 70,
   "act": "幕二 · 砍柴",
   "text": "一开始是水泡，泡破了疼，疼过一阵结成硬皮，硬皮再磨，磨成茧。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 71,
   "act": "幕二 · 砍柴",
   "text": "他在家里没干过活。头一回见自己手上长这种东西。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 72,
   "act": "幕二 · 砍柴",
   "text": "第一天回来他手心磨破了两处，晚上疼得睡不着。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 73,
   "act": "幕二 · 砍柴",
   "text": "第二天照旧上山。破的地方碰着斧柄就钻心，他换了个握法，换到别处又磨破。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 74,
   "act": "幕二 · 砍柴",
   "text": "第三天他把布条缠在手上。缠了布使不上劲，柴砍得更慢，回来更晚。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 75,
   "act": "幕二 · 砍柴",
   "text": "第四天他把布拆了。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 76,
   "act": "幕二 · 砍柴",
   "text": "有天晚上他就着灯看自己的手，看了半天。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 77,
   "act": "幕二 · 砍柴",
   "text": "手指头合不拢了。张开的时候关节发僵，要慢慢掰。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 78,
   "act": "幕二 · 砍柴",
   "text": "他想起在家的时候，这双手一天到晚也就翻翻书。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 79,
   "act": "幕二 · 砍柴",
   "text": "那时候他嫌翻书累。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 80,
   "act": "幕二 · 砍柴",
   "text": "他把灯吹了，躺下去，手放在身子两边，没敢攥。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 81,
   "act": "幕二 · 砍柴",
   "text": "到后来他握斧子不疼了。他心里开始不痛快。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 82,
   "act": "幕二 · 砍柴",
   "text": "他上山是来学仙术的，一个多月，一句口诀也没听见。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 83,
   "act": "幕二 · 砍柴",
   "text": "道观里的人各干各的，谁也不跟他说这些。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 84,
   "act": "幕二 · 砍柴",
   "text": "观里一共十几个人。有来了半年的，有来了三年的。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 85,
   "act": "幕二 · 砍柴",
   "text": "王七问过一个来了三年的人，学到了什么。那人说，会砍柴了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 86,
   "act": "幕二 · 砍柴",
   "text": "王七以为他在说笑，那人没笑。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 87,
   "act": "幕二 · 砍柴",
   "text": "他试着问过一次。他问同屋的人，师父什么时候教东西。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 88,
   "act": "幕二 · 砍柴",
   "text": "那人说，师父教你了。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 89,
   "act": "幕二 · 砍柴",
   "text": "王七说，教什么了。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 90,
   "act": "幕二 · 砍柴",
   "text": "那人不再答话，转身去挑水了。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 91,
   "act": "幕二 · 砍柴",
   "text": "老道士早晚都在，见了他也不多话。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 92,
   "act": "幕二 · 砍柴",
   "text": "有一回王七在院子里遇上他，想开口，话到嘴边又咽了回去。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 93,
   "act": "幕二 · 砍柴",
   "text": "有几天夜里，王七躺在铺上想家。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 94,
   "act": "幕二 · 砍柴",
   "text": "他想家里的炭火，想不用天没亮就起来。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 95,
   "act": "幕二 · 砍柴",
   "text": "他动了归意。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 96,
   "act": "幕二 · 砍柴",
   "text": "他想，再等等。再等半个月，要是还这样，就走。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 97,
   "act": "幕二 · 砍柴",
   "text": "这半个月他数着过。今天第几天，明天第几天。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 98,
   "act": "幕二 · 砍柴",
   "text": "数到第三天，他还沉得住。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 99,
   "act": "幕二 · 砍柴",
   "text": "数到第七天，他开始在心里算下山要走多久，走哪条路。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 100,
   "act": "幕二 · 砍柴",
   "text": "数到第十天上，他觉得日子过得特别慢。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 101,
   "act": "幕二 · 砍柴",
   "text": "那几天他干活比谁都利索。他想着反正快走了，最后这几天做得漂亮些。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 102,
   "act": "幕二 · 砍柴",
   "text": "数到第十五天，天照旧没亮就有人叫起。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 103,
   "act": "幕二 · 砍柴",
   "text": "那天早上他躺着没动，听着外面的人一个个出门。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 104,
   "act": "幕二 · 砍柴",
   "text": "等院子里没声了，他才起来，还是拿了斧子出去。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 105,
   "act": "幕二 · 砍柴",
   "text": "那天他砍得特别慢。回来的时候只有他一个人在路上。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 106,
   "act": "幕二 · 砍柴",
   "text": "他一边走一边想，明天就说。想好了怎么开口，也想好了师父要是问他为什么，他怎么答。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 107,
   "act": "幕二 · 砍柴",
   "text": "观里的灯已经点上了。他把柴放下，谁也没跟他说话，也没人问他去哪儿了。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 108,
   "act": "幕二 · 砍柴",
   "text": "晚饭是粥。他捧着碗坐在门槛上，喝完了还想再要，看看别人都没要，就没开口。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 109,
   "act": "幕二 · 砍柴",
   "text": "半个月过去了，还是这样。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 110,
   "act": "幕二 · 砍柴",
   "text": "那天晚上，他打定了主意。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 111,
   "act": "幕二 · 砍柴",
   "text": "明天就跟师父说，我要下山。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 112,
   "act": "幕三 · 剪纸为月",
   "text": "第二天是八月十五。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 113,
   "act": "幕三 · 剪纸为月",
   "text": "那天晚上观里有客人。来了两个人，跟老道士坐在堂上喝酒。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 114,
   "act": "幕三 · 剪纸为月",
   "text": "天已经黑了，堂上没有点灯。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 115,
   "act": "幕三 · 剪纸为月",
   "text": "老道士拿起桌上一张纸，剪成一个圆的，往墙上一贴。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 116,
   "act": "幕三 · 剪纸为月",
   "text": "那张纸就亮了。",
   "who": "说书人",
   "beat": "扣子"
  },
  {
   "no": 117,
   "act": "幕三 · 剪纸为月",
   "text": "先是边上发白，跟着整个圆都白起来，白得像一轮月亮挂在墙上。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 118,
   "act": "幕三 · 剪纸为月",
   "text": "屋子里一下子亮了。亮到地上的砖缝都看得见。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 119,
   "act": "幕三 · 剪纸为月",
   "text": "那光是凉的，不像灯。灯的光是黄的，往上飘；这个光是白的，压得很平。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 120,
   "act": "幕三 · 剪纸为月",
   "text": "照在人身上，影子拖得老长。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 121,
   "act": "幕三 · 剪纸为月",
   "text": "屋里的东西都看得清清楚楚：桌上的杯子、地上的蒲团、墙角堆着的柴。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 122,
   "act": "幕三 · 剪纸为月",
   "text": "就是那堆柴，是他这两个月一担一担扛回来的。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 123,
   "act": "幕三 · 剪纸为月",
   "text": "以前堂上点灯的时候，他从没注意过那堆柴。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 124,
   "act": "幕三 · 剪纸为月",
   "text": "王七站在门口，一句话说不出来。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 125,
   "act": "幕三 · 剪纸为月",
   "text": "老道士回头招呼他，让他也过来坐。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 126,
   "act": "幕三 · 剪纸为月",
   "text": "桌上只有一壶酒。三个人喝，加上王七是四个。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 127,
   "act": "幕三 · 剪纸为月",
   "text": "那壶酒斟了一杯又一杯，斟到十几杯，还是满的。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 128,
   "act": "幕三 · 剪纸为月",
   "text": "王七偷偷看了一眼壶底。壶是薄的，一眼能看到底。里面就那么点酒。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 129,
   "act": "幕三 · 剪纸为月",
   "text": "他数了数杯数。十几杯下去，壶里的酒面一分也没落。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 130,
   "act": "幕三 · 剪纸为月",
   "text": "他伸手把壶掂了掂，还是原来那个分量。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 131,
   "act": "幕三 · 剪纸为月",
   "text": "他又倒了一杯给自己，一口喝下去。是真酒，辣的。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 132,
   "act": "幕三 · 剪纸为月",
   "text": "他把杯子放下，抬头去看老道士。老道士没有看他，正跟客人说话。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 133,
   "act": "幕三 · 剪纸为月",
   "text": "可是斟不完。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 134,
   "act": "幕三 · 剪纸为月",
   "text": "一个客人喝到高兴，说这么好的月亮，光喝酒可惜了。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 135,
   "act": "幕三 · 剪纸为月",
   "text": "老道士听了，从桌上拿起一根筷子，往墙上那轮月亮里一扔。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 136,
   "act": "幕三 · 剪纸为月",
   "text": "筷子进了月亮。",
   "who": "说书人",
   "beat": "扣子"
  },
  {
   "no": 137,
   "act": "幕三 · 剪纸为月",
   "text": "从月亮里走出来一个女子。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 138,
   "act": "幕三 · 剪纸为月",
   "text": "那女子起初只有一尺来高，落到地上，就跟常人一样了。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 139,
   "act": "幕三 · 剪纸为月",
   "text": "她穿的衣裳很长，袖子拖到地上。她在堂中间跳起舞来。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 140,
   "act": "幕三 · 剪纸为月",
   "text": "转的时候袖子甩起来，扫过桌角，杯子一动没动。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 141,
   "act": "幕三 · 剪纸为月",
   "text": "她一边跳一边往堂中间走，走到灯影够不着的地方，人还是亮的。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 142,
   "act": "幕三 · 剪纸为月",
   "text": "王七想伸手去碰。手伸到一半，他停住了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 143,
   "act": "幕三 · 剪纸为月",
   "text": "后来他说，那时候他不是不敢，是忽然觉得这不该碰。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 144,
   "act": "幕三 · 剪纸为月",
   "text": "跳完了，她唱了一支曲子。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 145,
   "act": "幕三 · 剪纸为月",
   "text": "唱的什么王七没记住。他只记得那个声音又清又亮，像是从很高的地方落下来的。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 146,
   "act": "幕三 · 剪纸为月",
   "text": "一曲唱完，那女子一跃，跳上了桌子。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 147,
   "act": "幕三 · 剪纸为月",
   "text": "众人再看，桌上只有一根筷子。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 148,
   "act": "幕三 · 剪纸为月",
   "text": "另一个客人说，今晚太痛快了，只是喝不动了。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 149,
   "act": "幕三 · 剪纸为月",
   "text": "那就到月亮里去喝。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 150,
   "act": "幕三 · 剪纸为月",
   "text": "三个人端起杯子，站起身，往墙上那轮月亮里走。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 151,
   "act": "幕三 · 剪纸为月",
   "text": "王七眼看着他们走进去，坐在月亮里接着喝。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 152,
   "act": "幕三 · 剪纸为月",
   "text": "他站在原地没动。没有人叫他一起进去，他也没有问。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 153,
   "act": "幕三 · 剪纸为月",
   "text": "那三个人在月亮里说话，说的什么听不见，只看见嘴在动。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 154,
   "act": "幕三 · 剪纸为月",
   "text": "月亮里的人看得清清楚楚，连胡子上的酒珠都看得见。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 155,
   "act": "幕三 · 剪纸为月",
   "text": "过了一会儿，月亮慢慢暗下去。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 156,
   "act": "幕三 · 剪纸为月",
   "text": "有人点上蜡烛。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 157,
   "act": "幕三 · 剪纸为月",
   "text": "堂上只剩老道士一个人坐着。桌上的菜还没动几筷。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 158,
   "act": "幕三 · 剪纸为月",
   "text": "王七这才发现，自己从头到尾一直站在门口那个位置，一步也没挪。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 159,
   "act": "幕三 · 剪纸为月",
   "text": "腿是麻的。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 160,
   "act": "幕三 · 剪纸为月",
   "text": "墙上贴的，是一张剪成圆形的纸。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 161,
   "act": "幕四 · 撞墙",
   "text": "那天夜里王七没睡着。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 162,
   "act": "幕四 · 撞墙",
   "text": "他想，这才是本事。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 163,
   "act": "幕四 · 撞墙",
   "text": "第二天他没提下山的事。又过了一个月，他实在受不了了。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 164,
   "act": "幕四 · 撞墙",
   "text": "那天早上他去找老道士。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 165,
   "act": "幕四 · 撞墙",
   "text": "弟子数百里受业仙师，纵不能得长生术，或小有传习，亦可慰求教之心。",
   "who": "书生",
   "beat": "引文"
  },
  {
   "no": 166,
   "act": "幕四 · 撞墙",
   "text": "老道士没有立刻答话。他把手里的东西放下，才抬起头。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 167,
   "act": "幕四 · 撞墙",
   "text": "老道士笑了一下。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 168,
   "act": "幕四 · 撞墙",
   "text": "我固谓不能作苦，今果然。明早当遣汝行。",
   "who": "老道",
   "beat": "引文"
  },
  {
   "no": 169,
   "act": "幕四 · 撞墙",
   "text": "王七急了。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 170,
   "act": "幕四 · 撞墙",
   "text": "弟子操作多日，师略授小技，此来为不负也。",
   "who": "书生",
   "beat": "引文"
  },
  {
   "no": 171,
   "act": "幕四 · 撞墙",
   "text": "你要学什么。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 172,
   "act": "幕四 · 撞墙",
   "text": "我见师父穿墙而过，就求这一样。",
   "who": "书生",
   "beat": "提速"
  },
  {
   "no": 173,
   "act": "幕四 · 撞墙",
   "text": "老道士没有为难他。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 174,
   "act": "幕四 · 撞墙",
   "text": "他这两个多月见的，老道士都知道。他要什么，老道士也知道。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 175,
   "act": "幕四 · 撞墙",
   "text": "老道士问他，你要这个做什么。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 176,
   "act": "幕四 · 撞墙",
   "text": "王七说，回去给人看看。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 177,
   "act": "幕四 · 撞墙",
   "text": "他说完自己也觉得这话不好听，又补了一句：也不光是给人看。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 178,
   "act": "幕四 · 撞墙",
   "text": "老道士没有追问。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 179,
   "act": "幕四 · 撞墙",
   "text": "老道士教了他一句咒。念完，让他自己念一遍。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 180,
   "act": "幕四 · 撞墙",
   "text": "王七念得磕磕巴巴，念了三遍才顺。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 181,
   "act": "幕四 · 撞墙",
   "text": "老道士听完，点了一下头，指了指墙。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 182,
   "act": "幕四 · 撞墙",
   "text": "那面墙王七每天都路过，从没多看过一眼。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 183,
   "act": "幕四 · 撞墙",
   "text": "入之。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 184,
   "act": "幕四 · 撞墙",
   "text": "王七面对着墙，不敢动。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 185,
   "act": "幕四 · 撞墙",
   "text": "试入之。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 186,
   "act": "幕四 · 撞墙",
   "text": "王七试着往前走，走到墙跟前，停住了。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 187,
   "act": "幕四 · 撞墙",
   "text": "俯首骤入，勿逡巡。",
   "who": "老道",
   "beat": "揭底"
  },
  {
   "no": 188,
   "act": "幕四 · 撞墙",
   "text": "王七退开几步，低下头，照着咒念了，往墙上撞过去。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 189,
   "act": "幕四 · 撞墙",
   "text": "到了墙跟前，他觉得什么也没碰着。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 190,
   "act": "幕四 · 撞墙",
   "text": "回头一看，人已经在墙外面了。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 191,
   "act": "幕四 · 撞墙",
   "text": "王七高兴坏了，进来谢师父。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 192,
   "act": "幕四 · 撞墙",
   "text": "他又试了一回，还是过去了。第三回他不试了，怕用坏。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 193,
   "act": "幕四 · 撞墙",
   "text": "老道士叮嘱他一句：回去以后要洁持，不然不灵。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 194,
   "act": "幕四 · 撞墙",
   "text": "王七应了一声。他那时候心思已经不在这句话上了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 195,
   "act": "幕四 · 撞墙",
   "text": "他心里想的是回家那条路，想的是到家以后先跟谁说。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 196,
   "act": "幕四 · 撞墙",
   "text": "下山的时候天刚亮。走到半山腰他回头看了一眼，那片瓦还在。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 197,
   "act": "幕四 · 撞墙",
   "text": "他没有再看第二眼。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 198,
   "act": "幕四 · 撞墙",
   "text": "又给了他一点盘缠，打发他下山。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 199,
   "act": "幕五 · 回家",
   "text": "王七到家，见人就说自己遇上了仙人。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 200,
   "act": "幕五 · 回家",
   "text": "家里人问他学了什么，他不肯细说，只说学了一样别人没有的。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 201,
   "act": "幕五 · 回家",
   "text": "问的人多了，他忍不住露了口风：能穿墙。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 202,
   "act": "幕五 · 回家",
   "text": "有人不信，有人说那你走一个。他说不急，得挑个时候。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 203,
   "act": "幕五 · 回家",
   "text": "他挑了几天。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 204,
   "act": "幕五 · 回家",
   "text": "头一天他说风向不对。第二天他说时辰不好。第三天没人再问他了。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 205,
   "act": "幕五 · 回家",
   "text": "没人问，他反倒憋不住。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 206,
   "act": "幕五 · 回家",
   "text": "这几天他没闲着。他把师父那句咒又念了几十遍，念到闭着眼也不会错。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 207,
   "act": "幕五 · 回家",
   "text": "他还在自家院墙上找了一处，看了看厚薄。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 208,
   "act": "幕五 · 回家",
   "text": "他说，如今就是坚硬的墙壁，也拦不住我。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 209,
   "act": "幕五 · 回家",
   "text": "那天家里来了两个客人。饭吃到一半，话头又绕到这件事上。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 210,
   "act": "幕五 · 回家",
   "text": "王七放下筷子，说这有什么难的。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 211,
   "act": "幕五 · 回家",
   "text": "他妻子不信。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 212,
   "act": "幕五 · 回家",
   "text": "你说说看，是怎么个不拦得住。",
   "who": "妇人",
   "beat": "揭底"
  },
  {
   "no": 213,
   "act": "幕五 · 回家",
   "text": "王七退到离墙几步远的地方，摆开架势。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 214,
   "act": "幕五 · 回家",
   "text": "屋里的人都停下来看他。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 215,
   "act": "幕五 · 回家",
   "text": "他妻子端着碗站在灶边上，也停了。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 216,
   "act": "幕五 · 回家",
   "text": "他先深吸了一口气。他记得师父说过，不能犹豫。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 217,
   "act": "幕五 · 回家",
   "text": "他把在山上学的那句咒念了一遍。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 218,
   "act": "幕五 · 回家",
   "text": "念完，低下头，直着往墙上冲过去。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 219,
   "act": "幕五 · 回家",
   "text": "一头撞在墙上，扑通一声，人仰面倒在地上。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 220,
   "act": "幕五 · 回家",
   "text": "屋里静了一下。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 221,
   "act": "幕五 · 回家",
   "text": "他妻子过去把他扶起来。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 222,
   "act": "幕五 · 回家",
   "text": "额头上鼓起一个大包，有鸡蛋那么大。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 223,
   "act": "幕五 · 回家",
   "text": "碰一下就疼。他自己伸手摸了摸，摸完把手放下了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 224,
   "act": "幕五 · 回家",
   "text": "王七躺在地上，脸上挂不住。他骂那老道士不讲道义。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 225,
   "act": "幕五 · 回家",
   "text": "他说，那老头子留了一手，教的是假的。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 226,
   "act": "幕五 · 回家",
   "text": "他说，早知道就不该去。",
   "who": "说书人",
   "beat": "提速"
  },
  {
   "no": 227,
   "act": "幕五 · 回家",
   "text": "他说这些话的时候，两个客人已经出门了。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 228,
   "act": "幕五 · 回家",
   "text": "出了门那两个人才笑出声。声音不大，可是屋里听得见。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 229,
   "act": "幕五 · 回家",
   "text": "王七从地上爬起来，走到墙跟前，伸手推了推。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 230,
   "act": "幕五 · 回家",
   "text": "墙是硬的。",
   "who": "说书人",
   "beat": "揭底"
  },
  {
   "no": 231,
   "act": "幕五 · 回家",
   "text": "他又照着咒念了一遍，这回没敢撞，只用手按着往前顶。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 232,
   "act": "幕五 · 回家",
   "text": "手顶在墙上，一分也进不去。",
   "who": "说书人",
   "beat": "悬"
  },
  {
   "no": 233,
   "act": "幕五 · 回家",
   "text": "他妻子在旁边看着他，笑了一声。",
   "who": "说书人",
   "beat": "顿"
  },
  {
   "no": 234,
   "act": "幕五 · 回家",
   "text": "那几天他不出门。有人来问，他说身上不舒服。",
   "who": "说书人",
   "beat": "贴近"
  },
  {
   "no": 235,
   "act": "幕五 · 回家",
   "text": "他妻子替他遮了几回。遮到后来邻里都知道了，也没人再当面提。",
   "who": "说书人",
   "beat": "落定"
  },
  {
   "no": 236,
   "act": "幕五 · 回家",
   "text": "那个包，好些天才消。",
   "who": "说书人",
   "beat": "常规"
  },
  {
   "no": 237,
   "act": "幕五 · 回家",
   "text": "消了以后，他再没跟人说过崂山的事。",
   "who": "说书人",
   "beat": "收"
  },
  {
   "no": 238,
   "act": "收束",
   "text": "蒲松龄在这个故事后面写了一段话。他说，听了这件事，没有一个人不笑的。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 239,
   "act": "收束",
   "text": "可是他说，天底下像王七这样的人，不在少数。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 240,
   "act": "收束",
   "text": "这个故事从头到尾，老道士只对他说过一句判断的话。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 241,
   "act": "收束",
   "text": "那句话在他刚上山的第一天就说了：恐娇惰不能作苦。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 242,
   "act": "收束",
   "text": "后来两个多月，砍柴、起早、磨出茧子、动了归意，全部是在给这一句话作注。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 243,
   "act": "收束",
   "text": "老道士没有骗他。他答应教的，教了；他没答应的，一句也没提。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 244,
   "act": "收束",
   "text": "从头到尾，老道士只在两个地方开口断过话。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 245,
   "act": "收束",
   "text": "一次是他刚上山，说恐娇惰不能作苦。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 246,
   "act": "收束",
   "text": "一次是他要走，说我固谓不能作苦，今果然。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 247,
   "act": "收束",
   "text": "中间两个多月，老道士一句都没催过他，也一句都没劝过他。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 248,
   "act": "收束",
   "text": "穿墙那一下也是真的。王七在山上确实穿过去了。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 249,
   "act": "收束",
   "text": "坏就坏在最后那句叮嘱上。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 250,
   "act": "收束",
   "text": "老道士说要洁持。王七回家第一件事，是把这个本事拿出来给人看。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 251,
   "act": "收束",
   "text": "他求的从来不是道。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 252,
   "act": "收束",
   "text": "他上山第一天就说，别的我都不要，就要一样。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 253,
   "act": "收束",
   "text": "那句话说得很干脆，干脆到连他自己都没觉出问题。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 254,
   "act": "收束",
   "text": "求道的人不会这么说话。要一样东西的人才这么说话。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 255,
   "act": "收束",
   "text": "要的是一样能拿出去的本事。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 256,
   "act": "收束",
   "text": "一个多月的柴他也砍了，苦他也吃了，可他吃苦不是为了修行，是为了换。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 257,
   "act": "收束",
   "text": "换到手里，转脸就想用它换点别的——换一句夸，换一个脸面。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 258,
   "act": "收束",
   "text": "所以那面墙拦住他，不是道术不灵。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 259,
   "act": "收束",
   "text": "是他要的东西，从头到尾就不在墙那边。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 260,
   "act": "收束",
   "text": "下一期换个调子。",
   "who": "说书人",
   "beat": "点评"
  },
  {
   "no": 261,
   "act": "收束",
   "text": "一只蟋蟀，压死了一家人。",
   "who": "说书人",
   "beat": "收"
  }
 ]
}