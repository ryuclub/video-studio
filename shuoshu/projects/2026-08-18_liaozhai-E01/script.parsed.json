{
  "id": "liaozhai-E01-huapi",
  "title": "第 1 期《画皮》",
  "lines": [
    {
      "no": 1,
      "act": "冷开场",
      "text": "这个故事里最吓人的一幕，不是杀人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 2,
      "act": "冷开场",
      "text": "是化妆。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 3,
      "act": "冷开场",
      "text": "一只青脸的鬼，坐在床边，把一张人皮平平铺开，手里拿着彩笔，一笔一笔往上描——描眉毛，描眼睛，描嘴唇。描得很慢，很仔细，像个手艺人在做活。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 4,
      "act": "冷开场",
      "text": "描完了，把笔一扔，两只手抓起那张皮，像抖开一件衣裳那样抖了抖，往身上一披。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 5,
      "act": "冷开场",
      "text": "再抬起头来，就是一个绝色的美人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 6,
      "act": "冷开场",
      "text": "蒲松龄写《聊斋志异》，写了将近五百个故事。传得最广的，就是这一个。名字叫《画皮》。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 7,
      "act": "冷开场",
      "text": "这个故事大家都听过名字。但真正的原文，比电影里狠得多。今天咱们从头讲。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 8,
      "act": "引入",
      "text": "故事发生在太原，主角姓王，书上没写他的名字，就叫他王生。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 9,
      "act": "引入",
      "text": "王生是个读书人，家里有妻子，姓陈。日子过得不算富，也不算穷，就是寻常人家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 10,
      "act": "引入",
      "text": "有一天天还没亮，王生出门赶早路。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 11,
      "act": "引入",
      "text": "天蒙蒙亮，路上没什么人，两边的树看着都是黑的。走着走着，前头出现一个人影。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 12,
      "act": "引入",
      "text": "是个年轻姑娘，怀里抱着个包袱，一个人急急忙忙地走。走得很吃力，包袱看着沉，脚下也不利索，走两步歇一步。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 13,
      "act": "引入",
      "text": "王生看她那个样子，心里就动了一下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 14,
      "act": "引入",
      "text": "请你记住这一下心动。整个故事，就是从这里开始的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 15,
      "act": "引入",
      "text": "他快走几步赶上去。走近了一看——年纪大概十六七岁，模样漂亮得不像话。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 16,
      "act": "引入",
      "text": "王生就搭话了。他问：姑娘，天还没亮，一个人赶路，你这是要去哪儿？",
      "who": "说书人",
      "beat": "收",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 17,
      "act": "幕一 · 遇",
      "text": "姑娘一听有人问，眼圈就红了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 18,
      "act": "幕一 · 遇",
      "text": "她说：先生赶您的路吧，问这些做什么。我这点苦，说了也没人替我担。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 19,
      "act": "幕一 · 遇",
      "text": "你要是有什么难处，说出来，能帮的我帮。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 20,
      "act": "幕一 · 遇",
      "text": "姑娘停下脚步，这才开口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 21,
      "act": "幕一 · 遇",
      "text": "她说，我原是大户人家买来的妾。那家的正房太太容不下我，天天打骂，实在熬不下去了，趁天没亮跑出来的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 22,
      "act": "幕一 · 遇",
      "text": "那你打算上哪儿去？",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 23,
      "act": "幕一 · 遇",
      "text": "姑娘摇头。她说：跑出来的人，哪有地方去。走一步算一步吧。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 24,
      "act": "幕一 · 遇",
      "text": "王生看她抱着包袱站在那儿，就说：我家离这儿不远。你要是不嫌弃，先到我家住下，慢慢再想办法。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 25,
      "act": "幕一 · 遇",
      "text": "姑娘听了，抬起头看了他一眼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 26,
      "act": "幕一 · 遇",
      "text": "就这一眼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 27,
      "act": "幕一 · 遇",
      "text": "然后她答应了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 28,
      "act": "幕一 · 遇",
      "text": "王生伸手把包袱接过来，自己背着，领她回了家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 29,
      "act": "幕一 · 遇",
      "text": "到了家门口，他没让她走前院，从侧门进去，直接带到书房——那是他自己读书用的一间偏屋，平时家里人不去。安顿好，关上门。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 30,
      "act": "幕一 · 遇",
      "text": "从这天起，姑娘就住下了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 31,
      "act": "幕一 · 遇",
      "text": "王生每天往书房跑，一连好几天，家里谁也不知道院子里多了这么个人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 32,
      "act": "幕一 · 遇",
      "text": "后来实在瞒不住了，王生跟妻子陈氏说了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 33,
      "act": "幕一 · 遇",
      "text": "陈氏一听，眉头就皱起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 34,
      "act": "幕一 · 遇",
      "text": "她说：你想想，一个十六七岁的姑娘，天不亮一个人在路上跑，能是什么来路？多半是哪个大户人家的妾室逃出来的。人家找上门来，你怎么交代？",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 35,
      "act": "幕一 · 遇",
      "text": "她说：你赶紧把她送走。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 36,
      "act": "幕一 · 遇",
      "text": "王生不听。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 37,
      "act": "幕一 · 遇",
      "text": "他说：一个弱女子无处可去，我不能见死不救。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 38,
      "act": "幕一 · 遇",
      "text": "这话听着有理。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 39,
      "act": "幕一 · 遇",
      "text": "可你回头想想——他见到这姑娘的第一眼，动的是什么心？他自己心里最清楚。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 40,
      "act": "幕一 · 遇",
      "text": "陈氏劝了两回，劝不动，也就不说了。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 41,
      "act": "幕二 · 疑",
      "text": "日子一天天过。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 42,
      "act": "幕二 · 疑",
      "text": "有一天王生上街办事，走着走着，迎面来了一个道士。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 43,
      "act": "幕二 · 疑",
      "text": "那道士看见王生，愣住了。他停下脚步，从头到脚把王生打量了一遍，脸色变了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 44,
      "act": "幕二 · 疑",
      "text": "他问：你最近，遇上什么了？",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 45,
      "act": "幕二 · 疑",
      "text": "没有啊。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 46,
      "act": "幕二 · 疑",
      "text": "你身上邪气缠着，一层一层的。你还说没有？",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 47,
      "act": "幕二 · 疑",
      "text": "王生心里咯噔一下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 48,
      "act": "幕二 · 疑",
      "text": "但嘴上还是硬。他说：真没有。道士您认错人了。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 49,
      "act": "幕二 · 疑",
      "text": "道士看着他，看了很久，摇了摇头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 50,
      "act": "幕二 · 疑",
      "text": "然后他说了一句话。这句话是全篇分量最重的一句，蒲松龄的原文是这么写的——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 51,
      "act": "幕二 · 疑",
      "text": "「惑哉！世固有死将临而不悟者。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 52,
      "act": "幕二 · 疑",
      "text": "翻成白话就是：糊涂啊。这世上就是有这样的人，死到临头了，还不明白。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 53,
      "act": "幕二 · 疑",
      "text": "说完，道士走了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 54,
      "act": "幕二 · 疑",
      "text": "王生一个人站在街上。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 55,
      "act": "幕二 · 疑",
      "text": "他心里其实已经开始发慌了。那道士说的是谁，他清楚得很。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 56,
      "act": "幕二 · 疑",
      "text": "可他站在那儿，开始给自己找理由。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 57,
      "act": "幕二 · 疑",
      "text": "第一个理由：那是个大活人。天天在他眼皮底下吃饭、说话、走路，能是什么妖怪。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 58,
      "act": "幕二 · 疑",
      "text": "第二个理由——这个理由更管用——那道士八成是骗钱的。街上这种人还少吗？先说你身上有邪气，接着就该卖你一道符了。今天他还没来得及开口要钱，是因为自己走得快。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 59,
      "act": "幕二 · 疑",
      "text": "王生越想越觉得有道理。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 60,
      "act": "幕二 · 疑",
      "text": "他这么想的时候，脚下已经在往家走了，而且越走越快。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 61,
      "act": "幕二 · 疑",
      "text": "到了家，他直接去书房。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 62,
      "act": "幕二 · 疑",
      "text": "手往门上一推——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 63,
      "act": "幕二 · 疑",
      "text": "门从里面闩上了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 64,
      "act": "幕二 · 疑",
      "text": "王生站在门口，手还搭在门上，没敢再推第二下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 65,
      "act": "幕二 · 疑",
      "text": "他绕到院子侧面。那边有一段墙塌了半截。他扶着墙头翻了进去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 66,
      "act": "幕二 · 疑",
      "text": "进了院子，屋门也是关着的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 67,
      "act": "幕二 · 疑",
      "text": "他放轻脚步，一点一点挪到窗户底下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 68,
      "act": "幕二 · 疑",
      "text": "窗纸上有个破口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 69,
      "act": "幕二 · 疑",
      "text": "王生凑过去，往里看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 70,
      "act": "幕二 · 疑",
      "text": "他看见——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 71,
      "act": "幕二 · 疑",
      "text": "屋里坐着一个鬼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 72,
      "act": "幕二 · 疑",
      "text": "脸是青绿色的，牙齿又长又尖，一排排龇在外面，像锯子一样。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 73,
      "act": "幕二 · 疑",
      "text": "那鬼手里拿着一支彩笔。榻上铺着一张人皮：五官、四肢、手指头，整整齐齐，一张完完整整的人皮。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 74,
      "act": "幕二 · 疑",
      "text": "鬼低着头，正在往那张皮上画。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 75,
      "act": "幕二 · 疑",
      "text": "画眉毛。画眼睛。画嘴唇。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 76,
      "act": "幕二 · 疑",
      "text": "画得很慢，很仔细。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 77,
      "act": "幕二 · 疑",
      "text": "画完了，笔往地上一扔。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 78,
      "act": "幕二 · 疑",
      "text": "两只手抓起那张人皮，抖开——就那么一抖，像抖开一件穿了一天的衣裳。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 79,
      "act": "幕二 · 疑",
      "text": "往身上一披。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 80,
      "act": "幕二 · 疑",
      "text": "站起来的，就是那个姑娘。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 81,
      "act": "幕二 · 疑",
      "text": "王生趴在窗根底下，一动不敢动，连喘气都不敢喘。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 82,
      "act": "幕三 · 夜",
      "text": "等屋里没动静了，王生手脚并用爬出院子，一口气跑上街。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 83,
      "act": "幕三 · 夜",
      "text": "道士不在了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 84,
      "act": "幕三 · 夜",
      "text": "他满街找，一条街一条街地跑，问了好些人，都说没见着。一直找到城外的野地里，才远远看见那个背影。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 85,
      "act": "幕三 · 夜",
      "text": "王生跑过去，还没到跟前就跪下了，一路跪着爬过去，抱住道士的腿。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 86,
      "act": "幕三 · 夜",
      "text": "道士听他说完，叹了口气。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 87,
      "act": "幕三 · 夜",
      "text": "他说：这东西也不容易。它找了很久，好不容易找到一个替身。我不忍心要它的命。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 88,
      "act": "幕三 · 夜",
      "text": "他从身上解下一把拂尘，递过去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 89,
      "act": "幕三 · 夜",
      "text": "把这个挂在你卧房门上。记住，是卧房。",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 90,
      "act": "幕三 · 夜",
      "text": "他又说了一句：三天后，青帝庙，我在那儿等你。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 91,
      "act": "幕三 · 夜",
      "text": "王生接过拂尘，谢了又谢，一路小跑回家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 92,
      "act": "幕三 · 夜",
      "text": "到家他没敢进书房，绕着走的。拂尘挂在卧房门上，门闩插死，他跟妻子睡在里屋。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 93,
      "act": "幕三 · 夜",
      "text": "躺下之后，两个人谁也没睡着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 94,
      "act": "幕三 · 夜",
      "text": "一更过后——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 95,
      "act": "幕三 · 夜",
      "text": "门外有声音。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 96,
      "act": "幕三 · 夜",
      "text": "窸窸窣窣的，很轻。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 97,
      "act": "幕三 · 夜",
      "text": "然后是脚步声。一步。一步。走到门口，停住了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 98,
      "act": "幕三 · 夜",
      "text": "王生躺在床上，眼睛睁着，一动不敢动。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 99,
      "act": "幕三 · 夜",
      "text": "他想看，又不敢看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 100,
      "act": "幕三 · 夜",
      "text": "他伸手推了推身边的妻子。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 101,
      "act": "幕三 · 夜",
      "text": "他说：你去看看。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 102,
      "act": "幕三 · 夜",
      "text": "陈氏坐了起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 103,
      "act": "幕三 · 夜",
      "text": "她下了床，光着脚走到门边，从门缝往外看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 104,
      "act": "幕三 · 夜",
      "text": "外头站着那个姑娘。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 105,
      "act": "幕三 · 夜",
      "text": "她站在门槛外头，眼睛盯着门上挂的那把拂尘，不往前走。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 106,
      "act": "幕三 · 夜",
      "text": "就那么站着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 107,
      "act": "幕三 · 夜",
      "text": "陈氏看见她在咬牙。咯，咯，咯。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 108,
      "act": "幕三 · 夜",
      "text": "站了很久很久，她转身走了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 109,
      "act": "幕三 · 夜",
      "text": "陈氏回到床边，小声说：走了。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 110,
      "act": "幕三 · 夜",
      "text": "两个人刚把这口气松下来——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 111,
      "act": "幕三 · 夜",
      "text": "脚步声又回来了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 112,
      "act": "幕三 · 夜",
      "text": "这一回，门外的东西开口了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 113,
      "act": "幕三 · 夜",
      "text": "它说：道士吓唬我？笑话。我到嘴的东西，还能吐出来不成。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 114,
      "act": "幕三 · 夜",
      "text": "接着是拂尘被扯下来、撕碎的声音。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 115,
      "act": "幕三 · 夜",
      "text": "再接着，门被撞开了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 116,
      "act": "幕三 · 夜",
      "text": "那东西一步跨到床前，一把撕开王生的胸膛，把心掏了出来，转身就走。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 117,
      "act": "幕三 · 夜",
      "text": "陈氏就在旁边。从头到尾，她眼睁睁看着，一声也喊不出来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 118,
      "act": "幕三 · 夜",
      "text": "丫鬟举着蜡烛跑进来的时候，人已经没了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 119,
      "act": "幕三 · 夜",
      "text": "床上、地上，一片血。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 120,
      "act": "幕四 · 捕",
      "text": "天一亮，陈氏让王生的弟弟二郎去找那个道士。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 121,
      "act": "幕四 · 捕",
      "text": "道士一听，火了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 122,
      "act": "幕四 · 捕",
      "text": "他说：我本来还可怜它，它倒敢这么干！",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 123,
      "act": "幕四 · 捕",
      "text": "道士跟着二郎回来，进了书房。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 124,
      "act": "幕四 · 捕",
      "text": "屋里空的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 125,
      "act": "幕四 · 捕",
      "text": "人不在，鬼也不在，那张人皮也没了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 126,
      "act": "幕四 · 捕",
      "text": "道士站在院子当中，抬起头，前后左右看了一圈。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 127,
      "act": "幕四 · 捕",
      "text": "他说：还好。没跑远。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 128,
      "act": "幕四 · 捕",
      "text": "然后他问二郎：南边那个院子，是谁家的？",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 129,
      "act": "幕四 · 捕",
      "text": "是我住的。",
      "who": "二郎",
      "beat": "常规"
    },
    {
      "no": 130,
      "act": "幕四 · 捕",
      "text": "它现在就在你家里。",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 131,
      "act": "幕四 · 捕",
      "text": "二郎愣住了。他说：不可能。我家里没有生人。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 132,
      "act": "幕四 · 捕",
      "text": "今天早上，有没有不认识的人上过门？",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 133,
      "act": "幕四 · 捕",
      "text": "我一早去了青帝庙，家里的事我不知道。我回去问问。",
      "who": "二郎",
      "beat": "常规"
    },
    {
      "no": 134,
      "act": "幕四 · 捕",
      "text": "二郎跑回家，过了一会儿又跑回来，脸都白了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 135,
      "act": "幕四 · 捕",
      "text": "他说：真有。今天早上来了个老太婆，说想到我家做佣工。我媳妇看她可怜，就留下了。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 136,
      "act": "幕四 · 捕",
      "text": "他说：她现在还在我家。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 137,
      "act": "幕四 · 捕",
      "text": "就是它。",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 138,
      "act": "幕四 · 捕",
      "text": "道士带着二郎回去，走进院子，站在当中。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 139,
      "act": "幕四 · 捕",
      "text": "他抽出一把木剑，往屋里一指，喊了一声——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 140,
      "act": "幕四 · 捕",
      "text": "孽障！还我拂尘来！",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 141,
      "act": "幕四 · 捕",
      "text": "屋里那个老太婆，脸一下子全白了。她夺门就往外跑。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 142,
      "act": "幕四 · 捕",
      "text": "道士追上去一剑打下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 143,
      "act": "幕四 · 捕",
      "text": "老太婆扑倒在地。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 144,
      "act": "幕四 · 捕",
      "text": "然后，那张人皮哗地一声从她身上脱了下来——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 145,
      "act": "幕四 · 捕",
      "text": "底下站起来的，是一只厉鬼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 146,
      "act": "幕四 · 捕",
      "text": "它趴在地上嚎，声音像猪。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 147,
      "act": "幕四 · 捕",
      "text": "道士一剑砍下它的头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 148,
      "act": "幕四 · 捕",
      "text": "身子当场化成一股浓烟，堆在地上打转，想往外窜。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 149,
      "act": "幕四 · 捕",
      "text": "道士取出一个葫芦，拔了塞子，往烟堆里一放。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 150,
      "act": "幕四 · 捕",
      "text": "飗——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 151,
      "act": "幕四 · 捕",
      "text": "像有人在吸气，一口一口把烟吸了进去。转眼工夫，一点不剩。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 152,
      "act": "幕四 · 捕",
      "text": "道士把塞子塞好，收进袋里。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 153,
      "act": "幕四 · 捕",
      "text": "众人低头看那张人皮。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 154,
      "act": "幕四 · 捕",
      "text": "眉毛、眼睛、手、脚，一样不缺，整整齐齐。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 155,
      "act": "幕四 · 捕",
      "text": "道士弯下腰，把它卷起来。卷的时候发出声音，像在卷一幅画。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 156,
      "act": "幕四 · 捕",
      "text": "卷好，也收进袋里。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 157,
      "act": "幕四 · 捕",
      "text": "他背上袋子，转身要走。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 158,
      "act": "幕五 · 救",
      "text": "陈氏拦在门口，跪下来，哭着求他救活丈夫。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 159,
      "act": "幕五 · 救",
      "text": "道士摇头。他说：我的本事到这儿为止。我没有让死人复生的法术。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 160,
      "act": "幕五 · 救",
      "text": "陈氏伏在地上，不起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 161,
      "act": "幕五 · 救",
      "text": "道士站着，想了很久。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 162,
      "act": "幕五 · 救",
      "text": "他说：我指一个人给你。他也许能。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 163,
      "act": "幕五 · 救",
      "text": "陈氏抬起头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 164,
      "act": "幕五 · 救",
      "text": "城里街上有个疯子，成天躺在粪土堆里。你去求他。",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 165,
      "act": "幕五 · 救",
      "text": "他又交代了一句：万一他侮辱你，你不能恼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 166,
      "act": "幕五 · 救",
      "text": "二郎也知道那个人。他领着嫂子去了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 167,
      "act": "幕五 · 救",
      "text": "那个乞丐正在路上边走边唱，头发结成一团，鼻涕挂着三尺长，浑身脏得没法靠近。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 168,
      "act": "幕五 · 救",
      "text": "陈氏跪下，一路跪着爬到他跟前。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 169,
      "act": "幕五 · 救",
      "text": "乞丐低头看她，笑起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 170,
      "act": "幕五 · 救",
      "text": "他说：美人，你这是喜欢我啊？",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 171,
      "act": "幕五 · 救",
      "text": "陈氏低着头，把丈夫的事说了一遍。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 172,
      "act": "幕五 · 救",
      "text": "乞丐哈哈大笑。他说：天下男人多得是。救他做什么？",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 173,
      "act": "幕五 · 救",
      "text": "陈氏还是求。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 174,
      "act": "幕五 · 救",
      "text": "怪了。人都死了，跑来求我。我是阎王吗？",
      "who": "乞丐",
      "beat": "常规"
    },
    {
      "no": 175,
      "act": "幕五 · 救",
      "text": "说完，抄起旁边一根棍子就打。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 176,
      "act": "幕五 · 救",
      "text": "陈氏不躲，让他打。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 177,
      "act": "幕五 · 救",
      "text": "街上的人越围越多，围了一圈又一圈。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 178,
      "act": "幕五 · 救",
      "text": "乞丐打累了，扔了棍子，喉咙里咳了半天，咳出一大口浓痰，捧在手心里，伸到陈氏面前。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 179,
      "act": "幕五 · 救",
      "text": "他说：吃了。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "代词开头，机器分不清是谁在说"
    },
    {
      "no": 180,
      "act": "幕五 · 救",
      "text": "围观的人都笑出声来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 181,
      "act": "幕五 · 救",
      "text": "陈氏抬起头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 182,
      "act": "幕五 · 救",
      "text": "她的脸涨得通红。她看着那只脏手里的东西，没有伸手。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 183,
      "act": "幕五 · 救",
      "text": "她犹豫了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 184,
      "act": "幕五 · 救",
      "text": "——她想起道士交代的那句话。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 185,
      "act": "幕五 · 救",
      "text": "她伸手接过来，仰起头，咽了下去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 186,
      "act": "幕五 · 救",
      "text": "那口东西下到嗓子里，硬得像一团棉絮，格格格地往下走，走到胸口，就不动了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 187,
      "act": "幕五 · 救",
      "text": "卡在那儿。咽不下去，也吐不出来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 188,
      "act": "幕五 · 救",
      "text": "乞丐大笑起来。他说：美人真是喜欢我啊。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 189,
      "act": "幕五 · 救",
      "text": "说完起身就走，头也不回。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 190,
      "act": "幕五 · 救",
      "text": "陈氏跟在后头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 191,
      "act": "幕五 · 救",
      "text": "乞丐进了一座庙。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 192,
      "act": "幕五 · 救",
      "text": "陈氏追进去——里面没人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 193,
      "act": "幕五 · 救",
      "text": "她前前后后找了个遍，一点影子都没有。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 194,
      "act": "幕五 · 救",
      "text": "她站在空庙里，又羞又恨，回了家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 195,
      "act": "幕五 · 救",
      "text": "到家，丈夫还停在那儿。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 196,
      "act": "幕五 · 救",
      "text": "她一边伤心丈夫死得那么惨，一边后悔自己当街吃了那口痰，只想跟着死了算了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 197,
      "act": "幕五 · 救",
      "text": "要收殓了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 198,
      "act": "幕五 · 救",
      "text": "家人都远远站着，没有一个敢靠近。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 199,
      "act": "幕五 · 救",
      "text": "陈氏自己走过去，抱起丈夫的身子，把流出来的肠子一点一点收回去，一边收一边哭。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 200,
      "act": "幕五 · 救",
      "text": "哭到嗓子哑了，忽然一阵反胃。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 201,
      "act": "幕五 · 救",
      "text": "她觉得胸口那团东西开始往上顶。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 202,
      "act": "幕五 · 救",
      "text": "一点一点，顶到喉咙口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 203,
      "act": "幕五 · 救",
      "text": "她张开嘴——",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 204,
      "act": "幕五 · 救",
      "text": "一样东西冲了出来，她来不及回头，那东西已经落进了王生胸口那个洞里。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 205,
      "act": "幕五 · 救",
      "text": "陈氏低头一看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 206,
      "act": "幕五 · 救",
      "text": "是一颗心。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 207,
      "act": "幕五 · 救",
      "text": "在腔子里突突地跳，热气往上冒。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 208,
      "act": "幕五 · 救",
      "text": "她赶紧伸出两只手，把胸口合拢，用力抱住。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 209,
      "act": "幕五 · 救",
      "text": "一松手，气就从缝里冒出来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 210,
      "act": "幕五 · 救",
      "text": "她撕了绸子，一圈一圈把丈夫的胸口缠紧。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 211,
      "act": "幕五 · 救",
      "text": "然后伸手去摸。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 212,
      "act": "幕五 · 救",
      "text": "尸首，在一点点变暖。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 213,
      "act": "幕五 · 救",
      "text": "她盖上被子，坐在旁边守着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 214,
      "act": "幕五 · 救",
      "text": "半夜掀开看了一次——有鼻息了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 215,
      "act": "幕五 · 救",
      "text": "天亮的时候，王生睁开了眼。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 216,
      "act": "收束",
      "text": "故事到这儿讲完了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 217,
      "act": "收束",
      "text": "蒲松龄在结尾写了几句自己的话。他说：世上的人真是糊涂。明明是个妖怪，偏偏觉得是个美人。",
      "who": "说书人",
      "beat": "常规",
      "needsReview": true,
      "reviewNote": "有对白特征但没解析出说话人"
    },
    {
      "no": 218,
      "act": "收束",
      "text": "这话说得直白。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 219,
      "act": "收束",
      "text": "但我觉得，这个故事真正狠的地方，不在这儿。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 220,
      "act": "收束",
      "text": "你回头数一数王生的机会。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 221,
      "act": "收束",
      "text": "第一次，街上那个道士把话挑明了。他不但不信，他还给自己找了两个理由——一个是\"她是活人\"，一个是\"道士想骗钱\"。他不是没听懂，他是主动把这句话推开的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 222,
      "act": "收束",
      "text": "第二次，他自己翻墙、绕屋、趴在窗根底下，亲眼看着那张皮被抖开、被披上。他吓得爬着出来了——可他没跑。他跑去要了一把拂尘，挂在门上，然后回屋躺下了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 223,
      "act": "收束",
      "text": "第三次，半夜那东西已经站在门外了。他睁着眼躺在床上，想看，不敢看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 224,
      "act": "收束",
      "text": "他推醒了妻子，让她去看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 225,
      "act": "收束",
      "text": "三次机会，一次都没抓住。前两次是因为舍不得，第三次是因为不敢。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 226,
      "act": "收束",
      "text": "再看陈氏。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 227,
      "act": "收束",
      "text": "她是最早劝他把人送走的那个。是半夜替他去门缝看的那个。是当街跪下、挨棍子、吃下那口痰的那个。是家里所有人都不敢靠近的时候，自己伸手把丈夫的肠子收回去的那个。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 228,
      "act": "收束",
      "text": "她从头到尾没做错过一件事。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 229,
      "act": "收束",
      "text": "一个人看见了真相，还愿意骗自己。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 230,
      "act": "收束",
      "text": "另一个人什么都没做错，却要吞下那口痰。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 231,
      "act": "收束",
      "text": "这才是《画皮》真正吓人的地方。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 232,
      "act": "收束",
      "text": "下一期，咱们讲《聂小倩》。荒庙，孤客，一个不肯害人的女鬼——还有一个背着剑匣、深夜不睡的怪人。",
      "who": "说书人",
      "beat": "收"
    }
  ]
}
