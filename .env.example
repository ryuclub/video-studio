# 写稿用
ANTHROPIC_API_KEY=sk-ant-...
VG_MODEL=claude-sonnet-5

# 素材检索用（免费申请：https://www.pexels.com/api/）
PEXELS_API_KEY=

# 配音音色与语速
VG_VOICE=zh-CN-YunjianNeural
VG_RATE=-4%

# 字幕字体（需系统已安装）
# Windows 可用：Source Han Sans SC / 思源黑体 / Microsoft YaHei
VG_FONT=Noto Sans CJK SC

# 成片编码（可选，不填走默认）
# VG_CRF 越大文件越小，18–28 合理；23 对空镜+字幕肉眼几乎无损
VG_CRF=23
VG_PRESET=medium
VG_AUDIO_BITRATE=128k
