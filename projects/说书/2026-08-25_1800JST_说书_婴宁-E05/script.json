{
  "id": "liaozhai-E05-yingning",
  "title": "第 5 期《婴宁》",
  "lines": [
    {
      "no": 1,
      "act": "冷开场",
      "text": "有一种夸奖，听着是好话。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 2,
      "act": "冷开场",
      "text": "说这个人现在稳了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 3,
      "act": "冷开场",
      "text": "以前咋咋呼呼的，心里搁不住事，什么都往外说。现在稳了，懂事了，让人放心了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 4,
      "act": "冷开场",
      "text": "说这话的人，一般不会再往下问一句。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 5,
      "act": "冷开场",
      "text": "他是哪一天开始稳的。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 6,
      "act": "冷开场",
      "text": "那一天，出过什么事。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 7,
      "act": "冷开场",
      "text": "今天讲《婴宁》。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 8,
      "act": "冷开场",
      "text": "蒲松龄写了将近五百个故事，几百个女子。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 9,
      "act": "冷开场",
      "text": "只有一个，是靠笑出名的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 10,
      "act": "冷开场",
      "text": "她从出场就在笑。见了生人笑，被人说也笑，拜堂拜不下去，还是笑。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 11,
      "act": "冷开场",
      "text": "婆家拿她没办法。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 12,
      "act": "冷开场",
      "text": "后来官司都上了门。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 13,
      "act": "冷开场",
      "text": "然后有一天，她不笑了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 14,
      "act": "冷开场",
      "text": "一辈子再没笑过。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 15,
      "act": "冷开场",
      "text": "有人故意逗她，她也不笑。可她也不见愁，整天看着还是好好的。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 16,
      "act": "冷开场",
      "text": "这一期要讲的，不是她为什么笑。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 17,
      "act": "冷开场",
      "text": "是她哪一天，把笑收了起来。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 18,
      "act": "引入",
      "text": "先说这个人。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 19,
      "act": "引入",
      "text": "王子服，山东莒县罗店人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 20,
      "act": "引入",
      "text": "父亲死得早，家里只剩一个母亲。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 21,
      "act": "引入",
      "text": "母亲把他看得很重。重到什么地步——十四岁就进了学，人也生得干净，来说亲的踏破门槛，母亲一个都看不上。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 22,
      "act": "引入",
      "text": "后来总算定了一门，姓萧的姑娘。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 23,
      "act": "引入",
      "text": "没等过门，姑娘病死了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 24,
      "act": "引入",
      "text": "从那以后，王子服的婚事就搁下来了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 25,
      "act": "引入",
      "text": "母亲着急。王子服自己倒不怎么着急。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 26,
      "act": "引入",
      "text": "蒲松龄给他下了两个字，绝惠。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 27,
      "act": "引入",
      "text": "极聪明，但不大跟人来往。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 28,
      "act": "引入",
      "text": "这样的人有个毛病：一件事进了心里，外人看不出来，他自己也拔不出来。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 29,
      "act": "引入",
      "text": "母亲私下跟人说过一句话。说这孩子哪儿都好，就是从来不让人知道他心里想什么。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 30,
      "act": "引入",
      "text": "这句话，那一年就应验了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 31,
      "act": "引入",
      "text": "事情出在正月十五。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 32,
      "act": "引入",
      "text": "那一天是上元节，城里放灯。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 33,
      "act": "引入",
      "text": "对当时的姑娘家来说，一年到头能光明正大上街的日子，掰着手指头数得过来。上元节是其中一天。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 34,
      "act": "引入",
      "text": "所以那天街上，人特别多。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 35,
      "act": "引入",
      "text": "王子服的表兄吴生来叫他，说一块儿去看灯。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 36,
      "act": "引入",
      "text": "两个人就出了门。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 37,
      "act": "引入",
      "text": "这一趟灯，把王子服后半辈子的事，全定了。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 38,
      "act": "幕一 · 拈梅",
      "text": "灯市上人挤人。走了没多远，吴生被熟人叫走了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 39,
      "act": "幕一 · 拈梅",
      "text": "王子服一个人留在街边。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 40,
      "act": "幕一 · 拈梅",
      "text": "就是这个时候，他看见了那个女郎。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 41,
      "act": "幕一 · 拈梅",
      "text": "女郎带着一个丫头，手里拈着一枝梅花。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 42,
      "act": "幕一 · 拈梅",
      "text": "不是捧着，是拈着——两根指头夹住花梗，一边走一边转。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 43,
      "act": "幕一 · 拈梅",
      "text": "蒲松龄形容她容华绝代。这四个字他在别处也用过，不算稀奇。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 44,
      "act": "幕一 · 拈梅",
      "text": "稀奇的是后面那四个字：笑容可掬。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 45,
      "act": "幕一 · 拈梅",
      "text": "不是笑起来好看的意思。是那个笑就挂在脸上，像捧在手里的一样东西，她走到哪儿就捧到哪儿。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 46,
      "act": "幕一 · 拈梅",
      "text": "王子服看住了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 47,
      "act": "幕一 · 拈梅",
      "text": "他不是那种会盯着姑娘看的人。可他那天就是没挪开眼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 48,
      "act": "幕一 · 拈梅",
      "text": "女郎也发现了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 49,
      "act": "幕一 · 拈梅",
      "text": "她没有躲，也没有低头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 50,
      "act": "幕一 · 拈梅",
      "text": "她转过脸去，对自己的丫头说了一句话。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 51,
      "act": "幕一 · 拈梅",
      "text": "说到这儿要引一句原话。这是婴宁在整篇里说的第一句话，也是她的名片。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 52,
      "act": "幕一 · 拈梅",
      "text": "蒲松龄写的是——",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 53,
      "act": "幕一 · 拈梅",
      "text": "「个儿郎目灼灼似贼！」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 54,
      "act": "幕一 · 拈梅",
      "text": "翻成今天的话：这小子眼睛亮得像个贼。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 55,
      "act": "幕一 · 拈梅",
      "text": "这句话是说给丫头听的。可她一点没压着声音。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 56,
      "act": "幕一 · 拈梅",
      "text": "正好让王子服听见。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 57,
      "act": "幕一 · 拈梅",
      "text": "说完，她笑着走了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 58,
      "act": "幕一 · 拈梅",
      "text": "走出去几步，手一松，那枝梅花掉在地上。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 59,
      "act": "幕一 · 拈梅",
      "text": "她没有回头。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 60,
      "act": "幕一 · 拈梅",
      "text": "王子服等她走远了，过去把花捡了起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 61,
      "act": "幕一 · 拈梅",
      "text": "回家以后，他就病了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 62,
      "act": "幕一 · 拈梅",
      "text": "不是发烧，也不是咳嗽。是不说话，也不吃饭。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 63,
      "act": "幕一 · 拈梅",
      "text": "那枝花被他藏在枕头底下。他脸朝里躺着，谁问都不应。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 64,
      "act": "幕一 · 拈梅",
      "text": "母亲吓坏了。请大夫，大夫说不出名堂。请人来禳解，也不管用。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 65,
      "act": "幕一 · 拈梅",
      "text": "人一天天瘦下去。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 66,
      "act": "幕一 · 拈梅",
      "text": "吴生听说了，过来看他。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 67,
      "act": "幕一 · 拈梅",
      "text": "吴生一看就明白了七八分。哄着问了半天，王子服才把上元那天的事说了出来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 68,
      "act": "幕一 · 拈梅",
      "text": "吴生想了想，说了一句谎话。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 69,
      "act": "幕一 · 拈梅",
      "text": "那是你姑姑家的女儿，论辈分是你的姨妹，姓秦，住在西南山里。",
      "who": "二郎",
      "beat": "常规"
    },
    {
      "no": 70,
      "act": "幕一 · 拈梅",
      "text": "这句话是他当场编的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 71,
      "act": "幕一 · 拈梅",
      "text": "他只是想让这个人先把饭吃了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 72,
      "act": "幕一 · 拈梅",
      "text": "王子服听完，当场从床上坐了起来。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 73,
      "act": "幕一 · 拈梅",
      "text": "从那天起他能吃饭了，气色一天比一天好。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 74,
      "act": "幕一 · 拈梅",
      "text": "母亲以为儿子好了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 75,
      "act": "幕一 · 拈梅",
      "text": "过了些日子，吴生又来。这一回他是硬着头皮来的。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 76,
      "act": "幕一 · 拈梅",
      "text": "我上回是骗你的。姑姑家没有这么个女儿。",
      "who": "二郎",
      "beat": "常规"
    },
    {
      "no": 77,
      "act": "幕一 · 拈梅",
      "text": "王子服听完，没有闹。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 78,
      "act": "幕一 · 拈梅",
      "text": "他只是重新躺了回去。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 79,
      "act": "幕一 · 拈梅",
      "text": "这一躺，比上一回还沉。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 80,
      "act": "幕二 · 寻村",
      "text": "王子服这一回，谁也没说。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 81,
      "act": "幕二 · 寻村",
      "text": "他连母亲都瞒着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 82,
      "act": "幕二 · 寻村",
      "text": "自己揣了一点钱，一个人出了城，往西南走。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 83,
      "act": "幕二 · 寻村",
      "text": "吴生那句谎话里只有一个地名：西南山里。他就照着这四个字走。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 84,
      "act": "幕二 · 寻村",
      "text": "山路越走越窄。走了三十多里，两边全是山，一层压着一层，路上一个人也没有。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 85,
      "act": "幕二 · 寻村",
      "text": "只有鸟从这边山飞到那边山。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 86,
      "act": "幕二 · 寻村",
      "text": "到了半晌午，他看见山谷底下有一片村子。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 87,
      "act": "幕二 · 寻村",
      "text": "不大，也就十几户。可是那一片全是树，全是花，从谷底一直漫到坡上。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 88,
      "act": "幕二 · 寻村",
      "text": "他往下走，走到一户人家门口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 89,
      "act": "幕二 · 寻村",
      "text": "那家的门朝北开。门前一排柳树，垂到地上。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 90,
      "act": "幕二 · 寻村",
      "text": "墙里头探出来的是桃花和杏花，密得看不见枝子。中间夹着几竿竹子。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 91,
      "act": "幕二 · 寻村",
      "text": "鸟在里面叫，叽叽喳喳的，没个停。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 92,
      "act": "幕二 · 寻村",
      "text": "王子服站在门口，没敢敲。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 93,
      "act": "幕二 · 寻村",
      "text": "他绕到对面，那儿有一块大石头。他坐下歇脚。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 94,
      "act": "幕二 · 寻村",
      "text": "坐了没多久，墙里头有个女声喊了一句人名。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 95,
      "act": "幕二 · 寻村",
      "text": "喊的是小荣。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 96,
      "act": "幕二 · 寻村",
      "text": "声音又细又亮，尾音是往上翘的。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 97,
      "act": "幕二 · 寻村",
      "text": "王子服还没回过神，一个女子从东边走到西边。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 98,
      "act": "幕二 · 寻村",
      "text": "手里拿着一朵杏花，低着头往鬓角上插。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 99,
      "act": "幕二 · 寻村",
      "text": "插到一半，她抬了头。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 100,
      "act": "幕二 · 寻村",
      "text": "看见了他。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 101,
      "act": "幕二 · 寻村",
      "text": "她没有喊，也没有跑。愣了一下，然后就笑了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 102,
      "act": "幕二 · 寻村",
      "text": "笑得停不住，一边笑一边拿袖子挡着嘴，转身进屋去了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 103,
      "act": "幕二 · 寻村",
      "text": "那朵杏花没插稳，掉在地上。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 104,
      "act": "幕二 · 寻村",
      "text": "王子服认出来了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 105,
      "act": "幕二 · 寻村",
      "text": "就是上元节那天的那个人。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 106,
      "act": "幕二 · 寻村",
      "text": "他不敢走了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 107,
      "act": "幕二 · 寻村",
      "text": "他在那块石头上，从半晌午坐到中午，又从中午坐到日头偏西。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 108,
      "act": "幕二 · 寻村",
      "text": "一口东西没吃，也不觉得饿。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 109,
      "act": "幕二 · 寻村",
      "text": "墙里头时不时传出一阵笑。他就往那边看一眼。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 110,
      "act": "幕二 · 寻村",
      "text": "后来那女子又出来过一次，站在墙边，像是要笑，又忍了回去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 111,
      "act": "幕二 · 寻村",
      "text": "再后来，一个老太太拄着拐从门里出来了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 112,
      "act": "幕二 · 寻村",
      "text": "老太太耳朵背，问话要人大声答。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 113,
      "act": "幕二 · 寻村",
      "text": "小郎君是从哪里来的？",
      "who": "老太太",
      "beat": "常规"
    },
    {
      "no": 114,
      "act": "幕二 · 寻村",
      "text": "我是来寻亲的。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 115,
      "act": "幕二 · 寻村",
      "text": "你姓什么？",
      "who": "老太太",
      "beat": "常规"
    },
    {
      "no": 116,
      "act": "幕二 · 寻村",
      "text": "王子服站起来，把嗓子提到最高。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 117,
      "act": "幕二 · 寻村",
      "text": "我姓王，莒县罗店人。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 118,
      "act": "幕二 · 寻村",
      "text": "老太太一听这个姓，愣住了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 119,
      "act": "幕二 · 寻村",
      "text": "她问了他母亲娘家的姓，又问了他母亲在姊妹里行几。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 120,
      "act": "幕二 · 寻村",
      "text": "问完，她笑了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 121,
      "act": "幕二 · 寻村",
      "text": "那你就是我姐姐的儿子。我是你姨。",
      "who": "老太太",
      "beat": "揭底"
    },
    {
      "no": 122,
      "act": "幕二 · 寻村",
      "text": "王子服站在门口，半天说不出话来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 123,
      "act": "幕二 · 寻村",
      "text": "吴生随口编的一句谎话，他走了三十里山路，走成了真的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 124,
      "act": "幕二 · 寻村",
      "text": "老太太把他让了进去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 125,
      "act": "幕二 · 寻村",
      "text": "门里一条白石头砌的路，落着红花瓣，一直绕到西边。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 126,
      "act": "幕二 · 寻村",
      "text": "再开一道门，满院子的豆棚和花架。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 127,
      "act": "幕二 · 寻村",
      "text": "那笑声，就是从这个院子里出来的。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 128,
      "act": "幕三 · 花与笑",
      "text": "老太太把王子服留了下来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 129,
      "act": "幕三 · 花与笑",
      "text": "饭桌上她叫了一声婴宁。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 130,
      "act": "幕三 · 花与笑",
      "text": "外面那个笑声进了屋。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 131,
      "act": "幕三 · 花与笑",
      "text": "婴宁一进门就在笑，捂着嘴，肩膀一抖一抖。老太太让她见过表兄，她刚要行礼，笑又上来了，礼行到一半就散了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 132,
      "act": "幕三 · 花与笑",
      "text": "有客人在，笑成什么样子。",
      "who": "老太太",
      "beat": "常规"
    },
    {
      "no": 133,
      "act": "幕三 · 花与笑",
      "text": "婴宁把笑忍住了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 134,
      "act": "幕三 · 花与笑",
      "text": "忍了大概两口气。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 135,
      "act": "幕三 · 花与笑",
      "text": "然后笑得比刚才还厉害，转身跑到墙角去，背对着人，肩膀还在抖。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 136,
      "act": "幕三 · 花与笑",
      "text": "老太太没辙，摇摇头，只当没看见。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 137,
      "act": "幕三 · 花与笑",
      "text": "王子服在旁边坐着，一句话都插不上。可他心里头压了两个月的那块石头，就在那一刻落了地。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 138,
      "act": "幕三 · 花与笑",
      "text": "第二天，婴宁带他去看院子后面。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 139,
      "act": "幕三 · 花与笑",
      "text": "那院子有多少花，王子服数不过来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 140,
      "act": "幕三 · 花与笑",
      "text": "婴宁走在前头，看见一朵好的就摘，摘了往头上插，插满了再往手里拿。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 141,
      "act": "幕三 · 花与笑",
      "text": "一路走一路笑。笑没有理由，看见花笑，看见石头也笑。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 142,
      "act": "幕三 · 花与笑",
      "text": "王子服跟在后面，从袖子里掏出一样东西。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 143,
      "act": "幕三 · 花与笑",
      "text": "是上元节那天的那枝梅花。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 144,
      "act": "幕三 · 花与笑",
      "text": "在枕头底下压了两个多月，已经干了，一碰就掉渣。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 145,
      "act": "幕三 · 花与笑",
      "text": "婴宁接过去看了看。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 146,
      "act": "幕三 · 花与笑",
      "text": "这花都枯了，你留着它做什么？",
      "who": "笑娘",
      "beat": "常规"
    },
    {
      "no": 147,
      "act": "幕三 · 花与笑",
      "text": "这是上元那天你丢下的。我一直留着，是因为想着你。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 148,
      "act": "幕三 · 花与笑",
      "text": "都是自家人，有什么可谢的。等你走的时候，我叫园丁折一大捆送你。",
      "who": "笑娘",
      "beat": "常规"
    },
    {
      "no": 149,
      "act": "幕三 · 花与笑",
      "text": "我不是要花。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 150,
      "act": "幕三 · 花与笑",
      "text": "那你要什么？",
      "who": "笑娘",
      "beat": "常规"
    },
    {
      "no": 151,
      "act": "幕三 · 花与笑",
      "text": "我说的想着你，不是兄妹那样的想。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 152,
      "act": "幕三 · 花与笑",
      "text": "兄妹那样的想，跟别的想，有什么不一样？",
      "who": "笑娘",
      "beat": "常规"
    },
    {
      "no": 153,
      "act": "幕三 · 花与笑",
      "text": "兄妹是白天在一处。夫妻是夜里也在一处。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 154,
      "act": "幕三 · 花与笑",
      "text": "婴宁低下头，想了很久。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 155,
      "act": "幕三 · 花与笑",
      "text": "是真的很久。王子服站在那儿，一颗心提到了嗓子眼。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 156,
      "act": "幕三 · 花与笑",
      "text": "我不习惯跟生人一块儿睡。",
      "who": "笑娘",
      "beat": "揭底"
    },
    {
      "no": 157,
      "act": "幕三 · 花与笑",
      "text": "话音刚落，丫头小荣从外面进来了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 158,
      "act": "幕三 · 花与笑",
      "text": "王子服吓得赶紧退开两步。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 159,
      "act": "幕三 · 花与笑",
      "text": "婴宁却像是想起了什么，转身就往屋里走。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 160,
      "act": "幕三 · 花与笑",
      "text": "到了老太太跟前，她一五一十全说了。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 161,
      "act": "幕三 · 花与笑",
      "text": "娘，大哥说他要跟我一块儿睡。",
      "who": "笑娘",
      "beat": "揭底"
    },
    {
      "no": 162,
      "act": "幕三 · 花与笑",
      "text": "王子服恨不得钻到地缝里去。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 163,
      "act": "幕三 · 花与笑",
      "text": "老太太耳朵背，没听清，还追着问了一遍。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 164,
      "act": "幕三 · 花与笑",
      "text": "王子服在旁边直摆手。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 165,
      "act": "幕三 · 花与笑",
      "text": "这件事，后来是老太太做主定下来的。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 166,
      "act": "幕三 · 花与笑",
      "text": "那天晚上，老太太单独跟王子服说了一段话。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 167,
      "act": "幕三 · 花与笑",
      "text": "这孩子不是我生的。她的母亲是狐，生下她就走了，把她托给了我。我养了她十几年。",
      "who": "老太太",
      "beat": "贴近"
    },
    {
      "no": 168,
      "act": "幕三 · 花与笑",
      "text": "她没爹没娘，就是有点憨。十六七的人了，心还像个婴儿。",
      "who": "老太太",
      "beat": "贴近"
    },
    {
      "no": 169,
      "act": "幕三 · 花与笑",
      "text": "你带她回去，好好教她。她不懂的事情多着呢。",
      "who": "老太太",
      "beat": "贴近"
    },
    {
      "no": 170,
      "act": "幕三 · 花与笑",
      "text": "王子服一口应下。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 171,
      "act": "幕三 · 花与笑",
      "text": "那几天他没想别的。他只想着，那个在灯市上笑着走远的人，要跟他回家了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 172,
      "act": "幕三 · 花与笑",
      "text": "第三天，吴生找上门来了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 173,
      "act": "幕三 · 花与笑",
      "text": "家里两个月没见着人，母亲急得报了官，最后还是托吴生一路问过来的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 174,
      "act": "幕三 · 花与笑",
      "text": "吴生进门，看见王子服和婴宁站在一处，一句话没说出来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 175,
      "act": "幕三 · 花与笑",
      "text": "老太太把婴宁交给了他们。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 176,
      "act": "幕三 · 花与笑",
      "text": "下山那天，婴宁一路都在笑。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 177,
      "act": "幕三 · 花与笑",
      "text": "她笑的时候，山里的鸟跟着叫。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 178,
      "act": "幕三 · 花与笑",
      "text": "那是她这辈子笑得最松的一段路。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 179,
      "act": "幕四 · 一笑成祸",
      "text": "到了罗店，母亲第一眼就喜欢这个媳妇。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 180,
      "act": "幕四 · 一笑成祸",
      "text": "问了几句，婴宁笑着答，答得也没什么章法，可母亲不在意。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 181,
      "act": "幕四 · 一笑成祸",
      "text": "这个家空了好几年，现在有人笑了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 182,
      "act": "幕四 · 一笑成祸",
      "text": "拜堂那天出了点岔子。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 183,
      "act": "幕四 · 一笑成祸",
      "text": "司仪唱到一半，婴宁笑了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 184,
      "act": "幕四 · 一笑成祸",
      "text": "一笑就拜不下去，得等她缓过来再来一遍。缓了好几回，礼才算成。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 185,
      "act": "幕四 · 一笑成祸",
      "text": "按规矩这是失仪。可满堂的人，没有一个不高兴的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 186,
      "act": "幕四 · 一笑成祸",
      "text": "蒲松龄写她笑起来的样子，用了六个字：狂而不损其媚。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 187,
      "act": "幕四 · 一笑成祸",
      "text": "疯是疯，可不难看。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 188,
      "act": "幕四 · 一笑成祸",
      "text": "从那以后，这个笑就传开了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 189,
      "act": "幕四 · 一笑成祸",
      "text": "邻家的姑娘媳妇，隔三差五找个借口过来，来了就想法子逗她笑。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 190,
      "act": "幕四 · 一笑成祸",
      "text": "婆婆拿她没办法。骂过，她当时收住，转脸又笑。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 191,
      "act": "幕四 · 一笑成祸",
      "text": "罚也罚过。罚完了她还是笑。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 192,
      "act": "幕四 · 一笑成祸",
      "text": "后来母亲也就不罚了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 193,
      "act": "幕四 · 一笑成祸",
      "text": "母亲试过她一回。她想弄清楚这孩子是真憨，还是装的。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 194,
      "act": "幕四 · 一笑成祸",
      "text": "母亲问她在山里过的是什么日子。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 195,
      "act": "幕四 · 一笑成祸",
      "text": "山里没什么人来。我想笑就笑。",
      "who": "笑娘",
      "beat": "揭底"
    },
    {
      "no": 196,
      "act": "幕四 · 一笑成祸",
      "text": "试完，母亲心里有数了：这孩子于人情世故，是真的一点不懂。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 197,
      "act": "幕四 · 一笑成祸",
      "text": "不懂什么话该说，什么话不该说。不懂谁的脸色是什么意思。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 198,
      "act": "幕四 · 一笑成祸",
      "text": "她只知道，高兴了就笑。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 199,
      "act": "幕四 · 一笑成祸",
      "text": "婴宁还有一样，是爱花。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 200,
      "act": "幕四 · 一笑成祸",
      "text": "爱到什么地步——亲戚家有好花种，她一家一家去问，问到了就要。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 201,
      "act": "幕四 · 一笑成祸",
      "text": "家里没这么多闲钱给她买花，她把自己的金钗偷偷当了，拿钱去换花种。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 202,
      "act": "幕四 · 一笑成祸",
      "text": "几个月下来，台阶上、墙根下、连茅厕边上，全是花。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 203,
      "act": "幕四 · 一笑成祸",
      "text": "王子服由着她。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 204,
      "act": "幕四 · 一笑成祸",
      "text": "她高兴就好。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 205,
      "act": "幕四 · 一笑成祸",
      "text": "家里后院有一架木香，长得很旺，一直爬上了墙头，把那一段墙都盖住了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 206,
      "act": "幕四 · 一笑成祸",
      "text": "婴宁常常爬到架子上去摘花，摘了往头上插。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 207,
      "act": "幕四 · 一笑成祸",
      "text": "坏就坏在这一架花上。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 208,
      "act": "幕四 · 一笑成祸",
      "text": "西边邻居家的儿子，有一天从墙外过，抬头看见了墙头上的人。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 209,
      "act": "幕四 · 一笑成祸",
      "text": "那女子在笑。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 210,
      "act": "幕四 · 一笑成祸",
      "text": "他站住了，挪不动脚。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 211,
      "act": "幕四 · 一笑成祸",
      "text": "婴宁看见他，也没有避开。她低头看着这个人，还是在笑。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 212,
      "act": "幕四 · 一笑成祸",
      "text": "那个笑，在她那儿什么也不是。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 213,
      "act": "幕四 · 一笑成祸",
      "text": "在墙下那个人眼里，是另一件事。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 214,
      "act": "幕四 · 一笑成祸",
      "text": "他以为她的意思是答应了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 215,
      "act": "幕四 · 一笑成祸",
      "text": "婴宁伸手往墙下指了一指，转身下去了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 216,
      "act": "幕四 · 一笑成祸",
      "text": "她指的那个地方，立着一段枯木。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 217,
      "act": "幕四 · 一笑成祸",
      "text": "那天夜里，西邻子照着约定去了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 218,
      "act": "幕四 · 一笑成祸",
      "text": "婴宁事先把那段枯木挪到了她本该站的位置上。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 219,
      "act": "幕四 · 一笑成祸",
      "text": "木头是空心的。里面藏着一只蝎子。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 220,
      "act": "幕四 · 一笑成祸",
      "text": "那个人把手伸了进去，被螫了一下。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 221,
      "act": "幕四 · 一笑成祸",
      "text": "他喊了一声，跑回了家。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 222,
      "act": "幕四 · 一笑成祸",
      "text": "第二天，人死了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 223,
      "act": "幕四 · 一笑成祸",
      "text": "到这一步，事情就不再是笑不笑的事了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 224,
      "act": "幕四 · 一笑成祸",
      "text": "西邻的老头一纸状子告到县里，说王家藏着妖物。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 225,
      "act": "幕四 · 一笑成祸",
      "text": "状子递上去的时候，母亲还不知道这件事跟婴宁有关。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 226,
      "act": "幕四 · 一笑成祸",
      "text": "县令认得王子服，知道他是个规矩读书人，看完状子就认定是诬告。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 227,
      "act": "幕四 · 一笑成祸",
      "text": "县令要打这个老头的板子。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 228,
      "act": "幕四 · 一笑成祸",
      "text": "还是王子服替他求了情，人才放了回去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 229,
      "act": "幕四 · 一笑成祸",
      "text": "案子了了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 230,
      "act": "幕四 · 一笑成祸",
      "text": "可这个家，从那天起就不一样了。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 231,
      "act": "幕五 · 不复笑",
      "text": "母亲把婴宁叫到了跟前。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 232,
      "act": "幕五 · 不复笑",
      "text": "那天家里没有别人。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 233,
      "act": "幕五 · 不复笑",
      "text": "蒲松龄把母亲的话记了下来。这段话是全篇最要紧的地方，我把它说完整。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 234,
      "act": "幕五 · 不复笑",
      "text": "母亲先说了她的憨。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 235,
      "act": "幕五 · 不复笑",
      "text": "这样疯疯癫癫的，我早就知道。笑得太过了头，后面是要伏着祸的。",
      "who": "妇人",
      "beat": "常规"
    },
    {
      "no": 236,
      "act": "幕五 · 不复笑",
      "text": "这一回是碰上县太爷明白，没牵累到咱们家。要是换个糊涂官，是要把媳妇传到公堂上去对质的。",
      "who": "妇人",
      "beat": "常规"
    },
    {
      "no": 237,
      "act": "幕五 · 不复笑",
      "text": "到那时候，我儿还有什么脸见街坊四邻。",
      "who": "妇人",
      "beat": "落定"
    },
    {
      "no": 238,
      "act": "幕五 · 不复笑",
      "text": "婴宁听完，脸上的笑没有了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 239,
      "act": "幕五 · 不复笑",
      "text": "她站直了，很认真地应了一句，说她从今往后不笑了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 240,
      "act": "幕五 · 不复笑",
      "text": "母亲叹了口气。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 241,
      "act": "幕五 · 不复笑",
      "text": "母亲接着说的那一句，是这一篇里最好的一句。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 242,
      "act": "幕五 · 不复笑",
      "text": "原话是这么写的——",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 243,
      "act": "幕五 · 不复笑",
      "text": "「人罔不笑，但须有时。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 244,
      "act": "幕五 · 不复笑",
      "text": "人没有不笑的。只是得看时候。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 245,
      "act": "幕五 · 不复笑",
      "text": "这句话说得很温和。母亲是好意，讲的也确实是对的道理。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 246,
      "act": "幕五 · 不复笑",
      "text": "可这句话落到婴宁耳朵里，剩下的只有后半句。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 247,
      "act": "幕五 · 不复笑",
      "text": "从那天起，婴宁真的不笑了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 248,
      "act": "幕五 · 不复笑",
      "text": "家里人拿最好笑的事去逗她，她也不笑。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 249,
      "act": "幕五 · 不复笑",
      "text": "一次都没有。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 250,
      "act": "幕五 · 不复笑",
      "text": "但她也不哭，也不闹，整天看着还是好好的。该做的事照做，该说的话照说。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 251,
      "act": "幕五 · 不复笑",
      "text": "只是那张脸上，什么也没有了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 252,
      "act": "幕五 · 不复笑",
      "text": "过了些日子，一天晚上，她忽然对着王子服掉起眼泪来。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 253,
      "act": "幕五 · 不复笑",
      "text": "王子服吓坏了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 254,
      "act": "幕五 · 不复笑",
      "text": "我一直没敢跟你说。跟你们相处的日子浅，说出来怕吓着你。",
      "who": "笑娘",
      "beat": "贴近"
    },
    {
      "no": 255,
      "act": "幕五 · 不复笑",
      "text": "我本来是狐生的。我娘临走的时候，把我托给了鬼母。",
      "who": "笑娘",
      "beat": "贴近"
    },
    {
      "no": 256,
      "act": "幕五 · 不复笑",
      "text": "说到这儿要交代一句：鬼母就是山里那个老太太。她不是人，也不是狐，她是鬼。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 257,
      "act": "幕五 · 不复笑",
      "text": "她带了我十几年，我才有今天。她一个人埋在山里，没人管，也没人跟她合葬。",
      "who": "笑娘",
      "beat": "贴近"
    },
    {
      "no": 258,
      "act": "幕五 · 不复笑",
      "text": "我每想一回，心里就疼一回。",
      "who": "笑娘",
      "beat": "贴近"
    },
    {
      "no": 259,
      "act": "幕五 · 不复笑",
      "text": "你要是不嫌费事，把她跟我父亲合葬了吧。这样往后生了女儿的人家，也不至于狠心把女儿扔掉。",
      "who": "笑娘",
      "beat": "贴近"
    },
    {
      "no": 260,
      "act": "幕五 · 不复笑",
      "text": "王子服答应了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 261,
      "act": "幕五 · 不复笑",
      "text": "第二天他就带着人进了山。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 262,
      "act": "幕五 · 不复笑",
      "text": "他本来还担心找不着坟。婴宁说不用愁。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 263,
      "act": "幕五 · 不复笑",
      "text": "到了地方，果然找着了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 264,
      "act": "幕五 · 不复笑",
      "text": "那天他们把鬼母的棺木起出来，迁到秦家墓边上，跟婴宁的父亲合了葬。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 265,
      "act": "幕五 · 不复笑",
      "text": "事情办完，婴宁在坟前哭了很久。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 266,
      "act": "幕五 · 不复笑",
      "text": "那是她这辈子第一次哭。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 267,
      "act": "幕五 · 不复笑",
      "text": "也是仅有的一次，把心里的东西放到脸上来。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 268,
      "act": "幕五 · 不复笑",
      "text": "后来婴宁生了个儿子。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 269,
      "act": "幕五 · 不复笑",
      "text": "孩子还在襁褓里，见了生人不怕，谁抱都行。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 270,
      "act": "幕五 · 不复笑",
      "text": "见人就笑。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 271,
      "act": "幕五 · 不复笑",
      "text": "蒲松龄写这一句的时候，用了四个字：大有母风。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 272,
      "act": "收束",
      "text": "蒲松龄在故事后面写了一段话。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 273,
      "act": "收束",
      "text": "他说，看婴宁那样一天到晚傻笑，好像一点心眼都没有。可是墙底下那一手，谁又比她更狠。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 274,
      "act": "收束",
      "text": "最后他给了一句断语。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 275,
      "act": "收束",
      "text": "原话是这么写的——",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 276,
      "act": "收束",
      "text": "「我婴宁殆隐于笑者矣。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 277,
      "act": "收束",
      "text": "我的婴宁，大概是个把自己藏在笑里面的人。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 278,
      "act": "收束",
      "text": "这句话好。可它只说到了一半。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 279,
      "act": "收束",
      "text": "藏，是自己要藏。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 280,
      "act": "收束",
      "text": "婴宁不是藏。她从山里下来的时候，什么都没藏着。高兴就笑，看见花笑，看见人也笑。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 281,
      "act": "收束",
      "text": "在那个只有花和鸟的山谷里，笑不用挑时候。因为笑了，也不会落到谁头上。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 282,
      "act": "收束",
      "text": "下了山，笑开始有人接着了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 283,
      "act": "收束",
      "text": "拜堂那天她笑，一屋子人跟着高兴。这一笔没人跟她算。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 284,
      "act": "收束",
      "text": "墙头上那一笑，账就来了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 285,
      "act": "收束",
      "text": "死了一个人。一张状子递到县里。差一点，她就要站到公堂上去。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 286,
      "act": "收束",
      "text": "然后婆婆把她叫过去，跟她把这笔账算了一遍。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 287,
      "act": "收束",
      "text": "婆婆没有骂她。婆婆讲的是道理，而且是对的道理——人没有不笑的，只是得看时候。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 288,
      "act": "收束",
      "text": "也就是从那句话起，婴宁的每一次笑，前面都多了一道手续：现在是不是时候。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 289,
      "act": "收束",
      "text": "一件事只要开始算，它就不是原来那件事了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 290,
      "act": "收束",
      "text": "放到今天也是一样。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 291,
      "act": "收束",
      "text": "刚进公司的年轻人什么都敢说，遇上事先笑一声，大家说这孩子有活力。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 292,
      "act": "收束",
      "text": "直到有一次，一句玩笑捅了篓子，被叫进屋里谈了一回。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 293,
      "act": "收束",
      "text": "谈话的人也是好意，讲的也是对的道理。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 294,
      "act": "收束",
      "text": "从那以后，他开口之前先要把一屋子的脸色扫一圈。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 295,
      "act": "收束",
      "text": "同事说他成熟了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 296,
      "act": "收束",
      "text": "让一个人不笑的，从来不是那件事本身，是有人告诉她——这一笑，是要有人替她赔的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 297,
      "act": "收束",
      "text": "这个东西古人有个叫法，叫懂事。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 298,
      "act": "收束",
      "text": "懂事不是长大。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 299,
      "act": "收束",
      "text": "懂事是发现自己有些反应会给别人惹麻烦，于是把那一部分收起来。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 300,
      "act": "收束",
      "text": "收起来的东西不会喊疼。所以从外面看，什么都没少。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 301,
      "act": "收束",
      "text": "婴宁后来一直没有再笑。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 302,
      "act": "收束",
      "text": "她生的那个孩子在襁褓里见人就笑，家里人都说，跟他娘一个样。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 303,
      "act": "收束",
      "text": "那时候已经没有人记得，上元节那天，有个姑娘手里拈着一枝梅花。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 304,
      "act": "收束",
      "text": "她一边走一边转那枝花，转到手一松，花掉在了地上。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 305,
      "act": "收束",
      "text": "她没有回头看那枝花落到了谁手里。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 306,
      "act": "收束",
      "text": "那是她最后一次，笑得什么都不用想。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 307,
      "act": "收束",
      "text": "下一期讲一个换心的故事。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 308,
      "act": "收束",
      "text": "真的换。开膛，取出来，换一颗。",
      "who": "说书人",
      "beat": "收"
    }
  ],
  "annotated": true
}
