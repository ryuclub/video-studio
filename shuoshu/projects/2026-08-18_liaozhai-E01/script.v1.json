{
  "id": "liaozhai-E01-huapi",
  "title": "第 1 期《画皮》",
  "lines": [
    {
      "no": 1,
      "act": "冷开场",
      "text": "这个故事里最吓人的一幕，不是杀人。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 2,
      "act": "冷开场",
      "text": "是化妆。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 3,
      "act": "冷开场",
      "text": "一只青脸的鬼，坐在床边，把一张人皮平平铺开，手里拿着彩笔，一笔一笔往上描——描眉毛，描眼睛，描嘴唇。描得很慢，很仔细，像个手艺人在做活。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 4,
      "act": "冷开场",
      "text": "描完了，把笔一扔，两只手抓起那张皮，像抖开一件衣裳那样抖了抖，往身上一披。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 5,
      "act": "冷开场",
      "text": "再抬起头来，就是一个绝色的美人。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 6,
      "act": "冷开场",
      "text": "蒲松龄写《聊斋志异》，写了将近五百个故事。传得最广的，就是这一个。名字叫《画皮》。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 7,
      "act": "冷开场",
      "text": "这个故事大家都听过名字。但真正的原文，比电影里狠得多。今天咱们从头讲。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 8,
      "act": "引入",
      "text": "故事发生在太原，主角姓王，书上没写他的名字，就叫他王生。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 9,
      "act": "引入",
      "text": "王生是个读书人，家里有妻子，姓陈。日子过得不算富，也不算穷，就是寻常人家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 10,
      "act": "引入",
      "text": "有一天天还没亮，王生出门赶早路。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 11,
      "act": "引入",
      "text": "天蒙蒙亮，路上没什么人，两边的树看着都是黑的。走着走着，前头出现一个人影。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 12,
      "act": "引入",
      "text": "是个年轻姑娘，怀里抱着个包袱，一个人急急忙忙地走。走得很吃力，包袱看着沉，脚下也不利索，走两步歇一步。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 13,
      "act": "引入",
      "text": "王生看她那个样子，心里就动了一下。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 14,
      "act": "引入",
      "text": "请你记住这一下心动。整个故事，就是从这里开始的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 15,
      "act": "引入",
      "text": "他快走几步赶上去。走近了一看——年纪大概十六七岁，模样漂亮得不像话。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 16,
      "act": "引入",
      "text": "王生就搭话了。他问：姑娘，天还没亮，一个人赶路，你这是要去哪儿？",
      "parts": [
        {
          "who": "说书人",
          "text": "王生就搭话了。他问：",
          "beat": "引述"
        },
        {
          "who": "书生",
          "text": "姑娘，天还没亮，一个人赶路，你这是要去哪儿？",
          "beat": "收"
        }
      ]
    },
    {
      "no": 17,
      "act": "幕一 · 遇",
      "text": "姑娘一听有人问，眼圈就红了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 18,
      "act": "幕一 · 遇",
      "text": "她说：先生赶您的路吧，问这些做什么。我这点苦，说了也没人替我担。",
      "parts": [
        {
          "who": "艳鬼",
          "text": "先生赶您的路吧，问这些做什么。我这点苦，说了也没人替我担。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 19,
      "act": "幕一 · 遇",
      "text": "你要是有什么难处，说出来，能帮的我帮。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 20,
      "act": "幕一 · 遇",
      "text": "姑娘停下脚步，这才开口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 21,
      "act": "幕一 · 遇",
      "text": "她说，我原是大户人家买来的妾。那家的正房太太容不下我，天天打骂，实在熬不下去了，趁天没亮跑出来的。",
      "parts": [
        {
          "who": "艳鬼",
          "text": "我原是大户人家买来的妾。那家的正房太太容不下我，天天打骂，实在熬不下去了，趁天没亮跑出来的。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 22,
      "act": "幕一 · 遇",
      "text": "那你打算上哪儿去？",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 23,
      "act": "幕一 · 遇",
      "text": "姑娘摇头。她说：跑出来的人，哪有地方去。走一步算一步吧。",
      "parts": [
        {
          "who": "说书人",
          "text": "姑娘摇头。",
          "beat": "引述"
        },
        {
          "who": "艳鬼",
          "text": "跑出来的人，哪有地方去。走一步算一步吧。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 24,
      "act": "幕一 · 遇",
      "text": "王生看她抱着包袱站在那儿，就说：我家离这儿不远。你要是不嫌弃，先到我家住下，慢慢再想办法。",
      "parts": [
        {
          "who": "说书人",
          "text": "王生看她抱着包袱站在那儿，就说：",
          "beat": "引述"
        },
        {
          "who": "书生",
          "text": "我家离这儿不远。你要是不嫌弃，先到我家住下，慢慢再想办法。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 25,
      "act": "幕一 · 遇",
      "text": "姑娘听了，抬起头看了他一眼。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 26,
      "act": "幕一 · 遇",
      "text": "就这一眼。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 27,
      "act": "幕一 · 遇",
      "text": "然后她答应了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 28,
      "act": "幕一 · 遇",
      "text": "王生伸手把包袱接过来，自己背着，领她回了家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 29,
      "act": "幕一 · 遇",
      "text": "到了家门口，他没让她走前院，从侧门进去，直接带到书房——那是他自己读书用的一间偏屋，平时家里人不去。安顿好，关上门。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 30,
      "act": "幕一 · 遇",
      "text": "从这天起，姑娘就住下了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 31,
      "act": "幕一 · 遇",
      "text": "王生每天往书房跑，一连好几天，家里谁也不知道院子里多了这么个人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 32,
      "act": "幕一 · 遇",
      "text": "后来实在瞒不住了，王生跟妻子陈氏说了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 33,
      "act": "幕一 · 遇",
      "text": "陈氏一听，眉头就皱起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 34,
      "act": "幕一 · 遇",
      "text": "她说：你想想，一个十六七岁的姑娘，天不亮一个人在路上跑，能是什么来路？多半是哪个大户人家的妾室逃出来的。人家找上门来，你怎么交代？",
      "parts": [
        {
          "who": "妇人",
          "text": "你想想，一个十六七岁的姑娘，天不亮一个人在路上跑，能是什么来路？多半是哪个大户人家的妾室逃出来的。人家找上门来，你怎么交代？",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 35,
      "act": "幕一 · 遇",
      "text": "她说：你赶紧把她送走。",
      "parts": [
        {
          "who": "妇人",
          "text": "你赶紧把她送走。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 36,
      "act": "幕一 · 遇",
      "text": "王生不听。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 37,
      "act": "幕一 · 遇",
      "text": "他说：一个弱女子无处可去，我不能见死不救。",
      "parts": [
        {
          "who": "书生",
          "text": "一个弱女子无处可去，我不能见死不救。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 38,
      "act": "幕一 · 遇",
      "text": "这话听着有理。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 39,
      "act": "幕一 · 遇",
      "text": "可你回头想想——他见到这姑娘的第一眼，动的是什么心？他自己心里最清楚。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 40,
      "act": "幕一 · 遇",
      "text": "陈氏劝了两回，劝不动，也就不说了。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 41,
      "act": "幕二 · 疑",
      "text": "日子一天天过。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 42,
      "act": "幕二 · 疑",
      "text": "有一天王生上街办事，走着走着，迎面来了一个道士。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 43,
      "act": "幕二 · 疑",
      "text": "那道士看见王生，愣住了。他停下脚步，从头到脚把王生打量了一遍，脸色变了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 44,
      "act": "幕二 · 疑",
      "text": "他问：你最近，遇上什么了？",
      "parts": [
        {
          "who": "老道",
          "text": "你最近，遇上什么了？",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 45,
      "act": "幕二 · 疑",
      "text": "没有啊。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 46,
      "act": "幕二 · 疑",
      "text": "你身上邪气缠着，一层一层的。你还说没有？",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 47,
      "act": "幕二 · 疑",
      "text": "王生心里咯噔一下。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 48,
      "act": "幕二 · 疑",
      "text": "但嘴上还是硬。他说：真没有。道士您认错人了。",
      "parts": [
        {
          "who": "说书人",
          "text": "但嘴上还是硬。",
          "beat": "引述"
        },
        {
          "who": "书生",
          "text": "真没有。道士您认错人了。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 49,
      "act": "幕二 · 疑",
      "text": "道士看着他，看了很久，摇了摇头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 50,
      "act": "幕二 · 疑",
      "text": "然后他说了一句话。这句话是全篇分量最重的一句，蒲松龄的原文是这么写的——",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 51,
      "act": "幕二 · 疑",
      "text": "「惑哉！世固有死将临而不悟者。」",
      "parts": [
        {
          "who": "老道",
          "text": "惑哉！世固有死将临而不悟者。",
          "beat": "引文"
        }
      ]
    },
    {
      "no": 52,
      "act": "幕二 · 疑",
      "text": "翻成白话就是：糊涂啊。这世上就是有这样的人，死到临头了，还不明白。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 53,
      "act": "幕二 · 疑",
      "text": "说完，道士走了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 54,
      "act": "幕二 · 疑",
      "text": "王生一个人站在街上。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 55,
      "act": "幕二 · 疑",
      "text": "他越想越不对劲。那道士的话，明明说的是他家里那个人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 56,
      "act": "幕二 · 疑",
      "text": "可他一想到那张脸，那双眼睛，心里又舍不得。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 57,
      "act": "幕二 · 疑",
      "text": "他对自己说：不对。一个大活人，天天在我眼皮底下，能是什么妖怪。",
      "parts": [
        {
          "who": "说书人",
          "text": "他对自己说：",
          "beat": "引述"
        },
        {
          "who": "书生",
          "text": "不对。一个大活人，天天在我眼皮底下，能是什么妖怪。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 58,
      "act": "幕二 · 疑",
      "text": "嘴上这么说，脚下已经往家里走了，而且越走越快。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 59,
      "act": "幕二 · 疑",
      "text": "回到家，他直接去书房。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 60,
      "act": "幕二 · 疑",
      "text": "手往门上一推——",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 61,
      "act": "幕二 · 疑",
      "text": "门从里面闩上了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 62,
      "act": "幕二 · 疑",
      "text": "王生站在门口，心跳得厉害。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 63,
      "act": "幕二 · 疑",
      "text": "他绕到屋子侧面，那儿有扇窗。窗纸上有个破口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 64,
      "act": "幕二 · 疑",
      "text": "王生凑过去，往里看。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 65,
      "act": "幕二 · 疑",
      "text": "他看见——",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 66,
      "act": "幕二 · 疑",
      "text": "屋里坐着一个鬼。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 67,
      "act": "幕二 · 疑",
      "text": "脸是青绿色的，牙齿又长又尖，一排排龇在外面，像锯子一样。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 68,
      "act": "幕二 · 疑",
      "text": "那鬼手里拿着一支彩笔。榻上铺着一张人皮：五官、四肢、手指头，整整齐齐，一张完完整整的人皮。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 69,
      "act": "幕二 · 疑",
      "text": "鬼低着头，正在往那张皮上画。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 70,
      "act": "幕二 · 疑",
      "text": "画眉毛。画眼睛。画嘴唇。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 71,
      "act": "幕二 · 疑",
      "text": "画得很慢，很仔细。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 72,
      "act": "幕二 · 疑",
      "text": "画完了，笔往地上一扔。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 73,
      "act": "幕二 · 疑",
      "text": "两只手抓起那张人皮，抖开——就那么一抖，像抖开一件穿了一天的衣裳。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 74,
      "act": "幕二 · 疑",
      "text": "往身上一披。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 75,
      "act": "幕二 · 疑",
      "text": "站起来的，就是那个姑娘。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 76,
      "act": "幕二 · 疑",
      "text": "王生趴在窗根底下，一动不敢动，连喘气都不敢喘。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 77,
      "act": "幕二 · 疑",
      "text": "等屋里没动静了，他手脚并用爬出院子，一口气跑上街，满街找那个道士。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 78,
      "act": "幕三 · 破",
      "text": "道士还在。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 79,
      "act": "幕三 · 破",
      "text": "王生扑过去就跪下了，抱着他的腿求救命。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 80,
      "act": "幕三 · 破",
      "text": "道士听完，叹了口气。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 81,
      "act": "幕三 · 破",
      "text": "他说：这东西也不容易。它找了很久，好不容易找到一个替身。我不忍心要它的命。",
      "parts": [
        {
          "who": "老道",
          "text": "这东西也不容易。它找了很久，好不容易找到一个替身。我不忍心要它的命。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 82,
      "act": "幕三 · 破",
      "text": "他从身上解下一把拂尘，递过去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 83,
      "act": "幕三 · 破",
      "text": "把这个挂在你卧房门上。记住，是卧房。",
      "who": "老道",
      "beat": "常规"
    },
    {
      "no": 84,
      "act": "幕三 · 破",
      "text": "王生接过拂尘，谢了又谢，一路小跑回家，挂在了卧房门上。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 85,
      "act": "幕三 · 破",
      "text": "那天夜里，他没敢睡书房，跟妻子睡在卧房，门关得死死的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 86,
      "act": "幕三 · 破",
      "text": "躺下之后，谁也睡不着。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 87,
      "act": "幕三 · 破",
      "text": "到了半夜——",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 88,
      "act": "幕三 · 破",
      "text": "外头有脚步声。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 89,
      "act": "幕三 · 破",
      "text": "一步。一步。走到门口，停住了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 90,
      "act": "幕三 · 破",
      "text": "停了很久，一点声音都没有。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 91,
      "act": "幕三 · 破",
      "text": "王生躺在床上，屏着气。过了一会儿，他听见门外有咬牙的声音。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 92,
      "act": "幕三 · 破",
      "text": "咯，咯，咯。像是气得不行。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 93,
      "act": "幕三 · 破",
      "text": "又过了一阵，脚步声退开了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 94,
      "act": "幕三 · 破",
      "text": "王生长长地松了一口气。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 95,
      "act": "幕三 · 破",
      "text": "然后，脚步声又回来了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 96,
      "act": "幕三 · 破",
      "text": "这一回，门外的东西开口了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 97,
      "act": "幕三 · 破",
      "text": "它说：道士吓唬我？笑话。我到嘴的东西，还能吐出来不成。",
      "parts": [
        {
          "who": "厉鬼",
          "text": "道士吓唬我？笑话。我到嘴的东西，还能吐出来不成。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 98,
      "act": "幕三 · 破",
      "text": "接着是拂尘被扯下来、撕碎的声音。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 99,
      "act": "幕三 · 破",
      "text": "再接着，门被撞开了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 100,
      "act": "幕三 · 破",
      "text": "那东西一步跨到床前，一把撕开王生的胸膛，把心掏了出来，转身就走。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 101,
      "act": "幕三 · 破",
      "text": "陈氏就在旁边。从头到尾，她眼睁睁看着，一声也喊不出来。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 102,
      "act": "幕三 · 破",
      "text": "等她能动的时候，人已经没了。屋里一地的血。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 103,
      "act": "幕三 · 破",
      "text": "天一亮，陈氏让王生的弟弟二郎去找那个道士。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 104,
      "act": "幕三 · 破",
      "text": "道士一听，火了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 105,
      "act": "幕三 · 破",
      "text": "他说：我本来还可怜它，它倒敢这么干！",
      "parts": [
        {
          "who": "老道",
          "text": "我本来还可怜它，它倒敢这么干！",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 106,
      "act": "幕三 · 破",
      "text": "道士跟着二郎回来，进了书房。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 107,
      "act": "幕三 · 破",
      "text": "那张人皮，就扔在地上。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 108,
      "act": "幕三 · 破",
      "text": "道士从背后抽出一把木剑，往地上一指，喝了一声。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 109,
      "act": "幕三 · 破",
      "text": "地上那张人皮忽然立了起来，像有人在里面撑着。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 110,
      "act": "幕三 · 破",
      "text": "道士一剑劈下去。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 111,
      "act": "幕三 · 破",
      "text": "人皮塌了，卷成一卷，像一幅卷起来的画。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 112,
      "act": "幕三 · 破",
      "text": "跟着，从那卷东西里冒出一股浓烟，在屋里打转，往门口窜，想跑。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 113,
      "act": "幕三 · 破",
      "text": "道士取出一个葫芦，拔了塞子，往烟里一送。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 114,
      "act": "幕三 · 破",
      "text": "嗤的一声。烟被吸了进去。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 115,
      "act": "幕三 · 破",
      "text": "道士把塞子塞好，收起葫芦。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 116,
      "act": "幕三 · 破",
      "text": "到这儿，鬼是除掉了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 117,
      "act": "幕三 · 破",
      "text": "可王生还躺在那儿，胸口是个洞。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 118,
      "act": "幕四 · 救",
      "text": "陈氏跪在道士面前，求他救活丈夫。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 119,
      "act": "幕四 · 救",
      "text": "道士摇头。他说：我的本事到这儿为止。我没有让死人复生的法术。",
      "parts": [
        {
          "who": "说书人",
          "text": "道士摇头。",
          "beat": "引述"
        },
        {
          "who": "老道",
          "text": "我的本事到这儿为止。我没有让死人复生的法术。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 120,
      "act": "幕四 · 救",
      "text": "陈氏不起来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 121,
      "act": "幕四 · 救",
      "text": "道士看了她半晌，说：城里街上有个疯子，成天躺在粪土堆里。你去求他。",
      "parts": [
        {
          "who": "说书人",
          "text": "道士看了她半晌，说：",
          "beat": "引述"
        },
        {
          "who": "老道",
          "text": "城里街上有个疯子，成天躺在粪土堆里。你去求他。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 122,
      "act": "幕四 · 救",
      "text": "他又交代了一句：记住，不管他怎么侮辱你，你都得受着。",
      "parts": [
        {
          "who": "说书人",
          "text": "他又交代了一句：",
          "beat": "引述"
        },
        {
          "who": "老道",
          "text": "记住，不管他怎么侮辱你，你都得受着。",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 123,
      "act": "幕四 · 救",
      "text": "陈氏当天就去了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 124,
      "act": "幕四 · 救",
      "text": "那个乞丐果然躺在那儿，头发结成一团，浑身脏得看不出本来颜色，走近了臭得让人退开三步。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 125,
      "act": "幕四 · 救",
      "text": "陈氏走过去，跪在路边，磕头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 126,
      "act": "幕四 · 救",
      "text": "乞丐睁开眼，笑起来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 127,
      "act": "幕四 · 救",
      "text": "他说：哟，美人，你这是要嫁我啊？",
      "parts": [
        {
          "who": "乞丐",
          "text": "哟，美人，你这是要嫁我啊？",
          "beat": "常规"
        }
      ]
    },
    {
      "no": 128,
      "act": "幕四 · 救",
      "text": "陈氏低着头，把丈夫的事说了一遍。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 129,
      "act": "幕四 · 救",
      "text": "人死了还能要回来？你把我当阎王了。",
      "who": "乞丐",
      "beat": "常规"
    },
    {
      "no": 130,
      "act": "幕四 · 救",
      "text": "说完，抄起旁边一根棍子就打。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 131,
      "act": "幕四 · 救",
      "text": "陈氏不躲，让他打。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 132,
      "act": "幕四 · 救",
      "text": "街上围了一圈人看热闹。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 133,
      "act": "幕四 · 救",
      "text": "乞丐打累了，扔了棍子，喉咙里咳了半天，咳出一大口浓痰，捧在手心里，伸到陈氏面前。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 134,
      "act": "幕四 · 救",
      "text": "他说：吃了。",
      "parts": [
        {
          "who": "乞丐",
          "text": "吃了。",
          "beat": "落定"
        }
      ]
    },
    {
      "no": 135,
      "act": "幕四 · 救",
      "text": "围观的人都笑出声来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 136,
      "act": "幕四 · 救",
      "text": "陈氏抬起头，看着那只脏手里的东西。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 137,
      "act": "幕四 · 救",
      "text": "她愣住了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 138,
      "act": "幕四 · 救",
      "text": "她想起丈夫躺在家里的样子，胸口那个洞。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 139,
      "act": "幕四 · 救",
      "text": "她伸手接过来，仰起头，咽了下去。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 140,
      "act": "幕四 · 救",
      "text": "那口痰下到嗓子里，就不动了。像一团东西，硬邦邦地卡在那儿，咽不下去，也吐不出来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 141,
      "act": "幕四 · 救",
      "text": "乞丐哈哈大笑，一句话没留，起身就走，转眼没了影。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 142,
      "act": "幕四 · 救",
      "text": "陈氏羞得抬不起头，一路低着头回了家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 143,
      "act": "幕四 · 救",
      "text": "进门看见丈夫的尸首停在堂上，她再也撑不住，扑上去大哭。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 144,
      "act": "幕四 · 救",
      "text": "哭着哭着，她觉得胸口那团东西开始往上顶。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 145,
      "act": "幕四 · 救",
      "text": "一点一点，顶到喉咙口。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 146,
      "act": "幕四 · 救",
      "text": "她张开嘴——",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 147,
      "act": "幕四 · 救",
      "text": "一样东西掉了出来，不偏不倚，正落进王生胸口那个洞里。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 148,
      "act": "幕四 · 救",
      "text": "陈氏低头一看。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 149,
      "act": "幕四 · 救",
      "text": "是一颗心。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 150,
      "act": "幕四 · 救",
      "text": "热的。还在跳。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 151,
      "act": "幕四 · 救",
      "text": "她赶紧伸手把伤口合上，用力按住。一松手就往外冒血，她就撕了绸子，一圈一圈把丈夫的胸口缠起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 152,
      "act": "幕四 · 救",
      "text": "那一夜，她的手就没离开过。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 153,
      "act": "幕四 · 救",
      "text": "天亮的时候，王生睁开了眼。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 154,
      "act": "收束",
      "text": "故事到这儿讲完了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 155,
      "act": "收束",
      "text": "蒲松龄在结尾写了几句自己的话。他说：世上的人真是糊涂。明明是个妖怪，偏偏觉得是个美人。",
      "parts": [
        {
          "who": "说书人",
          "text": "蒲松龄在结尾写了几句自己的话。他说：",
          "beat": "引述"
        },
        {
          "who": "说书人",
          "text": "世上的人真是糊涂。明明是个妖怪，偏偏觉得是个美人。",
          "beat": "引文"
        }
      ]
    },
    {
      "no": 156,
      "act": "收束",
      "text": "这话说得直白。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 157,
      "act": "收束",
      "text": "但我觉得，这个故事真正狠的地方，不在这儿。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 158,
      "act": "收束",
      "text": "你回头看王生。街上那个道士，已经把话挑明了——他不信。他自己趴在窗口，亲眼看见那张皮被抖开、被披上——他也没有当场逃走，而是跑去要了一把拂尘，挂在门上，然后回屋躺下了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 159,
      "act": "收束",
      "text": "他从头到尾至少有三次机会。一次都没抓住。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 160,
      "act": "收束",
      "text": "因为他舍不得。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 161,
      "act": "收束",
      "text": "再看陈氏。她是最早看出不对的那个人，也是最后把他救回来的那个人。中间那些侮辱，那口痰，没有一样是她该受的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 162,
      "act": "收束",
      "text": "一个人看见了真相，还愿意骗自己。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 163,
      "act": "收束",
      "text": "另一个人什么都没做错，却要吞下那口痰。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 164,
      "act": "收束",
