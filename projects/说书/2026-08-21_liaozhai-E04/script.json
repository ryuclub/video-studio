{
  "id": "liaozhai-E04-cuzhi",
  "title": "第 4 期《促织》",
  "lines": [
    {
      "no": 1,
      "act": "冷开场",
      "text": "明朝宣德年间，宫里兴起了一样玩意儿。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 2,
      "act": "冷开场",
      "text": "斗蟋蟀。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 3,
      "act": "冷开场",
      "text": "这件事本来跟一个叫成名的人没有关系。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 4,
      "act": "冷开场",
      "text": "成名住在陕西华阴，离京城两千里。他是个读书人，考了很多年没考上，也不大会说话。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 5,
      "act": "冷开场",
      "text": "宫里那句喜欢，传到陕西的时候，已经不是一句喜欢了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 6,
      "act": "冷开场",
      "text": "它变成了一个数目。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 7,
      "act": "冷开场",
      "text": "这个县，每年要往上交多少只虫。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 8,
      "act": "冷开场",
      "text": "数目从县里摊到乡里，从乡里摊到人头上。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 9,
      "act": "冷开场",
      "text": "最后落到成名头上的，是一只虫。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 10,
      "act": "冷开场",
      "text": "为了这一只虫，他赔光了家里所有能卖的东西。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 11,
      "act": "冷开场",
      "text": "为了这一只虫，他两条腿被打得脓血直流，起身都要人扶。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 12,
      "act": "冷开场",
      "text": "后来他还赔进去一个九岁的孩子。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 13,
      "act": "冷开场",
      "text": "今天讲《促织》。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 14,
      "act": "冷开场",
      "text": "这是《聊斋》里我认为最好的一篇，也是最难受的一篇。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 15,
      "act": "引入",
      "text": "先说清楚这只虫是怎么落到他头上的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 16,
      "act": "引入",
      "text": "宣德年间宫里喜欢斗蟋蟀，每年要向民间征。这是头一层。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 17,
      "act": "引入",
      "text": "这本来不该是陕西的事。陕西不产好蟋蟀。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 18,
      "act": "引入",
      "text": "坏就坏在华阴县的县令想往上走一步。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 19,
      "act": "引入",
      "text": "他不知从哪儿弄到一只，试着斗了斗，能赢。他把这只虫献了上去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 20,
      "act": "引入",
      "text": "上头收下了，拿去一试，也赢了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 21,
      "act": "引入",
      "text": "于是上头说了一句话：这个地方有好虫，以后就常供吧。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 22,
      "act": "引入",
      "text": "「常供」这两个字，就是从这儿来的。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 23,
      "act": "引入",
      "text": "上头那句话是随口说的。他一年要说上千句话，这只是其中一句。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 24,
      "act": "引入",
      "text": "可这句话到了县令这儿，变成了一年一年的定例。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 25,
      "act": "引入",
      "text": "县令又把这个定例交给底下的里正。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 26,
      "act": "引入",
      "text": "里正是乡里管催派的那个人。谁当里正，谁就得把数目凑齐。凑不齐，自己赔。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 27,
      "act": "引入",
      "text": "成名就是这么当上里正的。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 28,
      "act": "引入",
      "text": "不是他想当。是衙门里那些老油子看他老实，把他的名字报了上去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 29,
      "act": "引入",
      "text": "成名去推过。他去了两回，话都没说完就被赶了出来。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 30,
      "act": "引入",
      "text": "从他名字被报上去那一天起，这件事就跟他绑上了。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 31,
      "act": "幕一 · 摊派",
      "text": "蟋蟀这东西，陕西本来就少。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 32,
      "act": "幕一 · 摊派",
      "text": "县里派下来的数目，一只都不能少。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 33,
      "act": "幕一 · 摊派",
      "text": "成名当上里正的头一年，就知道这件事办不成。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 34,
      "act": "幕一 · 摊派",
      "text": "他不忍心去催那些比他还穷的人家。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 35,
      "act": "幕一 · 摊派",
      "text": "按规矩，他可以挨家挨户去要。要不出虫，就要钱；要不出钱，就动手。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 36,
      "act": "幕一 · 摊派",
      "text": "前一任里正就是这么干的。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 37,
      "act": "幕一 · 摊派",
      "text": "成名干不出来。他去过一趟，站在人家院子外面，看见屋里两个孩子在地上爬，就转身回来了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 38,
      "act": "幕一 · 摊派",
      "text": "他把这个数目自己扛了下来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 39,
      "act": "幕一 · 摊派",
      "text": "自己扛，就得自己买。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 40,
      "act": "幕一 · 摊派",
      "text": "好蟋蟀在市面上是有价的，一只能顶一头牛。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 41,
      "act": "幕一 · 摊派",
      "text": "成名先卖了地。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 42,
      "act": "幕一 · 摊派",
      "text": "地卖完了，卖房前的那两棵树。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 43,
      "act": "幕一 · 摊派",
      "text": "树卖完了，卖妻子陪嫁的那点首饰。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 44,
      "act": "幕一 · 摊派",
      "text": "首饰卖完了，家里就没有什么能换钱的东西了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 45,
      "act": "幕一 · 摊派",
      "text": "一年下来，成名家里能卖的都卖了，数目还是没凑齐。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 46,
      "act": "幕一 · 摊派",
      "text": "那阵子他成天坐在门槛上不说话。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 47,
      "act": "幕一 · 摊派",
      "text": "成妻看了他几天，开口了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 48,
      "act": "幕一 · 摊派",
      "text": "你这么坐着，坐死了也交不上。",
      "who": "妇人",
      "beat": "揭底"
    },
    {
      "no": 49,
      "act": "幕一 · 摊派",
      "text": "买不起，就自己去捉。",
      "who": "妇人",
      "beat": "揭底"
    },
    {
      "no": 50,
      "act": "幕一 · 摊派",
      "text": "我一个读书人，去草窝里趴着捉虫。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 51,
      "act": "幕一 · 摊派",
      "text": "你现在是里正。",
      "who": "妇人",
      "beat": "揭底"
    },
    {
      "no": 52,
      "act": "幕一 · 摊派",
      "text": "这句话说完，屋里就没人再说话了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 53,
      "act": "幕一 · 摊派",
      "text": "第二天天没亮，成名出门了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 54,
      "act": "幕一 · 摊派",
      "text": "他带了两样东西：一根竹筒，一个丝笼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 55,
      "act": "幕一 · 摊派",
      "text": "竹筒是往洞里灌水用的，丝笼是装虫用的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 56,
      "act": "幕一 · 摊派",
      "text": "从那天起，他天不亮出门，天黑透回来。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 57,
      "act": "幕一 · 摊派",
      "text": "塌了的墙根，他一段一段地掀。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 58,
      "act": "幕一 · 摊派",
      "text": "乱草丛里，他一把一把地分。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 59,
      "act": "幕一 · 摊派",
      "text": "石头缝，他掰开看。土洞，他挖开看。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 60,
      "act": "幕一 · 摊派",
      "text": "灌水、熏烟、拿草茎往里探，他能想到的法子都用了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 61,
      "act": "幕一 · 摊派",
      "text": "一天下来，往往什么都没有。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 62,
      "act": "幕一 · 摊派",
      "text": "也有捉着的时候。前后捉着过两三只。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 63,
      "act": "幕一 · 摊派",
      "text": "可是交上去要看成色。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 64,
      "act": "幕一 · 摊派",
      "text": "那两三只，个头小，腿也软，衙门那边一眼就退回来了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 65,
      "act": "幕一 · 摊派",
      "text": "退回来的意思是：这不算数，重新交。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 66,
      "act": "幕一 · 摊派",
      "text": "他捉的那些天，脚上磨破了好几处，回来自己拿布缠上，第二天接着出去。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 67,
      "act": "幕一 · 摊派",
      "text": "数目一只没减。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 68,
      "act": "幕一 · 摊派",
      "text": "限期一次一次地追。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 69,
      "act": "幕一 · 摊派",
      "text": "第一次，打二十。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 70,
      "act": "幕一 · 摊派",
      "text": "第二次，打四十。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 71,
      "act": "幕一 · 摊派",
      "text": "到旬把日子上，前后加起来打了一百。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 72,
      "act": "幕一 · 摊派",
      "text": "最后那一次是抬回来的。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 73,
      "act": "幕一 · 摊派",
      "text": "两条大腿上皮开肉绽，脓血把裤子粘在肉上。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 74,
      "act": "幕一 · 摊派",
      "text": "那几天他躺在床上，翻身都要人扶。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 75,
      "act": "幕一 · 摊派",
      "text": "翻个身，血就把褥子洇出一片。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 76,
      "act": "幕一 · 摊派",
      "text": "成妻在旁边守着，不说话，只拿布一点一点把血按干。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 77,
      "act": "幕一 · 摊派",
      "text": "这里要说一件荒唐的事。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 78,
      "act": "幕一 · 摊派",
      "text": "他被打，是因为没交上虫。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 79,
      "act": "幕一 · 摊派",
      "text": "而他现在这个样子，连爬都爬不动，更别说去草里捉虫。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 80,
      "act": "幕一 · 摊派",
      "text": "打他的人不管这个。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 81,
      "act": "幕一 · 摊派",
      "text": "规矩是：限期到了没交上，就打。至于打完了他还能不能去捉，规矩里没有写。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 82,
      "act": "幕一 · 摊派",
      "text": "成名在床上躺了几天，想的是同一件事。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 83,
      "act": "幕一 · 摊派",
      "text": "他想的不是怎么凑上那只虫。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 84,
      "act": "幕一 · 摊派",
      "text": "他想的是死。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 85,
      "act": "幕一 · 摊派",
      "text": "他跟成妻说过一次。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 86,
      "act": "幕一 · 摊派",
      "text": "我一死，这件事就到我这儿为止了。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 87,
      "act": "幕一 · 摊派",
      "text": "成妻没有接话。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 88,
      "act": "幕一 · 摊派",
      "text": "她只是把那块布又拧了一遍。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 89,
      "act": "幕二 · 得虫",
      "text": "村里来了个驼背巫。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 90,
      "act": "幕二 · 得虫",
      "text": "据说这个人能通神，谁家丢了东西、谁家病了，去问她，她给个说法。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 91,
      "act": "幕二 · 得虫",
      "text": "问一次要钱。要不少。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 92,
      "act": "幕二 · 得虫",
      "text": "成妻拿着家里最后一点钱去了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 93,
      "act": "幕二 · 得虫",
      "text": "去的时候门口排着一队人。有老太太，有小媳妇，一个挨一个站着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 94,
      "act": "幕二 · 得虫",
      "text": "轮到成妻，她把钱放在案上，说明了来意。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 95,
      "act": "幕二 · 得虫",
      "text": "驼背巫没有开口。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 96,
      "act": "幕二 · 得虫",
      "text": "她只是伸手指了指案头一个香炉。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 97,
      "act": "幕二 · 得虫",
      "text": "成妻上了香，跪下，磕头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 98,
      "act": "幕二 · 得虫",
      "text": "跪了很久。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 99,
      "act": "幕二 · 得虫",
      "text": "然后案上多了一张纸。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 100,
      "act": "幕二 · 得虫",
      "text": "那张纸是自己落下来的，没有人递。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 101,
      "act": "幕二 · 得虫",
      "text": "拿去看，别问我。",
      "who": "沙哑老头",
      "beat": "揭底"
    },
    {
      "no": 102,
      "act": "幕二 · 得虫",
      "text": "成妻把纸捡起来，展开。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 103,
      "act": "幕二 · 得虫",
      "text": "纸上没有一个字，画着一片景。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 104,
      "act": "幕二 · 得虫",
      "text": "画的是一座殿阁，殿后面有座小山，山是假山，一块一块的石头堆起来的。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 105,
      "act": "幕二 · 得虫",
      "text": "石头下面伏着一只癞蛤蟆，看那样子像是要跳。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 106,
      "act": "幕二 · 得虫",
      "text": "蛤蟆旁边，趴着一只蟋蟀。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 107,
      "act": "幕二 · 得虫",
      "text": "蟋蟀边上有一只青麻头，支棱着腿，像是要往什么地方去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 108,
      "act": "幕二 · 得虫",
      "text": "成妻把这张纸带回家，摊在成名床前。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 109,
      "act": "幕二 · 得虫",
      "text": "成名撑起半个身子看了很久。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 110,
      "act": "幕二 · 得虫",
      "text": "这不是给我算命，这是给我指路。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 111,
      "act": "幕二 · 得虫",
      "text": "村东有座大佛阁。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 112,
      "act": "幕二 · 得虫",
      "text": "佛阁后面有座假山，山下常年积着水，水边有草。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 113,
      "act": "幕二 · 得虫",
      "text": "那地方成名从小就熟。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 114,
      "act": "幕二 · 得虫",
      "text": "第二天天没亮，成名让人把他扶起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 115,
      "act": "幕二 · 得虫",
      "text": "他没让扶到底，自己撑着墙站住了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 116,
      "act": "幕二 · 得虫",
      "text": "他拿了一根竹筒，一个铜丝笼子，一路挪到村东。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 117,
      "act": "幕二 · 得虫",
      "text": "那一段路平时走一炷香，那天他走了整整一个上午。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 118,
      "act": "幕二 · 得虫",
      "text": "到了佛阁后面，太阳已经上来了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 119,
      "act": "幕二 · 得虫",
      "text": "荒草长得过膝，草里是碎石头，石头缝里全是坟。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 120,
      "act": "幕二 · 得虫",
      "text": "成名把腰弯下去。弯到一半，大腿上的伤口就崩开了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 121,
      "act": "幕二 · 得虫",
      "text": "他忍住，继续弯。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 122,
      "act": "幕二 · 得虫",
      "text": "他在草里趴了很久，一寸一寸地拨。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 123,
      "act": "幕二 · 得虫",
      "text": "拨过的地方，草叶上留着一道血印子。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 124,
      "act": "幕二 · 得虫",
      "text": "日头从东边挪到头顶。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 125,
      "act": "幕二 · 得虫",
      "text": "什么也没有。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 126,
      "act": "幕二 · 得虫",
      "text": "草虫倒是不少，一惊一片，全是些不能斗的。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 127,
      "act": "幕二 · 得虫",
      "text": "成名把每一只都看了。看完放走。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 128,
      "act": "幕二 · 得虫",
      "text": "日头从头顶往西边挪。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 129,
      "act": "幕二 · 得虫",
      "text": "他一个人在那片荒草里，从蹲着改成跪着，从跪着改成趴着。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 130,
      "act": "幕二 · 得虫",
      "text": "天快黑的时候，他停下了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 131,
      "act": "幕二 · 得虫",
      "text": "不是因为累。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 132,
      "act": "幕二 · 得虫",
      "text": "是因为他看见了一只癞蛤蟆。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 133,
      "act": "幕二 · 得虫",
      "text": "那只蛤蟆就伏在假山脚下的石头旁边，跟画上一模一样。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 134,
      "act": "幕二 · 得虫",
      "text": "他往前挪了两步。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 135,
      "act": "幕二 · 得虫",
      "text": "蛤蟆一跳，跳进了草里。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 136,
      "act": "幕二 · 得虫",
      "text": "成名扑过去，分开草。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 137,
      "act": "幕二 · 得虫",
      "text": "草底下有个石洞。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 138,
      "act": "幕二 · 得虫",
      "text": "洞口有一撮新翻的土。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 139,
      "act": "幕二 · 得虫",
      "text": "他用竹筒往洞里灌水。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 140,
      "act": "幕二 · 得虫",
      "text": "水灌进去，等了一会儿，里面出来一只虫。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 141,
      "act": "幕二 · 得虫",
      "text": "那只虫从洞里爬出来的时候，成名没有动。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 142,
      "act": "幕二 · 得虫",
      "text": "他就那么趴着看。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 143,
      "act": "幕二 · 得虫",
      "text": "那是一只大虫。身子长，尾巴也长，脖子是青的，翅膀上有金线。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 144,
      "act": "幕二 · 得虫",
      "text": "成名把它扣进笼子。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 145,
      "act": "幕二 · 得虫",
      "text": "回家的路他走得比来的时候还慢，因为一只手要护着笼子。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 146,
      "act": "幕二 · 得虫",
      "text": "到家已经半夜了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 147,
      "act": "幕二 · 得虫",
      "text": "那天晚上，成名家里的灯亮到很晚。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 148,
      "act": "幕二 · 得虫",
      "text": "一家人围着那个笼子看。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 149,
      "act": "幕二 · 得虫",
      "text": "孩子也醒了，趴在桌沿上，从铜丝的缝里往里看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 150,
      "act": "幕二 · 得虫",
      "text": "成妻用蟹肉和栗子粉调了食，一点一点喂进去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 151,
      "act": "幕二 · 得虫",
      "text": "盆里垫着新采的草。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 152,
      "act": "幕二 · 得虫",
      "text": "那几天，家里最好的东西都进了那个盆。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 153,
      "act": "幕二 · 得虫",
      "text": "成名把笼子放在床头，夜里醒好几次，每次都伸手摸一摸还在不在。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 154,
      "act": "幕二 · 得虫",
      "text": "离限期还有几天。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 155,
      "act": "幕二 · 得虫",
      "text": "他数着这几天过。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 156,
      "act": "幕三 · 投井",
      "text": "那天成名不在家。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 157,
      "act": "幕三 · 投井",
      "text": "他一早出门去了，去打听交虫那天的规矩。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 158,
      "act": "幕三 · 投井",
      "text": "家里只剩成妻和孩子。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 159,
      "act": "幕三 · 投井",
      "text": "孩子九岁。他已经在盆边上站了好几天了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 160,
      "act": "幕三 · 投井",
      "text": "大人不许他碰。他就趴在那儿看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 161,
      "act": "幕三 · 投井",
      "text": "那天中午，成妻去了后院。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 162,
      "act": "幕三 · 投井",
      "text": "孩子一个人在屋里。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 163,
      "act": "幕三 · 投井",
      "text": "他把盆盖掀开了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 164,
      "act": "幕三 · 投井",
      "text": "一条缝。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 165,
      "act": "幕三 · 投井",
      "text": "虫从那条缝里跳了出来。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 166,
      "act": "幕三 · 投井",
      "text": "孩子急了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 167,
      "act": "幕三 · 投井",
      "text": "他两只手往下扑。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 168,
      "act": "幕三 · 投井",
      "text": "虫在地上跳，他就在地上追。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 169,
      "act": "幕三 · 投井",
      "text": "追到墙角，他伸手一按。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 170,
      "act": "幕三 · 投井",
      "text": "按住了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 171,
      "act": "幕三 · 投井",
      "text": "孩子把手抬起来的时候，虫的腿掉了一条，肚子瘪下去一块。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 172,
      "act": "幕三 · 投井",
      "text": "它在他手心里动了两下，不动了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 173,
      "act": "幕三 · 投井",
      "text": "孩子在屋里站着，站了很久。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 174,
      "act": "幕三 · 投井",
      "text": "他没有哭。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 175,
      "act": "幕三 · 投井",
      "text": "后来他跑到后院，找到成妻，把这件事说了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 176,
      "act": "幕三 · 投井",
      "text": "成妻听完，脸上的血一下子退干净了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 177,
      "act": "幕三 · 投井",
      "text": "孽根，你的死期到了。",
      "who": "妇人",
      "beat": "揭底"
    },
    {
      "no": 178,
      "act": "幕三 · 投井",
      "text": "她说这句话的时候人是懵的，话就那么出来了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 179,
      "act": "幕三 · 投井",
      "text": "你爹回来，跟你算这笔账。",
      "who": "妇人",
      "beat": "揭底"
    },
    {
      "no": 180,
      "act": "幕三 · 投井",
      "text": "孩子看着她，一句话也没说。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 181,
      "act": "幕三 · 投井",
      "text": "然后他转身出去了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 182,
      "act": "幕三 · 投井",
      "text": "成妻当时没有追。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 183,
      "act": "幕三 · 投井",
      "text": "她跪在地上，把那只死虫捡起来，捧在手心里，想着等一会儿要怎么跟成名说。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 184,
      "act": "幕三 · 投井",
      "text": "天擦黑的时候成名回来了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 185,
      "act": "幕三 · 投井",
      "text": "他一进门就问虫。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 186,
      "act": "幕三 · 投井",
      "text": "成妻把手摊开给他看。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 187,
      "act": "幕三 · 投井",
      "text": "成名站在那儿，从头到脚像被人泼了一桶冰水。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 188,
      "act": "幕三 · 投井",
      "text": "原文这一句写得很重。蒲松龄的原话是——",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 189,
      "act": "幕三 · 投井",
      "text": "「如被冰雪。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 190,
      "act": "幕三 · 投井",
      "text": "成名回过神来的第一件事，是找孩子。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 191,
      "act": "幕三 · 投井",
      "text": "家里没有。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 192,
      "act": "幕三 · 投井",
      "text": "院子里没有。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 193,
      "act": "幕三 · 投井",
      "text": "村口没有。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 194,
      "act": "幕三 · 投井",
      "text": "天已经黑透了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 195,
      "act": "幕三 · 投井",
      "text": "成名提着灯，一处一处地找。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 196,
      "act": "幕三 · 投井",
      "text": "他先去了村口那条路，来回走了两趟，灯照到哪儿看到哪儿。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 197,
      "act": "幕三 · 投井",
      "text": "他去了麦场，把几个麦垛都绕了一圈。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 198,
      "act": "幕三 · 投井",
      "text": "他去敲邻居的门，一家一家地问。人家开门，摇头，又把门关上。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 199,
      "act": "幕三 · 投井",
      "text": "他站在村中间的空地上，喊了几声孩子的名字。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 200,
      "act": "幕三 · 投井",
      "text": "喊完站着听。没有人应。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 201,
      "act": "幕三 · 投井",
      "text": "村里的狗被他惊起来，叫了一阵，也就歇了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 202,
      "act": "幕三 · 投井",
      "text": "后来他往回走。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 203,
      "act": "幕三 · 投井",
      "text": "回来的路上他一直低着头，灯往地面上照。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 204,
      "act": "幕三 · 投井",
      "text": "找到后半夜，在院子后头那口井边上停住了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 205,
      "act": "幕三 · 投井",
      "text": "井绳搭在井沿上，是垂下去的。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 206,
      "act": "幕三 · 投井",
      "text": "他们把孩子捞上来的时候，天已经蒙蒙亮了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 207,
      "act": "幕三 · 投井",
      "text": "孩子的身子是凉的。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 208,
      "act": "幕三 · 投井",
      "text": "成名把他抱在怀里，坐在井边，没有出声。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 209,
      "act": "幕三 · 投井",
      "text": "成妻在旁边，也没有出声。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 210,
      "act": "幕三 · 投井",
      "text": "那一整个白天，家里没有生火。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 211,
      "act": "幕三 · 投井",
      "text": "烟囱是冷的。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 212,
      "act": "幕三 · 投井",
      "text": "村里人来过几个，站了站，又走了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 213,
      "act": "幕三 · 投井",
      "text": "夫妻俩一个坐在东头，一个坐在西头，中间的地上放着那个空盆。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 214,
      "act": "幕三 · 投井",
      "text": "谁也不看谁。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 215,
      "act": "幕三 · 投井",
      "text": "到了傍晚，他们要把孩子收拾一下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 216,
      "act": "幕三 · 投井",
      "text": "成妻去摸他的手。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 217,
      "act": "幕三 · 投井",
      "text": "摸到一半，她停住了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 218,
      "act": "幕三 · 投井",
      "text": "他还有气。",
      "who": "妇人",
      "beat": "揭底"
    },
    {
      "no": 219,
      "act": "幕三 · 投井",
      "text": "孩子的胸口在动，很轻，很慢，隔很久一下。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 220,
      "act": "幕三 · 投井",
      "text": "他们把孩子抱到床上。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 221,
      "act": "幕三 · 投井",
      "text": "半夜里孩子睁了一下眼。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 222,
      "act": "幕三 · 投井",
      "text": "睁了一下，又闭上了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 223,
      "act": "幕三 · 投井",
      "text": "从那天起，孩子就那么躺着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 224,
      "act": "幕三 · 投井",
      "text": "眼睛有时候睁着，有时候闭着，人是醒的，可什么也不说。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 225,
      "act": "幕三 · 投井",
      "text": "叫他，他不应。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 226,
      "act": "幕三 · 投井",
      "text": "喂他，他咽。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 227,
      "act": "幕三 · 投井",
      "text": "成名夫妻守在床边。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 228,
      "act": "幕三 · 投井",
      "text": "他们不敢哭出声。怕吵着他。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 229,
      "act": "幕三 · 投井",
      "text": "那几天家里安静得能听见外面的虫叫。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 230,
      "act": "幕四 · 小虫",
      "text": "限期是不会因为这些事往后挪的。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 231,
      "act": "幕四 · 小虫",
      "text": "成名坐在床边，一夜一夜地睡不着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 232,
      "act": "幕四 · 小虫",
      "text": "天快亮的时候，他听见门外有虫叫。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 233,
      "act": "幕四 · 小虫",
      "text": "叫得很近，就在门槛底下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 234,
      "act": "幕四 · 小虫",
      "text": "成名撑着起来，把门推开一条缝。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 235,
      "act": "幕四 · 小虫",
      "text": "一只虫伏在门槛上。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 236,
      "act": "幕四 · 小虫",
      "text": "那只虫小得可怜。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 237,
      "act": "幕四 · 小虫",
      "text": "短，黑里透红，趴在那儿像一块土渣。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 238,
      "act": "幕四 · 小虫",
      "text": "成名看了一眼就把头转开了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 239,
      "act": "幕四 · 小虫",
      "text": "这种虫没有用。交上去只会挨一顿打。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 240,
      "act": "幕四 · 小虫",
      "text": "他伸手去撵它。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 241,
      "act": "幕四 · 小虫",
      "text": "那只虫跳了一下，落在他袖子上。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 242,
      "act": "幕四 · 小虫",
      "text": "成名把它抖下来。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 243,
      "act": "幕四 · 小虫",
      "text": "它又跳上来。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 244,
      "act": "幕四 · 小虫",
      "text": "一连三次。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 245,
      "act": "幕四 · 小虫",
      "text": "第三次的时候，成名停住了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 246,
      "act": "幕四 · 小虫",
      "text": "他把它捧起来，看了很久。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 247,
      "act": "幕四 · 小虫",
      "text": "也罢。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 248,
      "act": "幕四 · 小虫",
      "text": "他把它放进了那个空盆。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 249,
      "act": "幕四 · 小虫",
      "text": "村里有个少年，好这一口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 250,
      "act": "幕四 · 小虫",
      "text": "他养了一只虫，自己给取了名字，叫蟹壳青。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 251,
      "act": "幕四 · 小虫",
      "text": "那只虫在村里斗遍了没输过。他成天拿着笼子四处找人斗。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 252,
      "act": "幕四 · 小虫",
      "text": "那天他上门来了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 253,
      "act": "幕四 · 小虫",
      "text": "他一看成名盆里那只，就笑了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 254,
      "act": "幕四 · 小虫",
      "text": "笑完他把自己的笼子打开，把蟹壳青放进来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 255,
      "act": "幕四 · 小虫",
      "text": "蟹壳青一进盆就往前压。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 256,
      "act": "幕四 · 小虫",
      "text": "个头是它的两倍还多。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 257,
      "act": "幕四 · 小虫",
      "text": "成名那只小虫伏在角上，一动不动。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 258,
      "act": "幕四 · 小虫",
      "text": "少年拿草茎去撩它。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 259,
      "act": "幕四 · 小虫",
      "text": "撩了一下，不动。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 260,
      "act": "幕四 · 小虫",
      "text": "撩了两下，还是不动。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 261,
      "act": "幕四 · 小虫",
      "text": "少年笑得更响了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 262,
      "act": "幕四 · 小虫",
      "text": "第三下，他直接把草茎戳到了小虫的须上。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 263,
      "act": "幕四 · 小虫",
      "text": "小虫动了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 264,
      "act": "幕四 · 小虫",
      "text": "它转过身，直扑过去。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 265,
      "act": "幕四 · 小虫",
      "text": "两只虫撞在一起，翅膀振得出声。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 266,
      "act": "幕四 · 小虫",
      "text": "蟹壳青的个头压不住它。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 267,
      "act": "幕四 · 小虫",
      "text": "小虫贴着地往上钻，一口咬住了对方的脖子。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 268,
      "act": "幕四 · 小虫",
      "text": "咬住就不松。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 269,
      "act": "幕四 · 小虫",
      "text": "少年脸上的笑没了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 270,
      "act": "幕四 · 小虫",
      "text": "他伸手要把它们分开。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 271,
      "act": "幕四 · 小虫",
      "text": "盆里的动静停下来的时候，蟹壳青已经不动了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 272,
      "act": "幕四 · 小虫",
      "text": "小虫在盆边上振了振翅膀，叫了两声。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 273,
      "act": "幕四 · 小虫",
      "text": "就在这个时候，院里的鸡看见了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 274,
      "act": "幕四 · 小虫",
      "text": "一只公鸡冲过来，伸嘴就啄。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 275,
      "act": "幕四 · 小虫",
      "text": "那一啄没啄着。小虫跳出去一尺多远。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 276,
      "act": "幕四 · 小虫",
      "text": "鸡追上去，一脚踩住。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 277,
      "act": "幕四 · 小虫",
      "text": "成名当时就站在那儿。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 278,
      "act": "幕四 · 小虫",
      "text": "他脚下像钉住了，喊也喊不出来。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 279,
      "act": "幕四 · 小虫",
      "text": "等他扑过去，鸡已经在扬脖子了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 280,
      "act": "幕四 · 小虫",
      "text": "可鸡忽然自己乱了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 281,
      "act": "幕四 · 小虫",
      "text": "它扭着脖子甩头，一边甩一边跳，围着院子转圈。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 282,
      "act": "幕四 · 小虫",
      "text": "成名凑近了才看清。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 283,
      "act": "幕四 · 小虫",
      "text": "那只小虫爬在鸡冠子上，一口咬着不放。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 284,
      "act": "幕四 · 小虫",
      "text": "成名把它捧下来的时候，手是抖的。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 285,
      "act": "幕四 · 小虫",
      "text": "后面的事就顺了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 286,
      "act": "幕四 · 小虫",
      "text": "顺得不像话。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 287,
      "act": "幕四 · 小虫",
      "text": "成名把虫交上去。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 288,
      "act": "幕四 · 小虫",
      "text": "县令拿去一试，大喜，赏了他。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 289,
      "act": "幕四 · 小虫",
      "text": "县令把虫献给巡抚。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 290,
      "act": "幕四 · 小虫",
      "text": "巡抚用金笼子装着，一路送进了宫。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 291,
      "act": "幕四 · 小虫",
      "text": "宫里试了，这只虫什么虫都斗得过。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 292,
      "act": "幕四 · 小虫",
      "text": "不光斗得过。奏起乐来，它还能跟着调子动。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 293,
      "act": "幕四 · 小虫",
      "text": "上头很高兴。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 294,
      "act": "幕四 · 小虫",
      "text": "上头赏了巡抚，名马、绸缎。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 295,
      "act": "幕四 · 小虫",
      "text": "巡抚记得这只虫是哪儿来的。他给县令写了个考评，说这个人办事好。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 296,
      "act": "幕四 · 小虫",
      "text": "县令也高兴。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 297,
      "act": "幕四 · 小虫",
      "text": "县令免了成名的里正差事，又跟学官打了招呼，把他补进了县学。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 298,
      "act": "幕四 · 小虫",
      "text": "一年之后，成名家里的孩子醒了。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 299,
      "act": "幕四 · 小虫",
      "text": "孩子坐起来，看着他爹娘，说了一句话。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 300,
      "act": "幕四 · 小虫",
      "text": "我这些天变成了一只蟋蟀。",
      "who": "童声",
      "beat": "揭底"
    },
    {
      "no": 301,
      "act": "幕四 · 小虫",
      "text": "我很轻，很快，很能打。",
      "who": "童声",
      "beat": "揭底"
    },
    {
      "no": 302,
      "act": "幕四 · 小虫",
      "text": "现在我回来了。",
      "who": "童声",
      "beat": "揭底"
    },
    {
      "no": 303,
      "act": "幕四 · 小虫",
      "text": "孩子说完这几句，又躺下睡了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 304,
      "act": "幕四 · 小虫",
      "text": "睡醒之后，人就跟从前一样了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 305,
      "act": "幕四 · 小虫",
      "text": "再往后，成名家里越过越好。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 306,
      "act": "幕四 · 小虫",
      "text": "巡抚也赏过他。不出几年，田有一百多顷，房子成片，牛羊上千。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 307,
      "act": "幕四 · 小虫",
      "text": "他一出门，穿的用的，比那些世代做官的人家还讲究。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 308,
      "act": "幕四 · 小虫",
      "text": "村里人提起成家，说的是运气好。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 309,
      "act": "收束",
      "text": "这个故事讲完了，我想先把最后那句话再说一遍。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 310,
      "act": "收束",
      "text": "成名发了财。田百顷，楼阁万椽，牛羊上千。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 311,
      "act": "收束",
      "text": "这份家业是怎么来的？",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 312,
      "act": "收束",
      "text": "是他九岁的儿子跳了一次井，在床上躺了一年，变成一只虫替他去斗回来的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 313,
      "act": "收束",
      "text": "而这件事，从头到尾，没有一个人觉得不对。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 314,
      "act": "收束",
      "text": "县令高兴。巡抚高兴。宫里高兴。村里人说成家运气好。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 315,
      "act": "收束",
      "text": "成名自己也高兴。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 316,
      "act": "收束",
      "text": "蒲松龄在故事后面写了一段话。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 317,
      "act": "收束",
      "text": "那段话里有一句，是这整篇的骨头。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 318,
      "act": "收束",
      "text": "原话是这么写的——",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 319,
      "act": "收束",
      "text": "「天子偶用一物，未必不过此已忘。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 320,
      "act": "收束",
      "text": "「而奉行者即为定例。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 321,
      "act": "收束",
      "text": "上头偶然用了一样东西，很可能转头就忘了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 322,
      "act": "收束",
      "text": "而底下奉行的人，把它办成了定例。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 323,
      "act": "收束",
      "text": "这两句里，最要紧的是「奉行」两个字。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 324,
      "act": "收束",
      "text": "奉行不是执行。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 325,
      "act": "收束",
      "text": "奉行是把上面随口的一句，往下每传一层，加一分保险。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 326,
      "act": "收束",
      "text": "上头说这地方有好虫，以后常供。这是一句话。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 327,
      "act": "收束",
      "text": "到了县令那儿，变成一年一年的定额。他要保住这份好评，只能往多了报。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 328,
      "act": "收束",
      "text": "到了里正那儿，变成一户一户的摊派。他要凑齐数目，只能往狠了要。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 329,
      "act": "收束",
      "text": "到了成名那儿，变成一只必须交出来的虫。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 330,
      "act": "收束",
      "text": "每一层都没有做错什么。每一层都只是把上面的意思往下传，顺便加了一点余量，好让自己不出事。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 331,
      "act": "收束",
      "text": "那点余量层层叠上去，最后压在最底下那个人身上。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 332,
      "act": "收束",
      "text": "放到今天也是这样。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 333,
      "act": "收束",
      "text": "上面开会随口说了一句要重视，中层把它定成一条硬指标，基层为了达标自己贴钱贴时间，\n最后赔进去的是某个人的一个家。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 334,
      "act": "收束",
      "text": "这中间没有一个人是坏人。所有人都只是在办事。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 335,
      "act": "收束",
      "text": "一句话在最上面是随口，传到最下面是人命。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 336,
      "act": "收束",
      "text": "成名后来常常在夜里坐起来。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 337,
      "act": "收束",
      "text": "他记得那年秋天，他趴在佛阁后面的草里，从早上找到天黑。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 338,
      "act": "收束",
      "text": "腿上的血把草叶染出一道印子。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 339,
      "act": "收束",
      "text": "那时候他要的只是一只虫。",
      "who": "说书人",
      "beat": "收"
    }
  ]
}