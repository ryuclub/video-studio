{
  "id": "liaozhai-E02-nie",
  "title": "第 2 期《聂小倩》",
  "lines": [
    {
      "no": 1,
      "act": "冷开场",
      "text": "先说一件事。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 2,
      "act": "冷开场",
      "text": "这个故事里的女鬼，是杀过人的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 3,
      "act": "冷开场",
      "text": "不是传闻，不是别人栽给她的。是她自己跪在地上，一个字一个字承认的。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 4,
      "act": "冷开场",
      "text": "她说她杀人的法子，是拿一根锥子，扎进人的脚心。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 5,
      "act": "冷开场",
      "text": "扎一个小孔，针眼那么大。血就顺着那个孔，一夜一夜，一点一点，流干净。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 6,
      "act": "冷开场",
      "text": "人到死，都不知道自己是怎么没的。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 7,
      "act": "冷开场",
      "text": "她杀过两个。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 8,
      "act": "冷开场",
      "text": "两个都死在同一座寺里，隔了一夜。死的时候，被子都没蹬乱。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 9,
      "act": "冷开场",
      "text": "可蒲松龄写了将近五百个故事，里头最让人记住、也最让人心疼的一个女子，偏偏就是她。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 10,
      "act": "冷开场",
      "text": "今天讲《聂小倩》。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 11,
      "act": "引入",
      "text": "金华城北，一片荒地上，有一座寺。名字叫兰若寺。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 12,
      "act": "引入",
      "text": "院子里的蒿草长得比人还高，风一过，草叶子互相刮着响。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 13,
      "act": "引入",
      "text": "正殿的房檐塌了半边，砖瓦堆在台阶下头，堆了多久没人知道，也没人来收。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 14,
      "act": "引入",
      "text": "僧人早就走光了。屋里只剩灰。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 15,
      "act": "引入",
      "text": "连佛像的脸都看不清了，一层土。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 16,
      "act": "引入",
      "text": "这个地方，白天都少有人来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 17,
      "act": "引入",
      "text": "故事的主角叫宁采臣，浙江人，读书人。那一年到金华办事。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 18,
      "act": "引入",
      "text": "他这个人，书上交代得很清楚：为人慷慨，认死理，不肯占人半点便宜。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 19,
      "act": "引入",
      "text": "他还常跟人说一句话——这辈子只有妻子一个女人，再没有第二个。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 20,
      "act": "引入",
      "text": "这句话请你记住。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 21,
      "act": "引入",
      "text": "后面整整一幕，都是在兑现它。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 22,
      "act": "引入",
      "text": "到了金华，城里的客店又贵又吵。宁采臣嫌吵，打听到北郭有座空寺没人住，就收拾东西搬了进去，住在南边一间屋里。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 23,
      "act": "引入",
      "text": "寺里还有一个人。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 24,
      "act": "引入",
      "text": "住东厢，姓燕，叫燕赤霞，陕西人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 25,
      "act": "引入",
      "text": "这个人话极少。屋里靠墙放着一只长匣子，走到哪儿带到哪儿，睡觉也搁在手边。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 26,
      "act": "引入",
      "text": "宁采臣问过一次，那匣子里装的是什么。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 27,
      "act": "引入",
      "text": "燕赤霞没答。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 28,
      "act": "幕一 · 荒寺",
      "text": "宁采臣住下没几天，寺里又来了客人。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 29,
      "act": "幕一 · 荒寺",
      "text": "是兰溪来的一个书生，带着个仆人。也是来借宿的，住在北边屋，跟宁采臣隔着一个院子。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 30,
      "act": "幕一 · 荒寺",
      "text": "两下里点头打了个招呼，各回各屋。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 31,
      "act": "幕一 · 荒寺",
      "text": "那天夜里，宁采臣点着灯看书。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 32,
      "act": "幕一 · 荒寺",
      "text": "看到半夜，他忽然听见院子外头有动静。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 33,
      "act": "幕一 · 荒寺",
      "text": "不像风。风过草是一整片一整片地响，这个不是。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 34,
      "act": "幕一 · 荒寺",
      "text": "也不像人走路。人走路有落脚，一下一下的，这个也不是。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 35,
      "act": "幕一 · 荒寺",
      "text": "像是有什么东西，很轻，很慢，从草里蹚过去。蹚过去，又蹚回来。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 36,
      "act": "幕一 · 荒寺",
      "text": "宁采臣把灯挑亮，坐着听了一会儿。心里想的是野物——荒地里有野狗，夜里进院子刨食，不稀奇。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 37,
      "act": "幕一 · 荒寺",
      "text": "声音没了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 38,
      "act": "幕一 · 荒寺",
      "text": "第二天早上，北屋那个书生死了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 39,
      "act": "幕一 · 荒寺",
      "text": "尸首躺在床上，脸是平的，像睡着。身上翻遍了没有伤，衣裳整整齐齐，被子也没蹬乱。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 40,
      "act": "幕一 · 荒寺",
      "text": "请来的人看了半天，最后是在脚心上找着那个孔。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 41,
      "act": "幕一 · 荒寺",
      "text": "针眼那么大，一个小孔。孔边上有一点点血，已经干了。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 42,
      "act": "幕一 · 荒寺",
      "text": "人是被抽干的。整个身子里，血都没了。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 43,
      "act": "幕一 · 荒寺",
      "text": "寺外头来看热闹的人站了一会儿就散了。都说是暴病，说这荒寺不干净，早该拆了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 44,
      "act": "幕一 · 荒寺",
      "text": "有个上了岁数的说，这寺里死过人，不止一回。前些年也有过借宿的，早上叫不醒。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 45,
      "act": "幕一 · 荒寺",
      "text": "说完他往院子外头那片草地看了一眼，就走了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 46,
      "act": "幕一 · 荒寺",
      "text": "隔了一夜，那个仆人也死了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 47,
      "act": "幕一 · 荒寺",
      "text": "一模一样。脸是平的，身上没有伤，脚心上一个针眼大的孔。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 48,
      "act": "幕一 · 荒寺",
      "text": "宁采臣站在院子里，看着人把尸首抬出去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 49,
      "act": "幕一 · 荒寺",
      "text": "他心里不是不慌。第一个死的时候还能说是病，第二个死得一模一样，那就不是病。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 50,
      "act": "幕一 · 荒寺",
      "text": "要走是走得了的。可他出门带的钱不多，客店住不起，走了也没地方去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 51,
      "act": "幕一 · 荒寺",
      "text": "他就没走。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 52,
      "act": "幕一 · 荒寺",
      "text": "抬到院门口的时候，他抬起头，正对上东厢的门。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 53,
      "act": "幕一 · 荒寺",
      "text": "燕赤霞站在门口，也在看。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 54,
      "act": "幕一 · 荒寺",
      "text": "他看的不是尸首，是院子外头那片草。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 55,
      "act": "幕一 · 荒寺",
      "text": "看完了，他转过头，对宁采臣说了一句话。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 56,
      "act": "幕一 · 荒寺",
      "text": "天黑以后，不管听见什么，都别出屋。",
      "who": "老道",
      "beat": "落定"
    },
    {
      "no": 57,
      "act": "幕一 · 荒寺",
      "text": "为什么。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 58,
      "act": "幕一 · 荒寺",
      "text": "别问。",
      "who": "老道",
      "beat": "揭底"
    },
    {
      "no": 59,
      "act": "幕一 · 荒寺",
      "text": "说完他就把门关上了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 60,
      "act": "幕一 · 荒寺",
      "text": "宁采臣站在原地，什么也没想明白。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 61,
      "act": "幕一 · 荒寺",
      "text": "但那句话他记住了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 62,
      "act": "幕一 · 荒寺",
      "text": "那两个晚上，寺里死了两个人。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 63,
      "act": "幕二 · 夜叩",
      "text": "又过了三四天。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 64,
      "act": "幕二 · 夜叩",
      "text": "那天夜里下过一阵小雨，草是湿的，屋檐还在滴水。宁采臣在灯下看书，看到很晚。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 65,
      "act": "幕二 · 夜叩",
      "text": "门响了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 66,
      "act": "幕二 · 夜叩",
      "text": "不是敲门。是被推开的。门轴很涩，响了长长的一声。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 67,
      "act": "幕二 · 夜叩",
      "text": "一个姑娘站在门口。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 68,
      "act": "幕二 · 夜叩",
      "text": "十七八岁的样子，模样好看得不像话。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 69,
      "act": "幕二 · 夜叩",
      "text": "不是寻常人家姑娘那种好看。是那种你看一眼就知道，这不该出现在一座空寺里的好看。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 70,
      "act": "幕二 · 夜叩",
      "text": "宁采臣看了她一眼，又看了一眼她的鞋。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 71,
      "act": "幕二 · 夜叩",
      "text": "外头下了半宿的雨。她身上没沾一点。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 72,
      "act": "幕二 · 夜叩",
      "text": "宁采臣放下书，站了起来。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 73,
      "act": "幕二 · 夜叩",
      "text": "这么晚还点着灯，一个人待着，不闷吗？",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 74,
      "act": "幕二 · 夜叩",
      "text": "不闷。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 75,
      "act": "幕二 · 夜叩",
      "text": "这寺里前几天死了人，你不怕？",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 76,
      "act": "幕二 · 夜叩",
      "text": "不怕。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 77,
      "act": "幕二 · 夜叩",
      "text": "那两个人死得那么难看，你也不怕？",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 78,
      "act": "幕二 · 夜叩",
      "text": "他们死他们的。我读我的书。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 79,
      "act": "幕二 · 夜叩",
      "text": "姑娘笑了一下，往屋里走了两步，看样子是要在床沿上坐下。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 80,
      "act": "幕二 · 夜叩",
      "text": "宁采臣往旁边一挡，把她拦在了桌子外头。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 81,
      "act": "幕二 · 夜叩",
      "text": "更深夜静，一个姑娘家进男人的屋，不合适。你请回吧。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 82,
      "act": "幕二 · 夜叩",
      "text": "他这句话说得很平。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 83,
      "act": "幕二 · 夜叩",
      "text": "没有变脸，没有拔高嗓门，也没有讲一句大道理。就跟跟人说今天要下雨一样。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 84,
      "act": "幕二 · 夜叩",
      "text": "这是第一次拒绝。拒的是色。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 85,
      "act": "幕二 · 夜叩",
      "text": "她没有走。也没有恼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 86,
      "act": "幕二 · 夜叩",
      "text": "她站在那儿看了他一会儿，像是在算一件什么事。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 87,
      "act": "幕二 · 夜叩",
      "text": "过了好一会儿，她从袖子里摸出一样东西，轻轻放在桌上。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 88,
      "act": "幕二 · 夜叩",
      "text": "是一锭金子。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 89,
      "act": "幕二 · 夜叩",
      "text": "屋里就一盏油灯。那锭金子在灯底下，黄得很沉。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 90,
      "act": "幕二 · 夜叩",
      "text": "这个，给你。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 91,
      "act": "幕二 · 夜叩",
      "text": "你收下，我今夜就走，往后也不再来。",
      "who": "艳鬼",
      "beat": "常规"
    },
    {
      "no": 92,
      "act": "幕二 · 夜叩",
      "text": "宁采臣低头看了一眼。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 93,
      "act": "幕二 · 夜叩",
      "text": "他没有问这金子是哪儿来的，也没有问她为什么给他。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 94,
      "act": "幕二 · 夜叩",
      "text": "宁采臣拿起那锭金子，走到门口，扔了出去。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 95,
      "act": "幕二 · 夜叩",
      "text": "金子落在院子里的草窠里，闷闷地响了一下，就没声了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 96,
      "act": "幕二 · 夜叩",
      "text": "不是我该得的东西，放在我屋里，脏。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 97,
      "act": "幕二 · 夜叩",
      "text": "姑娘看着他，忽然问了一句。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 98,
      "act": "幕二 · 夜叩",
      "text": "你就不怕我是个鬼？",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 99,
      "act": "幕二 · 夜叩",
      "text": "是鬼是人，我都是这句话。",
      "who": "书生",
      "beat": "揭底"
    },
    {
      "no": 100,
      "act": "幕二 · 夜叩",
      "text": "这是第二次拒绝。拒的是利。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 101,
      "act": "幕二 · 夜叩",
      "text": "你注意这两次的分别。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 102,
      "act": "幕二 · 夜叩",
      "text": "头一次，拒的是送上门的人。第二次，拒的是送上门的钱。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 103,
      "act": "幕二 · 夜叩",
      "text": "前一件事，天底下做得到的人不算太少。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 104,
      "act": "幕二 · 夜叩",
      "text": "后一件事，做得到的人就少了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 105,
      "act": "幕二 · 夜叩",
      "text": "而这两件他做的时候，都没有慷慨激昂，也没有说自己是个什么样的人。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 106,
      "act": "幕二 · 夜叩",
      "text": "他就是没伸手。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 107,
      "act": "幕二 · 夜叩",
      "text": "这四个字听着简单。可你回头想想那锭金子——一个赶考的穷书生，客店都住不起，屋里凭空来了一锭金子，来路还没人知道。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 108,
      "act": "幕二 · 夜叩",
      "text": "多少人一辈子过不去的坎，就是这么一下。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 109,
      "act": "幕二 · 夜叩",
      "text": "姑娘站在门外，看着他。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 110,
      "act": "幕二 · 夜叩",
      "text": "灯芯爆了一下，屋里暗了暗，又亮起来。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 111,
      "act": "幕二 · 夜叩",
      "text": "小倩站在门外，很久没走。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 112,
      "act": "幕三 · 实情",
      "text": "第二天夜里，她又来了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 113,
      "act": "幕三 · 实情",
      "text": "这一回她没进门。在门槛外头，她就跪下了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 114,
      "act": "幕三 · 实情",
      "text": "我不是人。",
      "who": "艳鬼",
      "beat": "揭底"
    },
    {
      "no": 115,
      "act": "幕三 · 实情",
      "text": "宁采臣没有出声。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 116,
      "act": "幕三 · 实情",
      "text": "他把灯往桌子边上挪了挪，让光照到门口。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 117,
      "act": "幕三 · 实情",
      "text": "我姓聂，叫小倩，十八岁那年死的。就埋在这寺墙外头，埋了十几年了。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 118,
      "act": "幕三 · 实情",
      "text": "怎么死的我自己也说不清。病了一场，人就没了。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 119,
      "act": "幕三 · 实情",
      "text": "家里把我葬在这儿，就走了。往后再没来过一回。",
      "who": "艳鬼",
      "beat": "落定"
    },
    {
      "no": 120,
      "act": "幕三 · 实情",
      "text": "这十几年，没有一天是我自己的。",
      "who": "艳鬼",
      "beat": "落定"
    },
    {
      "no": 121,
      "act": "幕三 · 实情",
      "text": "有个东西管着我。它要我夜里去找住在这寺里的人。",
      "who": "艳鬼",
      "beat": "常规"
    },
    {
      "no": 122,
      "act": "幕三 · 实情",
      "text": "愿意跟我走的，我用这张脸。不愿意的，我用金子。",
      "who": "艳鬼",
      "beat": "常规"
    },
    {
      "no": 123,
      "act": "幕三 · 实情",
      "text": "那金子不是金子，是罗刹的骨头。谁收下过一夜，它就来取谁的心肝。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 124,
      "act": "幕三 · 实情",
      "text": "那两样我都用过。用哪一样，看那个人是什么样的人。",
      "who": "艳鬼",
      "beat": "落定"
    },
    {
      "no": 125,
      "act": "幕三 · 实情",
      "text": "她说这些话的时候，声音一直是平的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 126,
      "act": "幕三 · 实情",
      "text": "不是冷，是说过太多遍了。一件事在心里滚了十几年，说出来就是这个样子。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 127,
      "act": "幕三 · 实情",
      "text": "我不去，它就折磨我。",
      "who": "艳鬼",
      "beat": "常规"
    },
    {
      "no": 128,
      "act": "幕三 · 实情",
      "text": "我这十几年，像是在海里往下沉。怎么伸手，都够不着岸。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 129,
      "act": "幕三 · 实情",
      "text": "前几天北屋那两个，一个书生，一个仆人。",
      "who": "艳鬼",
      "beat": "常规"
    },
    {
      "no": 130,
      "act": "幕三 · 实情",
      "text": "都是我。",
      "who": "艳鬼",
      "beat": "揭底"
    },
    {
      "no": 131,
      "act": "幕三 · 实情",
      "text": "她说这句话的时候没有哭。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 132,
      "act": "幕三 · 实情",
      "text": "也没有替自己分辩一个字——没有说我是被逼的，没有说我也不想。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 133,
      "act": "幕三 · 实情",
      "text": "这两句话她本来是可以说的。而且都是真的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 134,
      "act": "幕三 · 实情",
      "text": "她一句没说。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 135,
      "act": "幕三 · 实情",
      "text": "请你记住这一点。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 136,
      "act": "幕三 · 实情",
      "text": "这个故事往后所有的好，全都建立在她这一句实话上面。她要是瞒了这一句，后面什么都不成立。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 137,
      "act": "幕三 · 实情",
      "text": "宁采臣还是没有说话。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 138,
      "act": "幕三 · 实情",
      "text": "我不是来求你饶我的。那两条命讨不回来，我知道。",
      "who": "艳鬼",
      "beat": "常规"
    },
    {
      "no": 139,
      "act": "幕三 · 实情",
      "text": "我只求你一件事。",
      "who": "艳鬼",
      "beat": "落定"
    },
    {
      "no": 140,
      "act": "幕三 · 实情",
      "text": "寺墙外头有一棵白杨树，树顶上有个乌鸦窝。我的骨头就在那棵树底下。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 141,
      "act": "幕三 · 实情",
      "text": "你走的时候，把它带走。随便找个有太阳的地方埋了，别再让我留在这儿。",
      "who": "艳鬼",
      "beat": "贴近"
    },
    {
      "no": 142,
      "act": "幕三 · 实情",
      "text": "说到这儿，她抬起头，看着他，说了一句话。",
      "who": "说书人",
      "beat": "引述"
    },
    {
      "no": 143,
      "act": "幕三 · 实情",
      "text": "这一句是全篇的题眼。原话是这么写的。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 144,
      "act": "幕三 · 实情",
      "text": "「妾阅人多矣，未有刚肠如君者。」",
      "who": "说书人",
      "beat": "引文"
    },
    {
      "no": 145,
      "act": "幕三 · 实情",
      "text": "意思是：我见过的人多了，没有一个人，像你这样，心是硬的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 146,
      "act": "幕三 · 实情",
      "text": "你听清楚她夸的是什么。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 147,
      "act": "幕三 · 实情",
      "text": "她夸的不是他心善。是他心硬——硬到送上门的东西一样都不要。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 148,
      "act": "幕三 · 实情",
      "text": "对她来说，一个不伸手的人，是这十几年里的头一个。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 149,
      "act": "幕三 · 实情",
      "text": "十几年里，她见过的都是伸手的人。这一夜她碰上一个不伸手的，第一反应不是欢喜，是把实话全说了。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 150,
      "act": "幕三 · 实情",
      "text": "她赌的就是这个。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 151,
      "act": "幕三 · 实情",
      "text": "宁采臣答应了。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 152,
      "act": "幕四 · 剑光",
      "text": "那天夜里，风停了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 153,
      "act": "幕四 · 剑光",
      "text": "寺里静得反常。草不响，虫也不叫。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 154,
      "act": "幕四 · 剑光",
      "text": "宁采臣坐在灯底下，觉得屋外头有什么东西，正贴着门缝往里看。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 155,
      "act": "幕四 · 剑光",
      "text": "东厢那道白光，就是这个时候出来的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 156,
      "act": "幕四 · 剑光",
      "text": "燕赤霞的匣子开了一道缝，里头射出一道光，白得像一匹绢，从门里直着出去，出去，又收了回来。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 157,
      "act": "幕四 · 剑光",
      "text": "院子里「咔」的一声，像是什么很硬的东西被折断了。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 158,
      "act": "幕四 · 剑光",
      "text": "然后就静了。",
      "who": "说书人",
      "beat": "悬"
    },
    {
      "no": 159,
      "act": "幕四 · 剑光",
      "text": "天亮，宁采臣出去看。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 160,
      "act": "幕四 · 剑光",
      "text": "院子当中的草被压倒了一大片。草叶上有一摊黑的东西，不像血，是干的，冒着一点腥气。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 161,
      "act": "幕四 · 剑光",
      "text": "燕赤霞蹲在旁边，把匣子重新扣好。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 162,
      "act": "幕四 · 剑光",
      "text": "他没有解释一个字。宁采臣也没有问。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 163,
      "act": "幕四 · 剑光",
      "text": "当天，宁采臣就去了寺墙外头。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 164,
      "act": "幕四 · 剑光",
      "text": "白杨树很好找。树顶上果然有一个空的乌鸦窝。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 165,
      "act": "幕四 · 剑光",
      "text": "他在树底下挖，挖到膝盖那么深，挖出一副骨头。",
      "who": "说书人",
      "beat": "提速"
    },
    {
      "no": 166,
      "act": "幕四 · 剑光",
      "text": "他把身上的外衣脱下来，把骨头一根一根包好。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 167,
      "act": "幕四 · 剑光",
      "text": "回浙江那天早上，燕赤霞也走。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 168,
      "act": "幕四 · 剑光",
      "text": "他把匣子背上，站在院子当中等宁采臣出来，从怀里掏出个旧皮囊递过去。边上磨得发白，看不出什么讲究。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 169,
      "act": "幕四 · 剑光",
      "text": "挂在床头。",
      "who": "老道",
      "beat": "落定"
    },
    {
      "no": 170,
      "act": "幕四 · 剑光",
      "text": "管什么用。",
      "who": "书生",
      "beat": "常规"
    },
    {
      "no": 171,
      "act": "幕四 · 剑光",
      "text": "管你活着回到家。",
      "who": "老道",
      "beat": "揭底"
    },
    {
      "no": 172,
      "act": "幕四 · 剑光",
      "text": "说完他就出了寺门，往北去了。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 173,
      "act": "幕四 · 剑光",
      "text": "这个人从头到尾没解释过一句。匣子里是什么，昨夜杀的是什么，他往哪儿去，一个字都没有。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 174,
      "act": "幕四 · 剑光",
      "text": "宁采臣抱着那包骨头，回了浙江。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 175,
      "act": "幕四 · 剑光",
      "text": "到家以后，他把这副骨头埋在自己书斋外头的空地上，添了土，立了个小坟。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 176,
      "act": "幕四 · 剑光",
      "text": "从那天起，小倩就跟着他了。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 177,
      "act": "幕四 · 剑光",
      "text": "宁采臣的母亲头一回见她，脸都白了。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 178,
      "act": "幕四 · 剑光",
      "text": "老太太是真怕。夜里把门插上，不让她靠近自己的屋子；白天见了她，绕着走。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 179,
      "act": "幕四 · 剑光",
      "text": "她心里想的是——这是个鬼，进了我家的门。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 180,
      "act": "幕四 · 剑光",
      "text": "小倩什么也没说。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 181,
      "act": "幕四 · 剑光",
      "text": "她每天天不亮就起来。把院子扫了，把水缸挑满，把灶上的火生上。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 182,
      "act": "幕四 · 剑光",
      "text": "宁母的饭她做，做好了端过去，自己站在一边。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 183,
      "act": "幕四 · 剑光",
      "text": "她不吃东西。一口都不吃。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 184,
      "act": "幕四 · 剑光",
      "text": "到了夜里，宁母不让她进屋睡，她就在廊底下坐着。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 185,
      "act": "幕四 · 剑光",
      "text": "坐一夜。",
      "who": "说书人",
      "beat": "顿"
    },
    {
      "no": 186,
      "act": "幕四 · 剑光",
      "text": "宁母有一回半夜起来，隔着窗户看见她坐在那儿，一动不动，坐到天亮。",
      "who": "说书人",
      "beat": "贴近"
    },
    {
      "no": 187,
      "act": "幕四 · 剑光",
      "text": "这样过了一个多月。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 188,
      "act": "幕四 · 剑光",
      "text": "有一天晚上，宁母把门开了，说了一句：外头凉，进来睡吧。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 189,
      "act": "幕四 · 剑光",
      "text": "小倩就在外间打了地铺。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 190,
      "act": "幕四 · 剑光",
      "text": "又过了些日子，吃饭的时候，宁母添了一副碗筷，摆在她面前。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 191,
      "act": "幕四 · 剑光",
      "text": "她还是不吃。但那副碗筷，从那天起天天摆着。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 192,
      "act": "幕四 · 剑光",
      "text": "后来宁母病了一场，躺了半个月。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 193,
      "act": "幕四 · 剑光",
      "text": "这半个月，是小倩守的。汤药、翻身、擦洗，一件不落。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 194,
      "act": "幕四 · 剑光",
      "text": "老太太病好那天，拉着她的手，叫了她一声闺女。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 195,
      "act": "幕四 · 剑光",
      "text": "你看这中间没有一件大事。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 196,
      "act": "幕四 · 剑光",
      "text": "没有救命，没有报恩，没有惊天动地。就是扫地、挑水、做饭、守夜，一天一天做下去。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 197,
      "act": "幕四 · 剑光",
      "text": "恐怖是这个故事的壳。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 198,
      "act": "幕四 · 剑光",
      "text": "这一段，才是它的芯。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 199,
      "act": "幕四 · 剑光",
      "text": "后来她成了他的妻子。",
      "who": "说书人",
      "beat": "收"
    },
    {
      "no": 200,
      "act": "收束",
      "text": "这个故事讲到这儿，有一件事，蒲松龄自始至终没有提。",
      "who": "说书人",
      "beat": "扣子"
    },
    {
      "no": 201,
      "act": "收束",
      "text": "没有人追究小倩杀过人。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 202,
      "act": "收束",
      "text": "他没有安排她赎罪，没有安排她立功，也没有安排她以死谢过。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 203,
      "act": "收束",
      "text": "他只是让一个人不占她的便宜，然后让她活了过来。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 204,
      "act": "收束",
      "text": "而宁采臣做的事，说穿了只有一件。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 205,
      "act": "收束",
      "text": "夜里有人送上门，他没要。有人送金子，他扔了出去。",
      "who": "说书人",
      "beat": "常规"
    },
    {
      "no": 206,
      "act": "收束",
      "text": "这两件事都不算英雄行为。只是没有伸手。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 207,
      "act": "收束",
      "text": "而这个故事里死掉的那些人，都是伸了手的。",
      "who": "说书人",
      "beat": "揭底"
    },
    {
      "no": 208,
      "act": "收束",
      "text": "志怪故事里的鬼，通常只有两个下场：害了人，被除掉；或者报了恩，就散了。这两条路的尽头都是消失。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 209,
      "act": "收束",
      "text": "小倩两条都没走。她留下来了，扫地、挑水、做饭，过成了一个人。",
      "who": "说书人",
      "beat": "落定"
    },
    {
      "no": 210,
      "act": "收束",
      "text": "蒲松龄写了五百个故事，肯给出这个结局的，没有几个。",
      "who": "说书人",
      "beat": "点评"
    },
    {
      "no": 211,
      "act": "收束",
      "text": "明天这一期短，也轻松。一个书生上山学仙，学了几个月，只学会一样本事，穿墙。",
      "who": "说书人",
      "beat": "收"
    }
  ],
  "annotated": true
}