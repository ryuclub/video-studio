      "stage": [
        "猫"
      ],
      "scene": "room",
      "say": [
        {
          "text": "他坐回自己的窗台上。",
          "delivery": "叙缓"
        },
        {
          "text": "那只鸟又飞回来了。",
          "delivery": "叙缓"
        }
