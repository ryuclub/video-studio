      "beat": "setup",
      "stage": [
        "小龟"
      ],
      "text": "他考虑了一年。",
      "delivery": "叙缓",
      "dur": 1.578,
      "audio": "out/voice/page-01-turtle/16-旁白.wav"
    },
    {
