[
  { "no": 1, "set": 1, "title": "八个小时", "scene": "office-desk", "weight": "中", "note": "出片时并了「我说是啊／心里想的是」两句（层数超了上限），中间留 0.45 秒气口" },
  { "no": 2, "set": 1, "title": "点头", "scene": "meeting-room", "weight": "中", "note": "签名屏第一次落地：折行成「不过这样 / 也挺好」，后面每条都照这个折法" },
